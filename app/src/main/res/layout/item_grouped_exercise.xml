<?xml version="1.0" encoding="utf-8"?>
<!--
  One exercise within a past session, listing the sets logged for it. The card itself is
  static; Edit reopens EditActivityActivity for this exercise's sets, Add Set reopens
  LogSetActivity to append one more — the same two actions available mid-workout, so
  amending a logged session uses the same vocabulary as logging it.
-->
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    style="@style/Widget.LP.Card.Dense"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="@dimen/lp_card_gap_dense"
    android:clickable="false"
    android:focusable="false">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="@dimen/lp_card_padding_dense">

        <!-- Title -->
        <TextView
            android:id="@+id/text_exercise_name"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textAppearance="@style/TextAppearance.LP.Heading"
            tools:text="Bench Press" />

        <!-- Type -->
        <TextView
            android:id="@+id/text_exercise_type"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:textAppearance="@style/TextAppearance.LP.Label"
            android:textColor="?attr/lpInkTertiary"
            tools:text="Intent: Build" />

        <!-- Action Buttons Row -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/lp_space_3"
            android:baselineAligned="false"
            android:orientation="horizontal">

            <!-- Edit Button -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/button_edit_activity"
                style="@style/Widget.LP.Button.Outlined"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginEnd="@dimen/lp_card_gap_dense"
                android:layout_weight="1"
                android:minHeight="40dp"
                android:text="@string/button_edit" />

            <!-- Change Type Button (retired: intent is now shown per-set/exercise, hidden at bind time) -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/button_change_type"
                style="@style/Widget.LP.Button.Outlined"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginEnd="@dimen/lp_card_gap_dense"
                android:layout_weight="1"
                android:minHeight="40dp"
                android:text="@string/button_change_type" />

            <!-- Add Set Button -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/button_add_set"
                style="@style/Widget.LP.Button"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:minHeight="40dp"
                android:text="@string/btn_add_set" />
        </LinearLayout>

        <!-- Sets Container -->
        <LinearLayout
            android:id="@+id/sets_container"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/lp_space_3"
            android:orientation="vertical" />
    </LinearLayout>
</com.google.android.material.card.MaterialCardView>
