<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:paddingStart="24dp"
    android:paddingEnd="24dp"
    android:paddingTop="20dp"
    android:paddingBottom="8dp">

    <TextView
        android:id="@+id/text_dialog_title"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="12dp"
        android:textAppearance="@style/TextAppearance.LP.Heading"
        tools:text="Bench Press (Barbell)" />

    <ImageView
        android:id="@+id/image_exercise_media"
        android:layout_width="match_parent"
        android:layout_height="200dp"
        android:layout_marginBottom="4dp"
        android:contentDescription="@null"
        android:scaleType="fitCenter"
        android:visibility="gone"
        tools:visibility="visible" />

    <TextView
        android:id="@+id/text_media_attribution"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="12dp"
        android:textAppearance="@style/TextAppearance.LP.Body"
        android:visibility="gone"
        tools:text="© Gym Visual — https://gymvisual.com/"
        tools:visibility="visible" />

    <TextView
        android:id="@+id/text_dialog_note"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:textAppearance="@style/TextAppearance.LP.Body"
        android:textColor="?attr/lpInk"
        android:visibility="gone"
        tools:text="Retract scapula. Slight arch. Bar to lower chest."
        tools:visibility="visible" />

</LinearLayout>
