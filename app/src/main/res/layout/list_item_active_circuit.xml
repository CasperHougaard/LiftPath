<?xml version="1.0" encoding="utf-8"?>
<!--
  A circuit in the active workout.

  One card stands for the whole block — the stations are listed as text, not as cards of their
  own, because the circuit is run on its own screen (CircuitRunnerActivity) and this card's only
  jobs are to say what's in it, how far through it you are, and to get you into the runner.

  Same dense card treatment and gutter as list_item_active_exercise and list_item_active_special,
  so all three read as one list. Runtime colours are set in
  ActiveExercisesAdapter.bindCircuitViewHolder; what's here is the idle state.
-->
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/card_circuit"
    style="@style/Widget.LP.Card.Dense"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginStart="@dimen/lp_gutter_dense"
    android:layout_marginEnd="@dimen/lp_gutter_dense"
    android:layout_marginTop="@dimen/lp_card_gap_dense"
    android:layout_marginBottom="@dimen/lp_card_gap_dense"
    android:clickable="false"
    android:focusable="false">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="@dimen/lp_card_padding_dense">

        <!-- Title row: icon + name/summary + rounds-done badge + delete -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginEnd="@dimen/lp_space_2"
                android:text="@string/circuit_icon"
                android:textAppearance="@style/TextAppearance.LP.Heading" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/text_circuit_name"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:ellipsize="end"
                    android:maxLines="1"
                    android:textAppearance="@style/TextAppearance.LP.Heading"
                    tools:text="Lower Lactate" />

                <!-- Tap to change the round suggestion and the rest between rounds. -->
                <TextView
                    android:id="@+id/text_circuit_summary"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:clickable="true"
                    android:focusable="true"
                    android:textAppearance="@style/TextAppearance.LP.Caption"
                    tools:text="~3 rounds · 90s rest" />
            </LinearLayout>

            <TextView
                android:id="@+id/text_rounds_badge"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginEnd="@dimen/lp_space_2"
                android:background="@drawable/lp_badge_wash"
                android:paddingHorizontal="@dimen/lp_space_2"
                android:paddingVertical="@dimen/lp_space_1"
                android:textAppearance="@style/TextAppearance.LP.Metric.S"
                android:textColor="?attr/lpAccent"
                android:visibility="gone"
                tools:text="2 rounds"
                tools:visibility="visible" />

            <ImageButton
                android:id="@+id/button_delete_circuit"
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="@string/cd_delete_circuit"
                android:src="@drawable/ic_delete"
                app:tint="?attr/lpInkTertiary" />
        </LinearLayout>

        <TextView
            android:id="@+id/text_circuit_stations"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/lp_space_2"
            android:textAppearance="@style/TextAppearance.LP.Body"
            android:textColor="?attr/lpInkSecondary"
            tools:text="Hip Thrust · Split Squat · Wall Sit · SL Glute Bridge · Side Leg Raise" />

        <!-- Rounds whose sets were deferred with "Later" and never filled in. -->
        <TextView
            android:id="@+id/text_circuit_pending"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/lp_space_2"
            android:textAppearance="@style/TextAppearance.LP.Caption"
            android:textColor="?attr/lpAccent"
            android:visibility="gone"
            tools:text="Round 2 not logged"
            tools:visibility="visible" />

        <View
            style="@style/Widget.LP.Divider"
            android:layout_marginTop="@dimen/lp_space_3"
            android:layout_marginBottom="@dimen/lp_space_3" />

        <com.google.android.material.card.MaterialCardView
            android:id="@+id/card_run_circuit"
            style="@style/Widget.LP.Card.Action"
            android:layout_width="match_parent"
            android:layout_height="44dp"
            app:cardBackgroundColor="?attr/lpAccent">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:gravity="center"
                android:orientation="horizontal">

                <ImageView
                    android:layout_width="15dp"
                    android:layout_height="15dp"
                    android:layout_marginEnd="@dimen/lp_space_2"
                    android:contentDescription="@null"
                    android:src="@drawable/ic_play"
                    app:tint="?attr/lpInkInverse" />

                <TextView
                    android:id="@+id/text_run_circuit"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/btn_start_circuit"
                    android:textAppearance="@style/TextAppearance.LP.Label"
                    android:textColor="?attr/lpInkInverse" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>
    </LinearLayout>
</com.google.android.material.card.MaterialCardView>
