<?xml version="1.0" encoding="utf-8"?>
<!--
  A circuit in the active workout, as a progressive-disclosure card — same header/body split as
  list_item_active_exercise.xml, so the two read as one list.

  HEADER (always visible): name, a glance line built from each station's most recent round (or
  its target, before anything is logged), the rounds-done badge, a completion check once the
  circuit is finished, and a chevron. Tapping the header toggles the body; the summary caption
  keeps its own tap target for round/rest settings.

  The Start/Continue action stays OUTSIDE the collapsible body — it is this card's one primary
  action, so it must stay reachable whether or not the card is expanded.

  BODY (layout_body): the per-station round-by-round trail (list_item_active_circuit_station.xml,
  one row per station) and any "round not logged" warning. Runtime colours and visibility are set
  in ActiveExercisesAdapter.bindCircuitViewHolder; what's here is the idle, un-started state.
-->
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/card_circuit"
    style="@style/Widget.LP.Card.Dense"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginStart="@dimen/lp_gutter_dense"
    android:layout_marginEnd="@dimen/lp_gutter_dense"
    android:layout_marginTop="@dimen/lp_card_gap_dense"
    android:layout_marginBottom="@dimen/lp_card_gap_dense"
    android:clickable="false"
    android:focusable="false">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <!-- ============ HEADER — always visible, tap to expand/collapse ============ -->
        <LinearLayout
            android:id="@+id/layout_header"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="?attr/selectableItemBackground"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center_vertical"
            android:minHeight="@dimen/lp_row_min_height"
            android:orientation="horizontal"
            android:paddingHorizontal="@dimen/lp_card_padding_dense"
            android:paddingVertical="@dimen/lp_space_2">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginEnd="@dimen/lp_space_2"
                android:text="@string/circuit_icon"
                android:textAppearance="@style/TextAppearance.LP.Heading" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/text_circuit_name"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:ellipsize="end"
                    android:maxLines="1"
                    android:textAppearance="@style/TextAppearance.LP.Heading"
                    tools:text="Lower Lactate" />

                <!-- Tap to change the round suggestion and the rest between rounds. -->
                <TextView
                    android:id="@+id/text_circuit_summary"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:clickable="true"
                    android:focusable="true"
                    android:textAppearance="@style/TextAppearance.LP.Caption"
                    tools:text="~3 rounds · 90s rest" />

                <!-- Collapsed-only glance: each station's most recent round, or its target. -->
                <TextView
                    android:id="@+id/text_circuit_stations"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/lp_space_half"
                    android:ellipsize="end"
                    android:maxLines="1"
                    android:textAppearance="@style/TextAppearance.LP.Body"
                    android:textColor="?attr/lpInkSecondary"
                    tools:text="Hip Thrust 65×10 · Split Squat 40+8×8 · Wall Sit 0:45" />
            </LinearLayout>

            <TextView
                android:id="@+id/text_rounds_badge"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/lp_space_2"
                android:background="@drawable/lp_badge_wash"
                android:paddingHorizontal="@dimen/lp_space_2"
                android:paddingVertical="@dimen/lp_space_1"
                android:textAppearance="@style/TextAppearance.LP.Metric.S"
                android:textColor="?attr/lpAccent"
                android:visibility="gone"
                tools:text="2 rounds"
                tools:visibility="visible" />

            <ImageView
                android:id="@+id/image_circuit_complete"
                android:layout_width="18dp"
                android:layout_height="18dp"
                android:layout_marginStart="@dimen/lp_space_2"
                android:contentDescription="@string/cd_circuit_complete"
                android:src="@drawable/ic_check"
                android:visibility="gone"
                app:tint="?attr/lpPositive" />

            <ImageButton
                android:id="@+id/button_delete_circuit"
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:layout_marginStart="@dimen/lp_space_1"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="@string/cd_delete_circuit"
                android:src="@drawable/ic_delete"
                app:tint="?attr/lpInkTertiary" />

            <ImageView
                android:id="@+id/image_expand_chevron"
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:layout_marginStart="@dimen/lp_space_1"
                android:contentDescription="@string/cd_expand_circuit"
                android:src="@drawable/ic_expand_more"
                app:tint="?attr/lpInkTertiary" />
        </LinearLayout>

        <!-- Primary action: stays visible whether or not the body is expanded. -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/card_run_circuit"
            style="@style/Widget.LP.Card.Action"
            android:layout_width="match_parent"
            android:layout_height="44dp"
            android:layout_marginHorizontal="@dimen/lp_card_padding_dense"
            android:layout_marginBottom="@dimen/lp_space_2"
            app:cardBackgroundColor="?attr/lpAccent">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:gravity="center"
                android:orientation="horizontal">

                <ImageView
                    android:layout_width="15dp"
                    android:layout_height="15dp"
                    android:layout_marginEnd="@dimen/lp_space_2"
                    android:contentDescription="@null"
                    android:src="@drawable/ic_play"
                    app:tint="?attr/lpInkInverse" />

                <TextView
                    android:id="@+id/text_run_circuit"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/btn_start_circuit"
                    android:textAppearance="@style/TextAppearance.LP.Label"
                    android:textColor="?attr/lpInkInverse" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- ============ BODY — the per-station round history, shown when expanded ============ -->
        <LinearLayout
            android:id="@+id/layout_body"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingHorizontal="@dimen/lp_card_padding_dense"
            android:paddingBottom="@dimen/lp_space_3">

            <View
                style="@style/Widget.LP.Divider"
                android:layout_marginBottom="@dimen/lp_space_3" />

            <!-- Rounds whose sets were deferred with "Later" and never filled in. -->
            <TextView
                android:id="@+id/text_circuit_pending"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="@dimen/lp_space_3"
                android:textAppearance="@style/TextAppearance.LP.Caption"
                android:textColor="?attr/lpAccent"
                android:visibility="gone"
                tools:text="Round 2 not logged"
                tools:visibility="visible" />

            <!-- One list_item_active_circuit_station.xml row per station, added at bind time. -->
            <LinearLayout
                android:id="@+id/layout_circuit_stations"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical" />
        </LinearLayout>
    </LinearLayout>
</com.google.android.material.card.MaterialCardView>
