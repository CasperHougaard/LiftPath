<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="?attr/lpCanvas"
    android:fitsSystemWindows="true"
    tools:context=".activities.SelectExerciseActivity">

    <!-- Background Flow Animation -->
    <com.liftpath.views.AmbientFlowView
        android:id="@+id/view_bg_ambient"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:clipChildren="false"
        android:clipToPadding="false"
        android:padding="@dimen/lp_gutter">

        <!-- HEADER WITH BACK BUTTON -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/button_back"
            style="@style/Widget.LP.Card.Control"
            android:layout_width="48dp"
            android:layout_height="48dp"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent">

            <ImageButton
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:background="?attr/selectableItemBackground"
                android:clickable="false"
                android:focusable="false"
                android:contentDescription="@string/progress_back_content_description"
                android:padding="@dimen/lp_space_3"
                android:src="@drawable/ic_arrow_back_24"
                app:tint="?attr/lpInk" />
        </com.google.android.material.card.MaterialCardView>

        <LinearLayout
            android:id="@+id/header_container"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/lp_space_4"
            android:orientation="vertical"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toEndOf="@id/button_back"
            app:layout_constraintTop_toTopOf="@id/button_back">

            <TextView
                android:id="@+id/text_select_exercise_title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/select_exercise_title"
                android:textAppearance="@style/TextAppearance.LP.Title" />
        </LinearLayout>

        <!-- MODE SWITCH: Exercise / Superset / Circuit — only shown when the caller (the active
             workout's regular add-exercise flow) opts in via EXTRA_ENABLE_GROUP_MODES. -->
        <com.google.android.material.chip.ChipGroup
            android:id="@+id/chip_group_pick_mode"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/lp_space_4"
            android:visibility="gone"
            app:chipSpacing="@dimen/lp_space_2"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/header_container"
            app:singleSelection="true">

            <com.google.android.material.chip.Chip
                android:id="@+id/chip_mode_exercise"
                style="@style/Widget.LP.Chip.Choice"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:checked="true"
                android:text="@string/tile_exercise" />

            <com.google.android.material.chip.Chip
                android:id="@+id/chip_mode_superset"
                style="@style/Widget.LP.Chip.Choice"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/tile_superset" />

            <com.google.android.material.chip.Chip
                android:id="@+id/chip_mode_circuit"
                style="@style/Widget.LP.Chip.Choice"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/tile_circuit" />
        </com.google.android.material.chip.ChipGroup>

        <!-- SEARCH FIELD -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/card_search"
            style="@style/Widget.LP.Card"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/lp_space_4"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/chip_group_pick_mode">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:padding="@dimen/lp_card_padding">

                <ImageView
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:layout_marginEnd="@dimen/lp_space_3"
                    android:contentDescription="@null"
                    android:src="@drawable/ic_search_24"
                    app:tint="?attr/lpInkSecondary" />

                <EditText
                    android:id="@+id/edit_text_search"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:background="@android:color/transparent"
                    android:hint="@string/hint_search_exercises"
                    android:imeOptions="actionSearch"
                    android:inputType="text"
                    android:maxLines="1"
                    android:textAppearance="@style/TextAppearance.LP.Input"
                    android:textColorHint="?attr/lpInkSecondary" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- SCROLLABLE CONTENT (Filter + Exercises) -->
        <androidx.core.widget.NestedScrollView
            android:id="@+id/nested_scroll_view"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:fillViewport="true"
            app:layout_constraintBottom_toTopOf="@id/button_create_new_exercise"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/card_search">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <!-- FILTER CARD -->
                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/card_filter"
                    style="@style/Widget.LP.Card"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/lp_card_gap">

                    <LinearLayout
                        android:id="@+id/layout_filter"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="@dimen/lp_card_padding">

                        <!-- Filter Chips -->
                        <com.google.android.material.chip.ChipGroup
                            android:id="@+id/chip_group_filters"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            app:chipSpacing="@dimen/lp_space_2"
                            app:singleSelection="false">

                            <com.google.android.material.chip.Chip
                                android:id="@+id/chip_filter_unadded"
                                style="@style/Widget.LP.Chip.Choice"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:checked="true"
                                android:text="@string/chip_filter_unadded" />

                            <com.google.android.material.chip.Chip
                                android:id="@+id/chip_filter_missing_primary"
                                style="@style/Widget.LP.Chip.Choice"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="@string/chip_filter_missing_primary" />

                            <com.google.android.material.chip.Chip
                                android:id="@+id/chip_filter_missing_secondary"
                                style="@style/Widget.LP.Chip.Choice"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="@string/chip_filter_missing_secondary" />

                            <com.google.android.material.chip.Chip
                                android:id="@+id/chip_group_by_family"
                                style="@style/Widget.LP.Chip.Choice"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="@string/chip_group_by_family" />
                        </com.google.android.material.chip.ChipGroup>

                        <!-- Advanced Filters Expandable Section -->
                        <LinearLayout
                            android:id="@+id/layout_advanced_filters_header"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:background="?attr/selectableItemBackground"
                            android:clickable="true"
                            android:focusable="true"
                            android:gravity="center_vertical"
                            android:orientation="horizontal"
                            android:paddingTop="@dimen/lp_space_3"
                            android:paddingBottom="@dimen/lp_space_2">

                            <TextView
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:text="@string/label_advanced_filters"
                                android:textAppearance="@style/TextAppearance.LP.Label" />

                            <ImageView
                                android:id="@+id/image_advanced_filters_expand"
                                android:layout_width="24dp"
                                android:layout_height="24dp"
                                android:contentDescription="@null"
                                android:rotation="0"
                                android:src="@drawable/ic_arrow_drop_down_24"
                                app:tint="?attr/lpInkSecondary" />
                        </LinearLayout>

                        <!-- Advanced Filters Content (Collapsed by default) -->
                        <LinearLayout
                            android:id="@+id/layout_advanced_filters_content"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="vertical"
                            android:paddingTop="@dimen/lp_space_2"
                            android:visibility="gone">

                            <!-- Movement Pattern Spinner -->
                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginBottom="@dimen/lp_space_2"
                                android:text="@string/label_movement_type"
                                android:textAppearance="@style/TextAppearance.LP.Label" />

                            <Spinner
                                android:id="@+id/spinner_movement_pattern"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_marginBottom="@dimen/lp_space_4" />

                            <!-- Body Region Spinner -->
                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginBottom="@dimen/lp_space_2"
                                android:text="@string/label_body_area"
                                android:textAppearance="@style/TextAppearance.LP.Label" />

                            <Spinner
                                android:id="@+id/spinner_body_region"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_marginBottom="@dimen/lp_space_4" />

                            <!-- Target Muscle ChipGroup -->
                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginBottom="@dimen/lp_space_2"
                                android:text="@string/muscle_groups_title"
                                android:textAppearance="@style/TextAppearance.LP.Label" />

                            <com.google.android.material.chip.ChipGroup
                                android:id="@+id/chip_group_muscle_groups"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                app:chipSpacing="@dimen/lp_space_2"
                                app:singleSelection="false" />
                        </LinearLayout>

                        <!-- Muscle Overview Expandable Section -->
                        <LinearLayout
                            android:id="@+id/layout_muscle_overview_header"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:background="?attr/selectableItemBackground"
                            android:clickable="true"
                            android:focusable="true"
                            android:gravity="center_vertical"
                            android:orientation="horizontal"
                            android:paddingTop="@dimen/lp_space_3"
                            android:paddingBottom="@dimen/lp_space_2">

                            <TextView
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:text="@string/label_muscle_overview"
                                android:textAppearance="@style/TextAppearance.LP.Label" />

                            <TextView
                                android:id="@+id/text_muscle_overview_badge"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginEnd="@dimen/lp_space_2"
                                android:text="@string/muscle_overview_badge_default"
                                android:textAppearance="@style/TextAppearance.LP.Metric.S"
                                tools:text="12/24" />

                            <ImageView
                                android:id="@+id/image_muscle_overview_expand"
                                android:layout_width="24dp"
                                android:layout_height="24dp"
                                android:contentDescription="@null"
                                android:rotation="0"
                                android:src="@drawable/ic_arrow_drop_down_24"
                                app:tint="?attr/lpInkSecondary" />
                        </LinearLayout>

                        <!-- Muscle Overview WebView (Collapsed by default) -->
                        <FrameLayout
                            android:id="@+id/layout_muscle_overview_content"
                            android:layout_width="match_parent"
                            android:layout_height="400dp"
                            android:background="?attr/lpCanvas"
                            android:visibility="gone">

                            <ImageView
                                android:id="@+id/image_muscle_overview"
                                android:layout_width="match_parent"
                                android:layout_height="match_parent"
                                android:contentDescription="@string/cd_muscle_map"
                                android:scaleType="fitCenter" />

                            <ProgressBar
                                android:id="@+id/progress_muscle_overview"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_gravity="center"
                                android:indeterminateTint="?attr/lpAccent"
                                android:visibility="visible" />

                            <TextView
                                android:id="@+id/text_muscle_overview_empty"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_gravity="center"
                                android:text="@string/select_exercise_muscle_overview_empty"
                                android:textAppearance="@style/TextAppearance.LP.Body"
                                android:visibility="gone" />
                        </FrameLayout>
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

                <!-- EXERCISES / CIRCUITS LIST CARD — the RecyclerView's adapter swaps between an
                     exercise-library adapter and a circuit-template adapter depending on the
                     active pick mode; the card and its empty state are shared. -->
                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/card_exercises_list"
                    style="@style/Widget.LP.Card"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/lp_space_3"
                    android:layout_marginBottom="@dimen/lp_space_3">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical">

                        <TextView
                            android:id="@+id/text_circuit_list_empty"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:padding="@dimen/lp_card_padding"
                            android:text="@string/circuits_empty_state"
                            android:textAppearance="@style/TextAppearance.LP.Body"
                            android:textColor="?attr/lpInkSecondary"
                            android:visibility="gone" />

                        <androidx.recyclerview.widget.RecyclerView
                            android:id="@+id/recycler_view_select_exercise"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:clipChildren="false"
                            android:clipToPadding="false"
                            android:nestedScrollingEnabled="false"
                            android:padding="@dimen/lp_space_3" />
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

            </LinearLayout>
        </androidx.core.widget.NestedScrollView>

        <!-- CREATE NEW EXERCISE BUTTON - FIXED AT BOTTOM -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/button_create_new_exercise"
            style="@style/Widget.LP.Button"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:minHeight="60dp"
            android:text="@string/button_create_new_exercise"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent" />

    </androidx.constraintlayout.widget.ConstraintLayout>
</androidx.constraintlayout.widget.ConstraintLayout>
