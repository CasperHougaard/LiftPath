<?xml version="1.0" encoding="utf-8"?>
<!--
  1RM estimation settings — how Progress > Exercises turns logged sets into an estimated
  1RM and projects it forward. ProgressSettingsManager holds these; ProgressExercisesFragment
  reads them on every chart build.

  Reached from Settings > Training. It had no entry point at all for a while, which is why
  this file was the last one in the app still written in raw dp and textSize: nobody saw it.
  Now on tokens like every other screen — Widget.LP.Card (hairline, never shadowed),
  Widget.LP.TextInputLayout.Numeric for the three figures, and the ink/outlined button pair.

  AIRY spacing: this is a screen you visit once to reason about estimation, not mid-set.
-->
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="?attr/lpCanvas"
    android:fitsSystemWindows="true"
    tools:context=".activities.ProgressSettingsActivity">

    <com.liftpath.views.AmbientFlowView
        android:id="@+id/view_bg_ambient"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@android:color/transparent"
        android:clipToPadding="false"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:clipChildren="false"
            android:clipToPadding="false"
            android:orientation="vertical"
            android:padding="@dimen/lp_gutter">

            <!-- HEADER -->
            <LinearLayout
                android:id="@+id/header_container"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/button_back"
                    style="@style/Widget.LP.Card.Control"
                    android:layout_width="48dp"
                    android:layout_height="48dp">

                    <ImageView
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:contentDescription="@string/progress_back_content_description"
                        android:padding="@dimen/lp_space_3"
                        android:src="@drawable/ic_arrow_back_24"
                        app:tint="?attr/lpInk" />
                </com.google.android.material.card.MaterialCardView>

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/lp_space_4"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/title_progress_settings"
                        android:textAppearance="@style/TextAppearance.LP.Title" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/lp_space_1"
                        android:text="@string/subtitle_progress_settings"
                        android:textAppearance="@style/TextAppearance.LP.Body" />
                </LinearLayout>
            </LinearLayout>

            <!-- ESTIMATION -->
            <com.google.android.material.card.MaterialCardView
                style="@style/Widget.LP.Card"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/lp_space_6"
                android:clickable="false"
                android:focusable="false">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="@dimen/lp_card_padding">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/progress_settings_section_estimation"
                        android:textAppearance="@style/TextAppearance.LP.Heading" />

                    <!-- Projection period -->
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/lp_space_5"
                        android:text="@string/progress_settings_period_label"
                        android:textAppearance="@style/TextAppearance.LP.Label" />

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/lp_space_1"
                        android:text="@string/progress_settings_period_description"
                        android:textAppearance="@style/TextAppearance.LP.Caption" />

                    <com.google.android.material.textfield.TextInputLayout
                        style="@style/Widget.LP.TextInputLayout.Numeric"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/lp_space_2">

                        <com.google.android.material.textfield.TextInputEditText
                            android:id="@+id/et_estimation_period_months"
                            style="@style/Widget.LP.TextInputEditText.Numeric"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:inputType="number"
                            tools:text="3" />
                    </com.google.android.material.textfield.TextInputLayout>

                    <!-- Minimum data points -->
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/lp_space_6"
                        android:text="@string/progress_settings_data_points_label"
                        android:textAppearance="@style/TextAppearance.LP.Label" />

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/lp_space_1"
                        android:text="@string/progress_settings_data_points_description"
                        android:textAppearance="@style/TextAppearance.LP.Caption" />

                    <com.google.android.material.textfield.TextInputLayout
                        style="@style/Widget.LP.TextInputLayout.Numeric"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/lp_space_2">

                        <com.google.android.material.textfield.TextInputEditText
                            android:id="@+id/et_minimum_data_points"
                            style="@style/Widget.LP.TextInputEditText.Numeric"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:inputType="number"
                            tools:text="4" />
                    </com.google.android.material.textfield.TextInputLayout>

                    <!-- Recent data window -->
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/lp_space_6"
                        android:text="@string/progress_settings_window_label"
                        android:textAppearance="@style/TextAppearance.LP.Label" />

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/lp_space_1"
                        android:text="@string/progress_settings_window_description"
                        android:textAppearance="@style/TextAppearance.LP.Caption" />

                    <com.google.android.material.textfield.TextInputLayout
                        style="@style/Widget.LP.TextInputLayout.Numeric"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/lp_space_2">

                        <com.google.android.material.textfield.TextInputEditText
                            android:id="@+id/et_recent_data_window_days"
                            style="@style/Widget.LP.TextInputEditText.Numeric"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:inputType="number"
                            tools:text="30" />
                    </com.google.android.material.textfield.TextInputLayout>

                    <!-- Data-quality warnings -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/lp_space_6"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:orientation="vertical">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="@string/progress_settings_warnings_label"
                                android:textAppearance="@style/TextAppearance.LP.Label" />

                            <TextView
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="@dimen/lp_space_1"
                                android:text="@string/progress_settings_warnings_description"
                                android:textAppearance="@style/TextAppearance.LP.Caption" />
                        </LinearLayout>

                        <com.google.android.material.materialswitch.MaterialSwitch
                            android:id="@+id/switch_show_warnings"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="@dimen/lp_space_4"
                            app:showText="false" />
                    </LinearLayout>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!--
              Save is the one action worth the darkest colour on the screen; reset is a
              secondary destination and stays outlined. Same pairing as every other
              authoring screen — never an accent fill, which is reserved for state.
            -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/button_save"
                style="@style/Widget.LP.Button"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/lp_space_6"
                android:text="@string/btn_save_settings" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/button_reset"
                style="@style/Widget.LP.Button.Outlined"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/lp_space_2"
                android:text="@string/btn_reset_defaults" />

        </LinearLayout>
    </androidx.core.widget.NestedScrollView>
</androidx.constraintlayout.widget.ConstraintLayout>
