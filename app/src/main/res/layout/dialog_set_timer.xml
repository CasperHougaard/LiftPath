<?xml version="1.0" encoding="utf-8"?>
<!--
  Custom rest duration, reached by tapping the countdown in the active-workout timer bar.

  Hosted inside a MaterialAlertDialog (DialogHelper), which already supplies the window
  background and radius — so this file is just the content and must NOT draw a card of its
  own, or the dialog reads as a card inside a card. That is what the previous version did.

  The two pickers are styled from Kotlin (ActiveTrainingActivity.styleNumberPicker); the
  platform NumberPicker exposes no attribute for its text colour or divider.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:paddingHorizontal="@dimen/lp_gutter"
    android:paddingTop="@dimen/lp_space_5"
    android:paddingBottom="@dimen/lp_space_3">

    <TextView
        android:id="@+id/text_dialog_title"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:text="@string/dialog_title_rest_duration"
        android:textAppearance="@style/TextAppearance.LP.Title" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/lp_space_3"
        android:gravity="center"
        android:orientation="horizontal">

        <NumberPicker
            android:id="@+id/number_picker_minutes"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="@dimen/lp_space_3"
            android:text=":"
            android:textAppearance="@style/TextAppearance.LP.Metric.L"
            android:textColor="?attr/lpInkTertiary" />

        <NumberPicker
            android:id="@+id/number_picker_seconds"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/lp_space_3"
        android:baselineAligned="false"
        android:orientation="horizontal">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/button_cancel"
            style="@style/Widget.LP.Button.Outlined"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginEnd="@dimen/lp_card_gap"
            android:layout_weight="1"
            android:text="@string/button_cancel" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/button_set"
            style="@style/Widget.LP.Button"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="@string/btn_set_duration"
            tools:text="Set" />
    </LinearLayout>

</LinearLayout>
