<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="?attr/lpCanvas"
    android:fitsSystemWindows="true"
    tools:context=".activities.EditExerciseActivity">

    <com.liftpath.views.AmbientFlowView
        android:id="@+id/view_bg_ambient"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <androidx.core.widget.NestedScrollView
        android:id="@+id/scroll_view_content"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:background="@android:color/transparent"
        android:clipToPadding="false"
        android:fillViewport="true"
        app:layout_constraintBottom_toTopOf="@id/button_container"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:clipChildren="false"
            android:clipToPadding="false"
            android:padding="@dimen/lp_gutter">

            <LinearLayout
                android:id="@+id/layout_header"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent">

                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/button_back"
                    style="@style/Widget.LP.Card.Control"
                    android:layout_width="48dp"
                    android:layout_height="48dp">

                    <ImageButton
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:background="?attr/selectableItemBackground"
                        android:clickable="false"
                        android:focusable="false"
                        android:contentDescription="@string/progress_back_content_description"
                        android:padding="@dimen/lp_space_3"
                        android:src="@drawable/ic_arrow_back_24"
                        app:tint="?attr/lpInk" />
                </com.google.android.material.card.MaterialCardView>

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/lp_space_4"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/text_edit_exercise_title"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:textAppearance="@style/TextAppearance.LP.Title"
                        tools:text="Edit Exercise" />

                    <TextView
                        android:id="@+id/text_subtitle"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/lp_space_1"
                        android:text="@string/edit_exercise_subtitle"
                        android:textAppearance="@style/TextAppearance.LP.Body" />
                </LinearLayout>
            </LinearLayout>

            <com.google.android.material.card.MaterialCardView
                android:id="@+id/card_exercise_details"
                style="@style/Widget.LP.Card"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/lp_space_5"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@id/layout_header">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="@dimen/lp_gutter">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/edit_exercise_section_information"
                        android:textAppearance="@style/TextAppearance.LP.Heading" />

                    <!-- Stick-figure illustration; falls back to a generic dumbbell for
                         exercises (e.g. custom ones) that have no drawing of their own. -->
                    <ImageView
                        android:id="@+id/image_exercise_illustration"
                        android:layout_width="match_parent"
                        android:layout_height="140dp"
                        android:layout_marginTop="@dimen/lp_space_3"
                        android:contentDescription="@null"
                        android:scaleType="fitCenter"
                        tools:src="@drawable/ic_dumbbell" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/lp_space_4"
                        android:text="@string/exercise_type_label"
                        android:textAppearance="@style/TextAppearance.LP.Label" />

                    <com.google.android.material.chip.ChipGroup
                        android:id="@+id/chip_group_exercise_type"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/lp_space_2"
                        app:chipSpacing="@dimen/lp_space_2"
                        app:selectionRequired="true"
                        app:singleSelection="true">

                        <com.google.android.material.chip.Chip
                            android:id="@+id/chip_type_weighted"
                            style="@style/Widget.LP.Chip.Choice"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/exercise_type_weighted" />

                        <com.google.android.material.chip.Chip
                            android:id="@+id/chip_type_bodyweight"
                            style="@style/Widget.LP.Chip.Choice"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/exercise_type_bodyweight" />
                    </com.google.android.material.chip.ChipGroup>

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/lp_space_4"
                        android:text="@string/target_metric_label"
                        android:textAppearance="@style/TextAppearance.LP.Label" />

                    <com.google.android.material.chip.ChipGroup
                        android:id="@+id/chip_group_target_metric"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/lp_space_2"
                        app:chipSpacing="@dimen/lp_space_2"
                        app:selectionRequired="true"
                        app:singleSelection="true">

                        <com.google.android.material.chip.Chip
                            android:id="@+id/chip_metric_reps"
                            style="@style/Widget.LP.Chip.Choice"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/target_metric_reps" />

                        <com.google.android.material.chip.Chip
                            android:id="@+id/chip_metric_time"
                            style="@style/Widget.LP.Chip.Choice"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/target_metric_time" />
                    </com.google.android.material.chip.ChipGroup>

                    <com.google.android.material.textfield.TextInputLayout
                        android:id="@+id/text_input_layout_exercise_name"
                        style="@style/Widget.LP.TextInputLayout"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/lp_space_4"
                        android:hint="@string/edit_exercise_hint_name">

                        <com.google.android.material.textfield.TextInputEditText
                            android:id="@+id/edit_text_exercise_name"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:inputType="textCapWords" />
                    </com.google.android.material.textfield.TextInputLayout>

                    <!-- No Widget.LP.TextInputLayout.ExposedDropdownMenu variant exists yet
                         (lp_styles.xml only covers the plain/numeric outlined box), so these
                         keep the Material ExposedDropdownMenu base for its dropdown affordance
                         and apply LP's radius + colour tokens directly, same as pre-migration. -->
                    <com.google.android.material.textfield.TextInputLayout
                        style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox.ExposedDropdownMenu"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/lp_space_3"
                        android:hint="@string/edit_exercise_hint_region"
                        app:boxCornerRadiusBottomEnd="@dimen/lp_radius_sm"
                        app:boxCornerRadiusBottomStart="@dimen/lp_radius_sm"
                        app:boxCornerRadiusTopEnd="@dimen/lp_radius_sm"
                        app:boxCornerRadiusTopStart="@dimen/lp_radius_sm"
                        app:boxStrokeColor="?attr/lpAccent"
                        app:hintTextColor="?attr/lpAccent">

                        <AutoCompleteTextView
                            android:id="@+id/dropdown_region"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:inputType="none"
                            android:textColor="?attr/lpInk" />
                    </com.google.android.material.textfield.TextInputLayout>

                    <com.google.android.material.textfield.TextInputLayout
                        style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox.ExposedDropdownMenu"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/lp_space_3"
                        android:hint="@string/edit_exercise_hint_pattern"
                        app:boxCornerRadiusBottomEnd="@dimen/lp_radius_sm"
                        app:boxCornerRadiusBottomStart="@dimen/lp_radius_sm"
                        app:boxCornerRadiusTopEnd="@dimen/lp_radius_sm"
                        app:boxCornerRadiusTopStart="@dimen/lp_radius_sm"
                        app:boxStrokeColor="?attr/lpAccent"
                        app:hintTextColor="?attr/lpAccent">

                        <AutoCompleteTextView
                            android:id="@+id/dropdown_pattern"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:inputType="none"
                            android:textColor="?attr/lpInk" />
                    </com.google.android.material.textfield.TextInputLayout>

                    <com.google.android.material.textfield.TextInputLayout
                        style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox.ExposedDropdownMenu"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/lp_space_3"
                        android:hint="@string/edit_exercise_hint_tier"
                        app:boxCornerRadiusBottomEnd="@dimen/lp_radius_sm"
                        app:boxCornerRadiusBottomStart="@dimen/lp_radius_sm"
                        app:boxCornerRadiusTopEnd="@dimen/lp_radius_sm"
                        app:boxCornerRadiusTopStart="@dimen/lp_radius_sm"
                        app:boxStrokeColor="?attr/lpAccent"
                        app:hintTextColor="?attr/lpAccent">

                        <AutoCompleteTextView
                            android:id="@+id/dropdown_tier"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:inputType="none"
                            android:textColor="?attr/lpInk" />
                    </com.google.android.material.textfield.TextInputLayout>

                    <com.google.android.material.textfield.TextInputLayout
                        style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox.ExposedDropdownMenu"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/lp_space_3"
                        android:hint="@string/edit_exercise_hint_mechanics"
                        app:boxCornerRadiusBottomEnd="@dimen/lp_radius_sm"
                        app:boxCornerRadiusBottomStart="@dimen/lp_radius_sm"
                        app:boxCornerRadiusTopEnd="@dimen/lp_radius_sm"
                        app:boxCornerRadiusTopStart="@dimen/lp_radius_sm"
                        app:boxStrokeColor="?attr/lpAccent"
                        app:hintTextColor="?attr/lpAccent">

                        <AutoCompleteTextView
                            android:id="@+id/dropdown_mechanics"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:inputType="none"
                            android:textColor="?attr/lpInk" />
                    </com.google.android.material.textfield.TextInputLayout>

                    <com.google.android.material.textfield.TextInputLayout
                        style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox.ExposedDropdownMenu"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/lp_space_3"
                        android:hint="@string/edit_exercise_hint_family"
                        app:boxCornerRadiusBottomEnd="@dimen/lp_radius_sm"
                        app:boxCornerRadiusBottomStart="@dimen/lp_radius_sm"
                        app:boxCornerRadiusTopEnd="@dimen/lp_radius_sm"
                        app:boxCornerRadiusTopStart="@dimen/lp_radius_sm"
                        app:boxStrokeColor="?attr/lpAccent"
                        app:hintTextColor="?attr/lpAccent">

                        <AutoCompleteTextView
                            android:id="@+id/dropdown_family"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:inputType="none"
                            android:textColor="?attr/lpInk" />
                    </com.google.android.material.textfield.TextInputLayout>

                    <!-- Equipment drives the weight ladder: what "go heavier" means on this
                         exercise, and what the +/- stepper moves by. -->
                    <com.google.android.material.textfield.TextInputLayout
                        style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox.ExposedDropdownMenu"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/lp_space_3"
                        android:hint="@string/edit_exercise_hint_equipment"
                        app:boxCornerRadiusBottomEnd="@dimen/lp_radius_sm"
                        app:boxCornerRadiusBottomStart="@dimen/lp_radius_sm"
                        app:boxCornerRadiusTopEnd="@dimen/lp_radius_sm"
                        app:boxCornerRadiusTopStart="@dimen/lp_radius_sm"
                        app:boxStrokeColor="?attr/lpAccent"
                        app:hintTextColor="?attr/lpAccent">

                        <AutoCompleteTextView
                            android:id="@+id/dropdown_equipment"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:inputType="none"
                            android:textColor="?attr/lpInk" />
                    </com.google.android.material.textfield.TextInputLayout>

                    <!-- Optional per-exercise override for the odd machine that does not move in
                         its equipment's usual steps. Blank means inherit. -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/lp_space_3"
                        android:orientation="horizontal"
                        android:baselineAligned="false">

                        <com.google.android.material.textfield.TextInputLayout
                            style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:layout_marginEnd="@dimen/lp_space_2"
                            android:hint="@string/edit_exercise_hint_step_override"
                            app:boxCornerRadiusBottomEnd="@dimen/lp_radius_sm"
                            app:boxCornerRadiusBottomStart="@dimen/lp_radius_sm"
                            app:boxCornerRadiusTopEnd="@dimen/lp_radius_sm"
                            app:boxCornerRadiusTopStart="@dimen/lp_radius_sm"
                            app:boxStrokeColor="?attr/lpAccent"
                            app:hintTextColor="?attr/lpAccent">

                            <com.google.android.material.textfield.TextInputEditText
                                android:id="@+id/edit_text_step_override"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:inputType="numberDecimal"
                                android:textColor="?attr/lpInk" />
                        </com.google.android.material.textfield.TextInputLayout>

                        <com.google.android.material.textfield.TextInputLayout
                            style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:hint="@string/edit_exercise_hint_min_override"
                            app:boxCornerRadiusBottomEnd="@dimen/lp_radius_sm"
                            app:boxCornerRadiusBottomStart="@dimen/lp_radius_sm"
                            app:boxCornerRadiusTopEnd="@dimen/lp_radius_sm"
                            app:boxCornerRadiusTopStart="@dimen/lp_radius_sm"
                            app:boxStrokeColor="?attr/lpAccent"
                            app:hintTextColor="?attr/lpAccent">

                            <com.google.android.material.textfield.TextInputEditText
                                android:id="@+id/edit_text_min_override"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:inputType="numberDecimal"
                                android:textColor="?attr/lpInk" />
                        </com.google.android.material.textfield.TextInputLayout>
                    </LinearLayout>

                    <TextView
                        android:id="@+id/text_increment_inherited"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/lp_space_1"
                        android:textAppearance="@style/TextAppearance.LP.Caption"
                        android:textColor="?attr/lpInkTertiary"
                        tools:text="Default for Barbell: 2.5 kg steps from 20 kg" />

                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <com.google.android.material.card.MaterialCardView
                android:id="@+id/card_target_muscles"
                style="@style/Widget.LP.Card"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/lp_card_gap"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@id/card_exercise_details">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="@dimen/lp_gutter">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/edit_exercise_section_target_muscles"
                        android:textAppearance="@style/TextAppearance.LP.Heading" />

                    <ImageView
                        android:id="@+id/image_muscle_map"
                        android:layout_width="match_parent"
                        android:layout_height="300dp"
                        android:layout_marginTop="@dimen/lp_space_4"
                        android:background="@android:color/transparent"
                        android:contentDescription="@string/cd_muscle_map"
                        android:scaleType="fitCenter" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/lp_space_4"
                        android:text="@string/edit_exercise_primary_targets"
                        android:textAppearance="@style/TextAppearance.LP.Label" />

                    <com.google.android.material.chip.ChipGroup
                        android:id="@+id/chip_group_primary_targets"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/lp_space_2"
                        app:chipSpacing="@dimen/lp_space_2"
                        app:singleSelection="false" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/lp_space_5"
                        android:text="@string/edit_exercise_secondary_targets"
                        android:textAppearance="@style/TextAppearance.LP.Label"
                        android:textColor="?attr/lpInkSecondary" />

                    <com.google.android.material.chip.ChipGroup
                        android:id="@+id/chip_group_secondary_targets"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/lp_space_2"
                        app:chipSpacing="@dimen/lp_space_2"
                        app:singleSelection="false" />

                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <com.google.android.material.card.MaterialCardView
                android:id="@+id/card_note"
                style="@style/Widget.LP.Card"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/lp_card_gap"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@id/card_target_muscles">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="@dimen/lp_gutter">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/edit_exercise_section_note"
                        android:textAppearance="@style/TextAppearance.LP.Heading" />

                    <com.google.android.material.textfield.TextInputLayout
                        android:id="@+id/text_input_layout_note"
                        style="@style/Widget.LP.TextInputLayout"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/lp_space_4"
                        android:hint="@string/edit_exercise_hint_notes">

                        <com.google.android.material.textfield.TextInputEditText
                            android:id="@+id/edit_text_note"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:gravity="top|start"
                            android:inputType="textMultiLine"
                            android:lines="4"
                            android:maxLines="10" />
                    </com.google.android.material.textfield.TextInputLayout>

                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <com.google.android.material.button.MaterialButton
                android:id="@+id/card_delete"
                style="@style/Widget.LP.Button.Destructive"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/lp_card_gap"
                android:minHeight="60dp"
                android:text="@string/dialog_title_delete_exercise"
                android:visibility="gone"
                app:icon="@drawable/ic_delete"
                app:iconGravity="textStart"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@id/card_note"
                tools:visibility="visible" />

        </androidx.constraintlayout.widget.ConstraintLayout>
    </androidx.core.widget.NestedScrollView>

    <LinearLayout
        android:id="@+id/button_container"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:baselineAligned="false"
        android:clipChildren="false"
        android:clipToPadding="false"
        android:orientation="horizontal"
        android:paddingStart="@dimen/lp_gutter"
        android:paddingTop="@dimen/lp_space_3"
        android:paddingEnd="@dimen/lp_gutter"
        android:paddingBottom="@dimen/lp_gutter"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/button_cancel"
            style="@style/Widget.LP.Button.Outlined"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginEnd="@dimen/lp_space_2"
            android:layout_weight="1"
            android:minHeight="60dp"
            android:text="@string/button_cancel" />

        <com.google.android.material.card.MaterialCardView
            android:id="@+id/button_favorite"
            style="@style/Widget.LP.Card.Interactive"
            android:layout_width="60dp"
            android:layout_height="60dp"
            android:layout_marginStart="@dimen/lp_space_2"
            android:layout_marginEnd="@dimen/lp_space_2"
            app:strokeColor="?attr/lpAccent">

            <ImageView
                android:id="@+id/image_favorite_star"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:contentDescription="@string/cd_favourite_exercise"
                android:padding="@dimen/lp_space_4"
                android:src="@drawable/ic_star_outline"
                app:tint="?attr/lpAccent" />
        </com.google.android.material.card.MaterialCardView>

        <com.google.android.material.button.MaterialButton
            android:id="@+id/button_save_exercise"
            style="@style/Widget.LP.Button"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:minHeight="60dp"
            android:text="@string/button_save_exercise" />
    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>
