<?xml version="1.0" encoding="utf-8"?>
<!--
  Library tab: the exercise catalogue — create, edit, favourites. Distinct from
  Progress > Exercises, which is analytics for the same objects.

  The search field is a plain hairline card rather than TextInputLayout: it has no label to
  float (the hint IS the only label it will ever show), so a floating-label field would just
  add an empty top inset for nothing.

  TRANSPARENT, not ?attr/lpCanvas — see fragment_plan for why: an opaque fill here paints out
  activity_main's AmbientFlowView. The canvas colour comes from the window background.
-->
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@android:color/transparent"
    tools:context="com.liftpath.fragments.LibraryFragment">

    <androidx.core.widget.NestedScrollView
        android:id="@+id/scroll_view_content"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:background="@android:color/transparent"
        android:clipToPadding="false"
        android:fillViewport="true"
        app:layout_constraintBottom_toTopOf="@id/button_container"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:clipChildren="false"
            android:clipToPadding="false"
            android:padding="@dimen/lp_gutter">

            <!-- HEADER -->
            <LinearLayout
                android:id="@+id/layout_header"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent">

                <!-- Given an id so the fragment can collapse the whole control: hiding only
                     the inner ImageButton would leave this card as an empty circle. -->
                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/card_back"
                    style="@style/Widget.LP.Card.Control"
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    android:clickable="false"
                    android:focusable="false">

                    <ImageButton
                        android:id="@+id/buttonBack"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:background="?attr/selectableItemBackground"
                        android:contentDescription="@string/progress_back_content_description"
                        android:padding="@dimen/lp_space_3"
                        android:src="@drawable/ic_arrow_back_24"
                        app:tint="?attr/lpInk" />
                </com.google.android.material.card.MaterialCardView>

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/lp_space_4"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/textExercisesTitle"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/title_manage_exercises"
                        android:textAppearance="@style/TextAppearance.LP.Display" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/lp_space_1"
                        android:text="@string/subtitle_manage_exercises"
                        android:textAppearance="@style/TextAppearance.LP.Body" />
                </LinearLayout>

                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/card_settings"
                    style="@style/Widget.LP.Card.Control"
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    android:layout_marginStart="@dimen/lp_space_2">

                    <ImageView
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:contentDescription="@string/settings"
                        android:padding="@dimen/lp_space_3"
                        android:src="@drawable/ic_settings"
                        app:tint="?attr/lpInkSecondary" />
                </com.google.android.material.card.MaterialCardView>
            </LinearLayout>

            <!-- MODE — the catalogue holds two kinds of object: single exercises and circuits. -->
            <com.google.android.material.chip.ChipGroup
                android:id="@+id/chip_group_library_mode"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/lp_space_5"
                app:chipSpacingHorizontal="@dimen/lp_card_gap_dense"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@id/layout_header"
                app:selectionRequired="true"
                app:singleLine="true"
                app:singleSelection="true">

                <com.google.android.material.chip.Chip
                    android:id="@+id/chip_mode_exercises"
                    style="@style/Widget.LP.Chip.Choice"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:checked="true"
                    android:text="@string/library_mode_exercises" />

                <com.google.android.material.chip.Chip
                    android:id="@+id/chip_mode_circuits"
                    style="@style/Widget.LP.Chip.Choice"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/library_mode_circuits" />
            </com.google.android.material.chip.ChipGroup>

            <!-- SEARCH -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/card_search"
                style="@style/Widget.LP.Card"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/lp_space_4"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@id/chip_group_library_mode">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:paddingHorizontal="@dimen/lp_card_padding"
                    android:paddingVertical="@dimen/lp_space_3">

                    <ImageView
                        android:layout_width="20dp"
                        android:layout_height="20dp"
                        android:layout_marginEnd="@dimen/lp_space_3"
                        android:contentDescription="@null"
                        android:src="@drawable/ic_search_24"
                        app:tint="?attr/lpInkTertiary" />

                    <EditText
                        android:id="@+id/edit_text_search"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:background="@android:color/transparent"
                        android:hint="@string/hint_search_exercises"
                        android:imeOptions="actionSearch"
                        android:inputType="text"
                        android:maxLines="1"
                        android:textAppearance="@style/TextAppearance.LP.Body"
                        android:textColor="?attr/lpInk"
                        android:textColorHint="?attr/lpInkTertiary" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- EXERCISES -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/card_exercises"
                style="@style/Widget.LP.Card"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/lp_card_gap"
                android:layout_marginBottom="@dimen/lp_gutter"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@id/card_search">

                <androidx.recyclerview.widget.RecyclerView
                    android:id="@+id/recyclerViewExercises"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:nestedScrollingEnabled="false"
                    android:paddingHorizontal="@dimen/lp_space_2" />
            </com.google.android.material.card.MaterialCardView>

            <!-- CIRCUITS — same slot as the exercise card; only one is visible at a time. -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/card_circuits"
                style="@style/Widget.LP.Card"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/lp_card_gap"
                android:layout_marginBottom="@dimen/lp_gutter"
                android:visibility="gone"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@id/card_search">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/text_circuits_empty"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:padding="@dimen/lp_card_padding"
                        android:text="@string/circuits_empty_state"
                        android:textAppearance="@style/TextAppearance.LP.Body"
                        android:textColor="?attr/lpInkSecondary"
                        android:visibility="gone" />

                    <androidx.recyclerview.widget.RecyclerView
                        android:id="@+id/recycler_view_circuits"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:nestedScrollingEnabled="false"
                        android:paddingHorizontal="@dimen/lp_space_2" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

        </androidx.constraintlayout.widget.ConstraintLayout>
    </androidx.core.widget.NestedScrollView>

    <!-- ACTIONS — PINNED -->
    <LinearLayout
        android:id="@+id/button_container"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:baselineAligned="false"
        android:orientation="horizontal"
        android:paddingStart="@dimen/lp_gutter"
        android:paddingTop="@dimen/lp_space_3"
        android:paddingEnd="@dimen/lp_gutter"
        android:paddingBottom="@dimen/lp_gutter"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/buttonAddFavourites"
            style="@style/Widget.LP.Button.Outlined"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginEnd="@dimen/lp_card_gap"
            android:layout_weight="1"
            android:text="@string/btn_add_favourites"
            app:icon="@drawable/ic_star"
            app:iconGravity="textStart" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/buttonAddExercise"
            style="@style/Widget.LP.Button"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="@string/btn_add_custom_exercise"
            app:icon="@drawable/ic_plus"
            app:iconGravity="textStart" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/button_add_circuit"
            style="@style/Widget.LP.Button"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="@string/btn_add_circuit"
            android:visibility="gone"
            app:icon="@drawable/ic_plus"
            app:iconGravity="textStart" />
    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>
