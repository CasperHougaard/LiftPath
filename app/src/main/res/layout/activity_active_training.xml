<?xml version="1.0" encoding="utf-8"?>
<!--
  The active workout. This is the screen the app exists for, and the only one used with a
  barbell waiting, so it takes the DENSE half of the density scale throughout: 12dp gutter,
  12dp card padding, 6dp between cards.

  Layout is a fixed header, a scrolling exercise list, and a rest-timer bar pinned to the
  bottom. The bar stays permanent rather than appearing on demand because during a session
  you reach for it constantly, and a control that moves is a control you have to look for.
-->
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="?attr/lpCanvas"
    tools:context=".activities.ActiveTrainingActivity">

    <com.liftpath.views.AmbientFlowView
        android:id="@+id/view_bg_ambient"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <androidx.appcompat.widget.Toolbar
        android:id="@+id/toolbar"
        android:layout_width="match_parent"
        android:layout_height="?attr/actionBarSize"
        android:background="@android:color/transparent"
        android:theme="@style/ThemeOverlay.AppCompat.ActionBar"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:title="@string/title_active_workout"
        app:titleTextAppearance="@style/TextAppearance.LP.Title"
        app:titleTextColor="?attr/lpInk" />

    <!-- DATE + SESSION CLOCK + SHORTCUTS -->
    <LinearLayout
        android:id="@+id/layout_date_header"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingHorizontal="@dimen/lp_space_1"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/toolbar">

        <LinearLayout
            android:id="@+id/layout_date"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:background="?attr/selectableItemBackground"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingHorizontal="@dimen/lp_space_2"
            android:paddingVertical="@dimen/lp_space_2">

            <ImageView
                android:layout_width="18dp"
                android:layout_height="18dp"
                android:contentDescription="@null"
                android:src="@drawable/ic_calendar_today_24"
                app:tint="?attr/lpInkTertiary" />

            <TextView
                android:id="@+id/text_date"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/lp_space_2"
                android:textAppearance="@style/TextAppearance.LP.Label"
                android:textColor="?attr/lpInkSecondary"
                tools:text="Mon, Nov 13" />

            <ImageView
                android:layout_width="14dp"
                android:layout_height="14dp"
                android:layout_marginStart="@dimen/lp_space_1"
                android:contentDescription="@null"
                android:src="@drawable/ic_arrow_drop_down_24"
                app:tint="?attr/lpInkTertiary" />
        </LinearLayout>

        <!-- Total session time. Mono: this ticks. -->
        <TextView
            android:id="@+id/text_workout_timer"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:paddingHorizontal="@dimen/lp_space_2"
            android:text="00:00:00"
            android:textAppearance="@style/TextAppearance.LP.Metric.S"
            android:textColor="?attr/lpInkSecondary"
            tools:text="00:42:18" />

        <ImageButton
            android:id="@+id/button_plan"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/cd_select_workout_plan"
            android:padding="@dimen/lp_space_3"
            android:src="@drawable/ic_plans"
            app:tint="?attr/lpAccent" />

        <ImageButton
            android:id="@+id/button_muscle_overview"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:layout_marginEnd="@dimen/lp_space_1"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/cd_view_muscle_overview"
            android:padding="@dimen/lp_space_3"
            android:src="@drawable/ic_fitness_center_24"
            app:tint="?attr/lpAccent" />
    </LinearLayout>

    <!-- EXERCISES -->
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/recycler_view_active_workout"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:clipToPadding="false"
        android:paddingTop="@dimen/lp_card_gap_dense"
        android:paddingBottom="@dimen/lp_space_3"
        app:layout_constraintBottom_toTopOf="@id/card_timer_container"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/layout_date_header" />

    <!-- REST TIMER — permanent -->
    <com.google.android.material.card.MaterialCardView
        android:id="@+id/card_timer_container"
        style="@style/Widget.LP.Card"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/lp_gutter_dense"
        android:layout_marginEnd="@dimen/lp_gutter_dense"
        android:layout_marginBottom="@dimen/lp_space_4"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingHorizontal="@dimen/lp_space_2"
            android:paddingVertical="@dimen/lp_space_2">

            <ImageButton
                android:id="@+id/button_timer_start_pause"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="@string/cd_start_pause_timer"
                android:padding="@dimen/lp_space_2"
                android:src="@drawable/ic_play"
                app:tint="?attr/lpAccent" />

            <LinearLayout
                android:id="@+id/button_timer_minus_15"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center_vertical"
                android:minHeight="40dp"
                android:orientation="horizontal"
                android:paddingHorizontal="@dimen/lp_space_1">

                <ImageView
                    android:layout_width="13dp"
                    android:layout_height="13dp"
                    android:contentDescription="@null"
                    android:src="@drawable/ic_minus"
                    app:tint="?attr/lpInkTertiary" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/lp_space_half"
                    android:text="15"
                    android:textAppearance="@style/TextAppearance.LP.Metric.S"
                    android:textColor="?attr/lpInkTertiary" />
            </LinearLayout>

            <!-- The number this bar exists for. Tap to set a custom duration. -->
            <TextView
                android:id="@+id/text_timer_display"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center"
                android:minHeight="44dp"
                android:text="00:00"
                android:textAppearance="@style/TextAppearance.LP.Metric.L" />

            <LinearLayout
                android:id="@+id/button_timer_plus_15"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center_vertical"
                android:minHeight="40dp"
                android:orientation="horizontal"
                android:paddingHorizontal="@dimen/lp_space_1">

                <ImageView
                    android:layout_width="13dp"
                    android:layout_height="13dp"
                    android:contentDescription="@null"
                    android:src="@drawable/ic_plus"
                    app:tint="?attr/lpInkTertiary" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/lp_space_half"
                    android:text="15"
                    android:textAppearance="@style/TextAppearance.LP.Metric.S"
                    android:textColor="?attr/lpInkTertiary" />
            </LinearLayout>

            <ImageButton
                android:id="@+id/button_timer_reset_stop"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="@string/cd_reset_timer"
                android:padding="@dimen/lp_space_2"
                android:src="@drawable/ic_refresh"
                app:tint="?attr/lpInkTertiary" />
        </LinearLayout>
    </com.google.android.material.card.MaterialCardView>

</androidx.constraintlayout.widget.ConstraintLayout>
