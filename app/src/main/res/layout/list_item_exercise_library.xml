<?xml version="1.0" encoding="utf-8"?>
<!--
  One row inside the Library tab's exercise list, which lives inside a single hairline
  card (card_exercises in fragment_library.xml). So this is a ROW, not a card of its own —
  the previous version nested a CardView per item inside that outer card, which is the same
  card-in-a-card seam that list_item_workout_plan had.

  The bottom hairline is this item's own divider rather than a RecyclerView
  ItemDecoration, so the adapter only has to hide it on the last row (see
  ExerciseLibraryAdapter) instead of the app carrying a second decoration mechanism for one
  list.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:minHeight="@dimen/lp_row_min_height"
        android:orientation="horizontal"
        android:paddingHorizontal="@dimen/lp_space_2"
        android:paddingVertical="@dimen/lp_space_2">

        <ImageView
            android:id="@+id/image_exercise_illustration"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:layout_marginEnd="@dimen/lp_space_3"
            android:importantForAccessibility="no"
            android:scaleType="fitCenter" />

        <ImageView
            android:id="@+id/image_favorite_star"
            android:layout_width="16dp"
            android:layout_height="16dp"
            android:layout_marginEnd="@dimen/lp_space_2"
            android:contentDescription="@string/cd_favourite_exercise"
            android:src="@drawable/ic_star"
            android:visibility="gone"
            app:tint="?attr/lpAccent" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginEnd="@dimen/lp_space_3"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/text_exercise_name"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textAppearance="@style/TextAppearance.LP.Label"
                tools:text="Bench Press" />

            <TextView
                android:id="@+id/text_exercise_meta"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textAppearance="@style/TextAppearance.LP.Caption"
                android:visibility="gone"
                tools:text="CHEST"
                tools:visibility="visible" />
        </LinearLayout>

        <com.google.android.material.card.MaterialCardView
            android:id="@+id/button_edit_exercise"
            style="@style/Widget.LP.Card.IconAction"
            app:strokeColor="?attr/lpHairlineStrong">

            <ImageView
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:contentDescription="@string/cd_edit_exercise"
                android:padding="@dimen/lp_icon_action_padding"
                android:src="@drawable/ic_edit_pencil"
                app:tint="?attr/lpInkSecondary" />
        </com.google.android.material.card.MaterialCardView>
    </LinearLayout>

    <View
        android:id="@+id/divider_exercise_row"
        style="@style/Widget.LP.Divider"
        android:layout_marginStart="@dimen/lp_space_2" />
</LinearLayout>
