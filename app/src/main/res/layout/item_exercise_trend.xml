<?xml version="1.0" encoding="utf-8"?>
<!--
  One exercise's trend card — shared by Progress > Exercises, Progress > Muscles'
  "contributing exercises" list, and WorkoutReportActivity's per-exercise breakdown
  (ExerciseTrendAdapter). All three show the same comparison (this session vs last, PRs,
  1RM), so this card is intentionally the single place that layout is defined.

  The card's stroke is the PR-recency signal (set in ExerciseTrendAdapter: positive within
  7 days, accent within 30, tertiary otherwise) — colour here in the XML is just the resting
  hairline state before that logic runs.
-->
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/card_exercise_trend"
    style="@style/Widget.LP.Card"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="@dimen/lp_card_gap">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="@dimen/lp_card_padding">

        <!-- Name + intent badge + PR star -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/text_exercise_name"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:ellipsize="end"
                android:maxLines="1"
                android:textAppearance="@style/TextAppearance.LP.Heading"
                tools:text="Bench Press" />

            <TextView
                android:id="@+id/text_intent_badge"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/lp_space_2"
                android:background="@drawable/bg_chip"
                android:backgroundTint="?attr/lpAccent"
                android:paddingHorizontal="@dimen/lp_space_2"
                android:paddingVertical="@dimen/lp_space_1"
                android:textAppearance="@style/TextAppearance.LP.Caption"
                android:textColor="?attr/lpInkInverse"
                tools:text="STRENGTH" />

            <ImageView
                android:id="@+id/image_pr_badge"
                android:layout_width="22dp"
                android:layout_height="22dp"
                android:layout_marginStart="@dimen/lp_space_2"
                android:contentDescription="@string/pr_badge"
                android:src="@drawable/ic_star"
                android:visibility="gone"
                app:tint="?attr/lpAccent"
                tools:visibility="visible" />
        </LinearLayout>

        <!-- Headline metric: volume, or hold time for timed exercises -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/lp_space_3"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/text_volume_label"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/volume_label"
                android:textAppearance="@style/TextAppearance.LP.Label"
                android:textColor="?attr/lpInkTertiary" />

            <View
                android:layout_width="0dp"
                android:layout_height="0dp"
                android:layout_weight="1" />

            <TextView
                android:id="@+id/text_volume_current"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textAppearance="@style/TextAppearance.LP.Metric.M"
                tools:text="1,250kg" />

            <TextView
                android:id="@+id/text_volume_comparison"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/lp_space_2"
                android:textAppearance="@style/TextAppearance.LP.Metric.S"
                android:visibility="gone"
                tools:text="vs 1,100kg"
                tools:visibility="visible" />

            <TextView
                android:id="@+id/text_volume_change"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/lp_space_2"
                android:textAppearance="@style/TextAppearance.LP.Metric.S"
                android:visibility="gone"
                tools:text="+14%"
                tools:textColor="?attr/lpPositive"
                tools:visibility="visible" />
        </LinearLayout>

        <!-- 1RM comparison (rep-based only) -->
        <LinearLayout
            android:id="@+id/layout_1rm"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/lp_space_2"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:visibility="gone"
            tools:visibility="visible">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/estimated_1rm_label"
                android:textAppearance="@style/TextAppearance.LP.Label"
                android:textColor="?attr/lpInkTertiary" />

            <View
                android:layout_width="0dp"
                android:layout_height="0dp"
                android:layout_weight="1" />

            <TextView
                android:id="@+id/text_1rm_current"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textAppearance="@style/TextAppearance.LP.Metric.M"
                tools:text="85kg" />

            <TextView
                android:id="@+id/text_1rm_comparison"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/lp_space_2"
                android:textAppearance="@style/TextAppearance.LP.Metric.S"
                android:visibility="gone"
                tools:text="vs 80kg"
                tools:visibility="visible" />

            <TextView
                android:id="@+id/text_1rm_change"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/lp_space_2"
                android:textAppearance="@style/TextAppearance.LP.Metric.S"
                android:visibility="gone"
                tools:text="+6%"
                tools:textColor="?attr/lpPositive"
                tools:visibility="visible" />
        </LinearLayout>

        <!-- Top set, or load×time for a weighted hold -->
        <LinearLayout
            android:id="@+id/layout_top_set"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/lp_space_2"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:visibility="gone"
            tools:visibility="visible">

            <TextView
                android:id="@+id/text_top_set_label"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/top_set_label"
                android:textAppearance="@style/TextAppearance.LP.Label"
                android:textColor="?attr/lpInkTertiary" />

            <View
                android:layout_width="0dp"
                android:layout_height="0dp"
                android:layout_weight="1" />

            <TextView
                android:id="@+id/text_top_set_current"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textAppearance="@style/TextAppearance.LP.Metric.M"
                tools:text="80kg × 8" />

            <TextView
                android:id="@+id/text_top_set_comparison"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/lp_space_2"
                android:textAppearance="@style/TextAppearance.LP.Metric.S"
                android:visibility="gone"
                tools:text="vs 75kg × 8"
                tools:visibility="visible" />
        </LinearLayout>

        <!-- All-time records -->
        <View
            android:id="@+id/divider_prs"
            style="@style/Widget.LP.Divider"
            android:layout_marginTop="@dimen/lp_space_3"
            android:layout_marginBottom="@dimen/lp_space_2"
            android:visibility="gone" />

        <TextView
            android:id="@+id/text_prs_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/all_time_records"
            android:textAppearance="@style/TextAppearance.LP.Caption"
            android:visibility="gone" />

        <LinearLayout
            android:id="@+id/layout_pr_grid"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/lp_space_2"
            android:orientation="horizontal"
            android:visibility="gone">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginEnd="@dimen/lp_space_2"
                android:layout_weight="1"
                android:orientation="vertical">

                <LinearLayout
                    android:id="@+id/layout_pr_weight"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:visibility="gone">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/weight_pr_label"
                        android:textAppearance="@style/TextAppearance.LP.Caption" />

                    <TextView
                        android:id="@+id/text_pr_weight"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:textAppearance="@style/TextAppearance.LP.Metric.M"
                        tools:text="100kg" />
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/layout_pr_volume"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/lp_space_2"
                    android:orientation="vertical"
                    android:visibility="gone">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/volume_pr_label"
                        android:textAppearance="@style/TextAppearance.LP.Caption" />

                    <TextView
                        android:id="@+id/text_pr_volume"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:textAppearance="@style/TextAppearance.LP.Metric.M"
                        tools:text="3,250kg" />
                </LinearLayout>
            </LinearLayout>

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/lp_space_2"
                android:layout_weight="1"
                android:orientation="vertical">

                <LinearLayout
                    android:id="@+id/layout_pr_1rm"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:visibility="gone">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/one_rm_pr_label"
                        android:textAppearance="@style/TextAppearance.LP.Caption" />

                    <TextView
                        android:id="@+id/text_pr_1rm"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:textAppearance="@style/TextAppearance.LP.Metric.M"
                        tools:text="125kg" />
                </LinearLayout>

                <!-- Longest hold PR (timed/isometric exercises). Reps PRs are not part of the
                     canonical PR system, so this slot carries the hold record instead. -->
                <LinearLayout
                    android:id="@+id/layout_pr_reps"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/lp_space_2"
                    android:orientation="vertical"
                    android:visibility="gone">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/longest_hold_label"
                        android:textAppearance="@style/TextAppearance.LP.Caption" />

                    <TextView
                        android:id="@+id/text_pr_reps"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:textAppearance="@style/TextAppearance.LP.Metric.M"
                        tools:text="1:30" />
                </LinearLayout>
            </LinearLayout>
        </LinearLayout>

        <TextView
            android:id="@+id/text_first_time_note"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/lp_space_2"
            android:text="@string/no_previous_data"
            android:textAppearance="@style/TextAppearance.LP.Label"
            android:textColor="?attr/lpAccent"
            android:visibility="gone"
            tools:visibility="gone" />
    </LinearLayout>
</com.google.android.material.card.MaterialCardView>
