<?xml version="1.0" encoding="utf-8"?>
<!--
  Log one set. The single most-used screen in the app after the workout list itself.

  DENSE spacing: this is operated between sets, so vertical space spent on air is space that
  pushes Save off the fold. The whole form lives in one card rather than four, separated by
  hairlines — four cards for weight / reps / RPE / note read as four unrelated decisions when
  they are one entry.

  Numeric fields all use Widget.LP.TextInputLayout.Numeric.Large (JetBrains Mono, Metric.L) so
  the value stays put as digits change under a stepper, and the −/+ pair uses Widget.LP.Stepper,
  where increment carries an accent wash and decrement does not — you should be able to hit the
  right one without reading the glyph.
-->
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="?attr/lpCanvas"
    android:fitsSystemWindows="true"
    tools:context=".activities.LogSetActivity">

    <com.liftpath.views.AmbientFlowView
        android:id="@+id/view_bg_ambient"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <androidx.core.widget.NestedScrollView
        android:id="@+id/scroll_view_content"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:background="@android:color/transparent"
        android:clipToPadding="false"
        android:fillViewport="true"
        app:layout_constraintBottom_toTopOf="@id/button_save_set"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="@dimen/lp_gutter_dense">

            <!-- ── HEADER ──────────────────────────────────── -->
            <LinearLayout
                android:id="@+id/layout_header"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <com.google.android.material.card.MaterialCardView
                    style="@style/Widget.LP.Card.Control"
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    android:clickable="false"
                    android:focusable="false">

                    <ImageButton
                        android:id="@+id/button_back"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:background="?attr/selectableItemBackground"
                        android:contentDescription="@string/progress_back_content_description"
                        android:padding="@dimen/lp_space_3"
                        android:src="@drawable/ic_arrow_back_24"
                        app:tint="?attr/lpInk" />
                </com.google.android.material.card.MaterialCardView>

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/lp_space_3"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <!-- Both this and the intent label below are tinted from Kotlin with the
                         matching lpIntent* token, which is the only colour on this screen. -->
                    <TextView
                        android:id="@+id/text_set_number_badge"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:textAppearance="@style/TextAppearance.LP.Caption"
                        tools:text="SET 3"
                        tools:textColor="?attr/lpIntentStrength" />

                    <TextView
                        android:id="@+id/text_log_set_title"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:ellipsize="end"
                        android:maxLines="1"
                        android:textAppearance="@style/TextAppearance.LP.Title"
                        tools:text="Bench Press" />

                    <TextView
                        android:id="@+id/text_intent_label"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:textAppearance="@style/TextAppearance.LP.Label"
                        tools:text="Strength"
                        tools:textColor="?attr/lpIntentStrength" />
                </LinearLayout>

                <ImageView
                    android:id="@+id/image_log_set_illustration"
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    android:layout_marginStart="@dimen/lp_space_3"
                    android:importantForAccessibility="no"
                    android:scaleType="fitCenter" />
            </LinearLayout>

            <!-- ── SUGGESTION BANNER ──────────────────────── -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/card_suggestion_hint"
                style="@style/Widget.LP.Card.Dense"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/lp_space_3"
                android:clickable="false"
                android:focusable="false"
                android:visibility="gone"
                app:cardBackgroundColor="?attr/lpSurfaceAlt"
                tools:visibility="visible">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal">

                    <!-- Intent-coloured stripe, set from Kotlin. -->
                    <View
                        android:id="@+id/view_suggestion_stripe"
                        android:layout_width="3dp"
                        android:layout_height="match_parent"
                        android:background="?attr/lpAccent" />

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:gravity="center_vertical"
                        android:orientation="horizontal"
                        android:padding="@dimen/lp_card_padding_dense">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="💡"
                            android:textAppearance="@style/TextAppearance.LP.Label" />

                        <TextView
                            android:id="@+id/text_suggestion_content"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="@dimen/lp_space_2"
                            android:layout_weight="1"
                            android:textAppearance="@style/TextAppearance.LP.Label"
                            tools:text="Maintain 57.5 kg · aim for 5 reps @ RPE 8.0" />
                    </LinearLayout>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- ── ONE CARD FOR THE WHOLE ENTRY ────────────── -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/card_inputs"
                style="@style/Widget.LP.Card"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/lp_space_3">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="@dimen/lp_card_padding">

                    <!-- ── Bodyweight block (bodyweight exercises only) ─ -->
                    <LinearLayout
                        android:id="@+id/bodyweight_container"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="@dimen/lp_space_3"
                        android:orientation="vertical"
                        android:visibility="gone">

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:gravity="center_vertical"
                            android:orientation="horizontal">

                            <TextView
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:text="@string/label_body_weight"
                                android:textAppearance="@style/TextAppearance.LP.Caption" />

                            <com.google.android.material.chip.Chip
                                android:id="@+id/chip_bodyweight"
                                style="@style/Widget.LP.Chip.Action"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="@string/bodyweight_chip_unknown" />
                        </LinearLayout>

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="@dimen/lp_space_3"
                            android:gravity="center_vertical"
                            android:orientation="horizontal">

                            <TextView
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:text="@string/label_extra_weight"
                                android:textAppearance="@style/TextAppearance.LP.Caption" />

                            <com.google.android.material.chip.ChipGroup
                                android:id="@+id/chip_group_extra_type"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                app:chipSpacing="@dimen/lp_card_gap_dense"
                                app:selectionRequired="true"
                                app:singleSelection="true">

                                <com.google.android.material.chip.Chip
                                    android:id="@+id/chip_added"
                                    style="@style/Widget.LP.Chip.Choice"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text="@string/bodyweight_added" />

                                <com.google.android.material.chip.Chip
                                    android:id="@+id/chip_assisted"
                                    style="@style/Widget.LP.Chip.Choice"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text="@string/bodyweight_assisted" />
                            </com.google.android.material.chip.ChipGroup>
                        </LinearLayout>

                        <!-- The number that actually goes on the bar. Ink fill: it is the
                             conclusion of the three controls above it. -->
                        <com.google.android.material.card.MaterialCardView
                            style="@style/Widget.LP.Card.Action"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="@dimen/lp_space_3"
                            android:clickable="false"
                            android:focusable="false">

                            <TextView
                                android:id="@+id/text_effective_load"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:gravity="center"
                                android:paddingHorizontal="@dimen/lp_space_4"
                                android:paddingVertical="@dimen/lp_space_3"
                                android:textAppearance="@style/TextAppearance.LP.Metric.M"
                                android:textColor="?attr/lpInkInverse"
                                tools:text="Effective load 82.5 kg" />
                        </com.google.android.material.card.MaterialCardView>
                    </LinearLayout>

                    <!-- ── WEIGHT ─────────────────────────────────── -->
                    <LinearLayout
                        android:id="@+id/layout_weight_stepper_row"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/label_weight"
                            android:textAppearance="@style/TextAppearance.LP.Caption" />

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="@dimen/lp_space_2"
                            android:baselineAligned="false"
                            android:gravity="center_vertical"
                            android:orientation="horizontal">

                            <com.google.android.material.card.MaterialCardView
                                android:id="@+id/btn_weight_minus"
                                style="@style/Widget.LP.Stepper">

                                <ImageView
                                    android:layout_width="match_parent"
                                    android:layout_height="match_parent"
                                    android:contentDescription="@string/cd_decrease_weight"
                                    android:padding="@dimen/lp_stepper_icon_padding"
                                    android:src="@drawable/ic_minus"
                                    app:tint="?attr/lpInk" />
                            </com.google.android.material.card.MaterialCardView>

                            <com.google.android.material.textfield.TextInputLayout
                                android:id="@+id/text_input_layout_kg"
                                style="@style/Widget.LP.TextInputLayout.Numeric.Large"
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_marginHorizontal="@dimen/lp_space_2"
                                android:layout_weight="1"
                                android:hint="@string/hint_kg">

                                <com.google.android.material.textfield.TextInputEditText
                                    android:id="@+id/edit_text_kg"
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    android:inputType="numberDecimal" />
                            </com.google.android.material.textfield.TextInputLayout>

                            <com.google.android.material.card.MaterialCardView
                                android:id="@+id/btn_weight_plus"
                                style="@style/Widget.LP.Stepper.Increment">

                                <ImageView
                                    android:layout_width="match_parent"
                                    android:layout_height="match_parent"
                                    android:contentDescription="@string/cd_increase_weight"
                                    android:padding="@dimen/lp_stepper_icon_padding"
                                    android:src="@drawable/ic_plus"
                                    app:tint="?attr/lpAccent" />
                            </com.google.android.material.card.MaterialCardView>
                        </LinearLayout>
                    </LinearLayout>

                    <!-- BW: extra weight field (bodyweight mode only) -->
                    <com.google.android.material.textfield.TextInputLayout
                        android:id="@+id/text_input_layout_extra"
                        style="@style/Widget.LP.TextInputLayout.Numeric.Large"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/lp_space_2"
                        android:hint="@string/hint_extra_kg"
                        android:visibility="gone">

                        <com.google.android.material.textfield.TextInputEditText
                            android:id="@+id/edit_text_extra"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:inputType="numberDecimal" />
                    </com.google.android.material.textfield.TextInputLayout>

                    <View
                        style="@style/Widget.LP.Divider"
                        android:layout_marginTop="@dimen/lp_space_4"
                        android:layout_marginBottom="@dimen/lp_space_4" />

                    <!-- ── REPS ───────────────────────────────────── -->
                    <LinearLayout
                        android:id="@+id/reps_container"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/label_reps"
                            android:textAppearance="@style/TextAppearance.LP.Caption" />

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="@dimen/lp_space_2"
                            android:baselineAligned="false"
                            android:gravity="center_vertical"
                            android:orientation="horizontal">

                            <com.google.android.material.card.MaterialCardView
                                android:id="@+id/btn_reps_minus"
                                style="@style/Widget.LP.Stepper">

                                <ImageView
                                    android:layout_width="match_parent"
                                    android:layout_height="match_parent"
                                    android:contentDescription="@string/cd_decrease_reps"
                                    android:padding="@dimen/lp_stepper_icon_padding"
                                    android:src="@drawable/ic_minus"
                                    app:tint="?attr/lpInk" />
                            </com.google.android.material.card.MaterialCardView>

                            <com.google.android.material.textfield.TextInputLayout
                                android:id="@+id/text_input_layout_reps"
                                style="@style/Widget.LP.TextInputLayout.Numeric.Large"
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_marginHorizontal="@dimen/lp_space_2"
                                android:layout_weight="1"
                                android:hint="@string/label_reps">

                                <com.google.android.material.textfield.TextInputEditText
                                    android:id="@+id/edit_text_reps"
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    android:inputType="number" />
                            </com.google.android.material.textfield.TextInputLayout>

                            <com.google.android.material.card.MaterialCardView
                                android:id="@+id/btn_reps_plus"
                                style="@style/Widget.LP.Stepper.Increment">

                                <ImageView
                                    android:layout_width="match_parent"
                                    android:layout_height="match_parent"
                                    android:contentDescription="@string/cd_increase_reps"
                                    android:padding="@dimen/lp_stepper_icon_padding"
                                    android:src="@drawable/ic_plus"
                                    app:tint="?attr/lpAccent" />
                            </com.google.android.material.card.MaterialCardView>
                        </LinearLayout>
                    </LinearLayout>

                    <!-- ── TIME / HOLD (timed exercises only) ─────── -->
                    <LinearLayout
                        android:id="@+id/time_container"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:visibility="gone">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/hold_time_label"
                            android:textAppearance="@style/TextAppearance.LP.Caption" />

                        <TextView
                            android:id="@+id/text_timer_display"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="@dimen/lp_space_2"
                            android:gravity="center"
                            android:text="0:00"
                            android:textAppearance="@style/TextAppearance.LP.Metric.XL"
                            android:textColor="?attr/lpAccent"
                            tools:text="0:45" />

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="@dimen/lp_space_2"
                            android:baselineAligned="false"
                            android:gravity="center_vertical"
                            android:orientation="horizontal">

                            <com.google.android.material.button.MaterialButton
                                android:id="@+id/button_timer_start_stop"
                                style="@style/Widget.LP.Button"
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:text="@string/timer_start" />

                            <com.google.android.material.button.MaterialButton
                                android:id="@+id/button_timer_reset"
                                style="@style/Widget.LP.Button.Outlined"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginStart="@dimen/lp_card_gap_dense"
                                android:text="@string/timer_reset" />
                        </LinearLayout>

                        <com.google.android.material.textfield.TextInputLayout
                            android:id="@+id/text_input_layout_duration"
                            style="@style/Widget.LP.TextInputLayout.Numeric"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="@dimen/lp_space_3"
                            android:hint="@string/hold_seconds_hint">

                            <com.google.android.material.textfield.TextInputEditText
                                android:id="@+id/edit_text_duration_seconds"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:inputType="number" />
                        </com.google.android.material.textfield.TextInputLayout>
                    </LinearLayout>

                    <View
                        style="@style/Widget.LP.Divider"
                        android:layout_marginTop="@dimen/lp_space_4"
                        android:layout_marginBottom="@dimen/lp_space_4" />

                    <!-- ── RPE ────────────────────────────────────── -->
                    <LinearLayout
                        android:id="@+id/rpe_header_container"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <TextView
                            android:id="@+id/text_rpe_label"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="@string/label_rpe_optional"
                            android:textAppearance="@style/TextAppearance.LP.Caption" />

                        <ImageButton
                            android:id="@+id/btnRpeHelp"
                            android:layout_width="32dp"
                            android:layout_height="32dp"
                            android:background="?attr/selectableItemBackgroundBorderless"
                            android:contentDescription="@string/cd_rpe_help"
                            android:padding="@dimen/lp_space_2"
                            android:src="@drawable/ic_help_outline"
                            app:tint="?attr/lpInkTertiary" />
                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/lp_space_2"
                        android:baselineAligned="false"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <com.google.android.material.card.MaterialCardView
                            android:id="@+id/btn_rpe_minus"
                            style="@style/Widget.LP.Stepper">

                            <ImageView
                                android:layout_width="match_parent"
                                android:layout_height="match_parent"
                                android:contentDescription="@string/cd_decrease_rpe"
                                android:padding="@dimen/lp_stepper_icon_padding"
                                android:src="@drawable/ic_minus"
                                app:tint="?attr/lpInk" />
                        </com.google.android.material.card.MaterialCardView>

                        <com.google.android.material.textfield.TextInputLayout
                            android:id="@+id/text_input_layout_rpe"
                            style="@style/Widget.LP.TextInputLayout.Numeric.Large"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginHorizontal="@dimen/lp_space_2"
                            android:layout_weight="1"
                            android:hint="@string/hint_rpe_range">

                            <com.google.android.material.textfield.TextInputEditText
                                android:id="@+id/edit_text_rpe"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:inputType="numberDecimal"
                                android:maxLength="4" />
                        </com.google.android.material.textfield.TextInputLayout>

                        <com.google.android.material.card.MaterialCardView
                            android:id="@+id/btn_rpe_plus"
                            style="@style/Widget.LP.Stepper.Increment">

                            <ImageView
                                android:layout_width="match_parent"
                                android:layout_height="match_parent"
                                android:contentDescription="@string/cd_increase_rpe"
                                android:padding="@dimen/lp_stepper_icon_padding"
                                android:src="@drawable/ic_plus"
                                app:tint="?attr/lpAccent" />
                        </com.google.android.material.card.MaterialCardView>
                    </LinearLayout>

                    <TextView
                        android:id="@+id/text_rpe_hint"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/lp_space_2"
                        android:text="@string/hint_rpe_explainer"
                        android:textAppearance="@style/TextAppearance.LP.Label"
                        android:textColor="?attr/lpInkTertiary" />

                    <View
                        style="@style/Widget.LP.Divider"
                        android:layout_marginTop="@dimen/lp_space_4"
                        android:layout_marginBottom="@dimen/lp_space_3" />

                    <!-- ── SET TYPE ───────────────────────────────── -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:minHeight="48dp"
                        android:orientation="horizontal">

                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="@string/label_set_type"
                            android:textAppearance="@style/TextAppearance.LP.Caption" />

                        <com.google.android.material.chip.ChipGroup
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            app:singleSelection="false">

                            <!-- Checked state is recoloured from Kotlin with lpIntentWarmup. -->
                            <com.google.android.material.chip.Chip
                                android:id="@+id/chip_warmup"
                                style="@style/Widget.LP.Chip.Choice"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="@string/label_warmup" />
                        </com.google.android.material.chip.ChipGroup>
                    </LinearLayout>

                    <!-- ── NOTE ───────────────────────────────────── -->
                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/button_toggle_note"
                        style="@style/Widget.LP.Button.Text"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="-8dp"
                        android:minHeight="40dp"
                        android:text="@string/btn_add_note"
                        app:icon="@drawable/ic_note"
                        app:iconSize="16dp" />

                    <com.google.android.material.textfield.TextInputLayout
                        android:id="@+id/text_input_layout_note"
                        style="@style/Widget.LP.TextInputLayout"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/lp_space_2"
                        android:hint="@string/hint_note_optional"
                        android:visibility="gone">

                        <com.google.android.material.textfield.TextInputEditText
                            android:id="@+id/edit_text_note"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:inputType="textCapSentences" />
                    </com.google.android.material.textfield.TextInputLayout>

                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

        </LinearLayout>
    </androidx.core.widget.NestedScrollView>

    <!-- ── SAVE — PINNED ──────────────────────────────── -->
    <com.google.android.material.button.MaterialButton
        android:id="@+id/button_save_set"
        style="@style/Widget.LP.Button"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
