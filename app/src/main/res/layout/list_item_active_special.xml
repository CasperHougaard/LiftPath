<?xml version="1.0" encoding="utf-8"?>
<!--
  A warm-up or cool-down slot in the active workout.

  Sits alongside list_item_active_exercise, so it uses the same dense card treatment and
  the same gutter — the two must read as members of one list, not two designs. It has no
  progressive disclosure because there is nothing to disclose: a duration, an optional
  note, and two actions.

  Every runtime colour here (both action fills, the card stroke) is set by
  ActiveExercisesAdapter.bindSpecialViewHolder; the values in this file are the idle state.
-->
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/card_special"
    style="@style/Widget.LP.Card.Dense"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginStart="@dimen/lp_gutter_dense"
    android:layout_marginEnd="@dimen/lp_gutter_dense"
    android:layout_marginTop="@dimen/lp_card_gap_dense"
    android:layout_marginBottom="@dimen/lp_card_gap_dense"
    android:clickable="false"
    android:focusable="false">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="@dimen/lp_card_padding_dense">

            <!-- Title row: icon + label/subtitle + duration badge + delete -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/text_special_icon"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginEnd="@dimen/lp_space_2"
                    android:text="🔥"
                    android:textAppearance="@style/TextAppearance.LP.Heading"
                    tools:text="🔥" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/text_special_label"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/label_warmup_element"
                        android:textAppearance="@style/TextAppearance.LP.Heading"
                        tools:text="Warm-up" />

                    <TextView
                        android:id="@+id/text_special_subtitle"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/warmup_element_subtitle"
                        android:textAppearance="@style/TextAppearance.LP.Caption"
                        tools:text="Prepare your body" />
                </LinearLayout>

                <!-- Duration badge — tap to change how long the slot runs. -->
                <TextView
                    android:id="@+id/text_duration_badge"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginEnd="@dimen/lp_space_2"
                    android:background="@drawable/lp_badge_wash"
                    android:clickable="true"
                    android:focusable="true"
                    android:paddingHorizontal="@dimen/lp_space_2"
                    android:paddingVertical="@dimen/lp_space_1"
                    android:textAppearance="@style/TextAppearance.LP.Metric.S"
                    android:textColor="?attr/lpAccent"
                    tools:text="5 min" />

                <ImageButton
                    android:id="@+id/button_delete_special"
                    android:layout_width="32dp"
                    android:layout_height="32dp"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:contentDescription="@string/cd_delete_exercise"
                    android:src="@drawable/ic_delete"
                    app:tint="?attr/lpInkTertiary" />
            </LinearLayout>

            <!-- Notes (shown if non-empty) -->
            <TextView
                android:id="@+id/text_special_notes"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/lp_space_2"
                android:textAppearance="@style/TextAppearance.LP.Body"
                android:visibility="gone"
                tools:text="5 min light cardio"
                tools:visibility="visible" />

            <View
                style="@style/Widget.LP.Divider"
                android:layout_marginTop="@dimen/lp_space_3"
                android:layout_marginBottom="@dimen/lp_space_3" />

            <!-- Action row -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:baselineAligned="false"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:weightSum="1.0">

                <!-- Start timer, or the live countdown once running (70%) -->
                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/card_start_timer"
                    style="@style/Widget.LP.Card.Action"
                    android:layout_width="0dp"
                    android:layout_height="44dp"
                    android:layout_marginEnd="@dimen/lp_card_gap_dense"
                    android:layout_weight="0.7"
                    app:cardBackgroundColor="?attr/lpAccent">

                    <FrameLayout
                        android:layout_width="match_parent"
                        android:layout_height="match_parent">

                        <LinearLayout
                            android:id="@+id/layout_timer_idle"
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:gravity="center"
                            android:orientation="horizontal">

                            <ImageView
                                android:layout_width="15dp"
                                android:layout_height="15dp"
                                android:layout_marginEnd="@dimen/lp_space_1"
                                android:contentDescription="@null"
                                android:src="@drawable/ic_play"
                                app:tint="?attr/lpInkInverse" />

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="@string/btn_start_timer"
                                android:textAppearance="@style/TextAppearance.LP.Label"
                                android:textColor="?attr/lpInkInverse" />
                        </LinearLayout>

                        <LinearLayout
                            android:id="@+id/layout_timer_running"
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:gravity="center"
                            android:orientation="horizontal"
                            android:visibility="gone">

                            <ImageView
                                android:layout_width="13dp"
                                android:layout_height="13dp"
                                android:layout_marginEnd="@dimen/lp_space_2"
                                android:contentDescription="@null"
                                android:src="@drawable/ic_pause"
                                app:tint="?attr/lpInkInverse" />

                            <!-- Mono so the card doesn't twitch every time a digit drops. -->
                            <TextView
                                android:id="@+id/text_timer_countdown"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="5:00"
                                android:textAppearance="@style/TextAppearance.LP.Metric.M"
                                android:textColor="?attr/lpInkInverse"
                                tools:text="4:52" />
                        </LinearLayout>
                    </FrameLayout>
                </com.google.android.material.card.MaterialCardView>

                <!-- Mark complete, or reset while running (30%) -->
                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/card_mark_complete"
                    style="@style/Widget.LP.Card.Action"
                    android:layout_width="0dp"
                    android:layout_height="44dp"
                    android:layout_weight="0.3"
                    app:cardBackgroundColor="?attr/lpAccent">

                    <TextView
                        android:id="@+id/text_mark_complete"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:gravity="center"
                        android:text="@string/btn_mark_complete"
                        android:textAppearance="@style/TextAppearance.LP.Label"
                        android:textColor="?attr/lpInkInverse" />
                </com.google.android.material.card.MaterialCardView>
            </LinearLayout>
        </LinearLayout>

        <!-- Timer progress, flush to the card's bottom edge while running -->
        <ProgressBar
            android:id="@+id/progress_timer"
            style="?android:attr/progressBarStyleHorizontal"
            android:layout_width="match_parent"
            android:layout_height="3dp"
            android:max="100"
            android:progress="100"
            android:progressBackgroundTint="?attr/lpHairline"
            android:progressBackgroundTintMode="src_in"
            android:progressTint="?attr/lpPositive"
            android:visibility="gone" />
    </LinearLayout>
</com.google.android.material.card.MaterialCardView>
