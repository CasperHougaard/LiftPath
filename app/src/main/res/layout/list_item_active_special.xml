<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/card_special"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginStart="4dp"
    android:layout_marginTop="4dp"
    android:layout_marginEnd="4dp"
    android:layout_marginBottom="12dp"
    app:cardBackgroundColor="@color/fitness_card_background"
    app:cardCornerRadius="16dp"
    app:cardElevation="2dp"
    app:strokeWidth="0dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp">

            <!-- Title row: icon + label + duration badge + delete -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical">

                <TextView
                    android:id="@+id/text_special_icon"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textSize="22sp"
                    android:layout_marginEnd="10dp"
                    android:text="🔥"
                    tools:text="🔥" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/text_special_label"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/label_warmup_element"
                        android:textColor="@color/fitness_text_primary"
                        android:textSize="18sp"
                        android:textStyle="bold"
                        tools:text="Warm-up" />

                    <TextView
                        android:id="@+id/text_special_subtitle"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:text="@string/warmup_element_subtitle"
                        android:textColor="@color/fitness_text_secondary"
                        android:textSize="12sp"
                        tools:text="Prepare your body" />
                </LinearLayout>

                <!-- Duration badge (clickable chip) -->
                <TextView
                    android:id="@+id/text_duration_badge"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginEnd="8dp"
                    android:background="@drawable/fitness_card_background"
                    android:clickable="true"
                    android:focusable="true"
                    android:paddingHorizontal="10dp"
                    android:paddingVertical="4dp"
                    android:textColor="@color/fitness_primary"
                    android:textSize="13sp"
                    android:textStyle="bold"
                    tools:text="5 min" />

                <!-- Delete button -->
                <ImageButton
                    android:id="@+id/button_delete_special"
                    android:layout_width="32dp"
                    android:layout_height="32dp"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:contentDescription="Delete"
                    android:src="@drawable/ic_delete"
                    app:tint="@color/fitness_accent" />
            </LinearLayout>

            <!-- Notes (shown if non-empty) -->
            <TextView
                android:id="@+id/text_special_notes"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:textColor="@color/fitness_text_secondary"
                android:textSize="13sp"
                android:visibility="gone"
                tools:text="5 min light cardio"
                tools:visibility="visible" />

            <!-- Divider -->
            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:layout_marginTop="12dp"
                android:layout_marginBottom="8dp"
                android:background="@color/fitness_text_secondary"
                android:alpha="0.2" />

            <!-- Action buttons row -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:weightSum="1.0">

                <!-- Start Timer / Countdown area (70%) -->
                <androidx.cardview.widget.CardView
                    android:id="@+id/card_start_timer"
                    android:layout_width="0dp"
                    android:layout_height="44dp"
                    android:layout_weight="0.7"
                    android:layout_marginEnd="6dp"
                    android:clickable="true"
                    android:focusable="true"
                    app:cardBackgroundColor="@color/fitness_primary"
                    app:cardCornerRadius="8dp"
                    app:cardElevation="0dp">

                    <FrameLayout
                        android:layout_width="match_parent"
                        android:layout_height="match_parent">

                        <!-- Idle state: play icon + "Start Timer" -->
                        <LinearLayout
                            android:id="@+id/layout_timer_idle"
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:gravity="center"
                            android:orientation="horizontal">

                            <ImageView
                                android:layout_width="16dp"
                                android:layout_height="16dp"
                                android:src="@drawable/ic_play"
                                android:layout_marginEnd="6dp"
                                app:tint="@color/white" />

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="@string/btn_start_timer"
                                android:textColor="@color/white"
                                android:textSize="13sp"
                                android:textStyle="bold" />
                        </LinearLayout>

                        <!-- Running state: countdown display -->
                        <LinearLayout
                            android:id="@+id/layout_timer_running"
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:gravity="center"
                            android:orientation="horizontal"
                            android:visibility="gone">

                            <ImageView
                                android:layout_width="14dp"
                                android:layout_height="14dp"
                                android:src="@drawable/ic_pause"
                                android:layout_marginEnd="8dp"
                                app:tint="@color/white" />

                            <TextView
                                android:id="@+id/text_timer_countdown"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="5:00"
                                android:textColor="@color/white"
                                android:textSize="18sp"
                                android:textStyle="bold"
                                tools:text="4:52" />
                        </LinearLayout>
                    </FrameLayout>
                </androidx.cardview.widget.CardView>

                <!-- Mark Complete / Reset button (30%) -->
                <androidx.cardview.widget.CardView
                    android:id="@+id/card_mark_complete"
                    android:layout_width="0dp"
                    android:layout_height="44dp"
                    android:layout_weight="0.3"
                    android:clickable="true"
                    android:focusable="true"
                    app:cardBackgroundColor="@color/fitness_primary"
                    app:cardCornerRadius="8dp"
                    app:cardElevation="0dp">

                    <TextView
                        android:id="@+id/text_mark_complete"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:gravity="center"
                        android:text="@string/btn_mark_complete"
                        android:textColor="@color/white"
                        android:textSize="13sp"
                        android:textStyle="bold" />
                </androidx.cardview.widget.CardView>
            </LinearLayout>
        </LinearLayout>

        <!-- Timer progress bar at card bottom (shown while running) -->
        <ProgressBar
            android:id="@+id/progress_timer"
            style="?android:attr/progressBarStyleHorizontal"
            android:layout_width="match_parent"
            android:layout_height="4dp"
            android:max="100"
            android:progress="100"
            android:progressTint="@color/superset_complete_green"
            android:progressBackgroundTint="@color/fitness_text_secondary"
            android:progressBackgroundTintMode="src_in"
            android:alpha="0.3"
            android:visibility="gone" />
    </LinearLayout>
</com.google.android.material.card.MaterialCardView>
