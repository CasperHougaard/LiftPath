<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:paddingEnd="@dimen/lp_space_5"
    android:clipChildren="false"
    android:clipToPadding="false">

    <com.google.android.material.button.MaterialButton
        android:id="@+id/action_finish_workout_button"
        android:layout_width="wrap_content"
        android:layout_height="40dp"
        android:contentDescription="@string/button_finish"
        android:minWidth="0dp"
        android:minHeight="0dp"
        android:paddingStart="18dp"
        android:paddingEnd="18dp"
        android:text="@string/button_finish"
        android:textAppearance="@style/TextAppearance.LP.Button"
        android:textColor="?attr/lpInkInverse"
        app:backgroundTint="?attr/lpAccent"
        app:rippleColor="?attr/lpRippleInverse"
        app:icon="@drawable/ic_check"
        app:iconGravity="textStart"
        app:iconPadding="8dp"
        app:iconSize="20dp"
        app:iconTint="?attr/lpInkInverse"
        app:cornerRadius="@dimen/lp_radius_sm" />
</FrameLayout>
