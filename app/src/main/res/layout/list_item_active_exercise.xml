<?xml version="1.0" encoding="utf-8"?>
<!--
  One exercise in the active workout, as a progressive-disclosure card.

  COLLAPSED is the resting state: a two-line header — name + intent badge on top, the
  working sets logged so far underneath — plus the "n of N" counter and a chevron. That
  is ~72dp, so seven or eight exercises fit on screen instead of the one and a half the
  always-expanded card managed.

  EXPANDED (layout_body) is granted to exactly ONE exercise at a time by
  ActiveExercisesAdapter, and holds everything you only need while actually working the
  lift: intent chips, the logged-vs-last-workout comparison, and the action row.

  Set lines use Metric.S (JetBrains Mono) deliberately — "Set 1: 95kg × 5" above
  "Set 2: 100kg × 5" only reads as a table if the digits are the same width.
-->
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/card_exercise"
    style="@style/Widget.LP.Card.Dense"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginStart="@dimen/lp_gutter_dense"
    android:layout_marginEnd="@dimen/lp_gutter_dense"
    android:layout_marginTop="@dimen/lp_card_gap_dense"
    android:layout_marginBottom="@dimen/lp_card_gap_dense">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <!-- Superset half-link at top (visible when the previous exercise is in the same group) -->
        <ImageButton
            android:id="@+id/button_superset_link_top"
            android:layout_width="32dp"
            android:layout_height="16dp"
            android:layout_gravity="center_horizontal"
            android:layout_marginTop="@dimen/lp_space_1"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/superset_link_remove"
            android:scaleType="centerCrop"
            android:src="@drawable/ic_superset_link_top"
            android:visibility="gone"
            app:tint="?attr/lpAccent" />

        <!-- ============ HEADER — always visible, tap to expand/collapse ============ -->
        <LinearLayout
            android:id="@+id/layout_header"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="?attr/selectableItemBackground"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center_vertical"
            android:minHeight="@dimen/lp_row_min_height"
            android:orientation="horizontal"
            android:paddingHorizontal="@dimen/lp_card_padding_dense"
            android:paddingVertical="@dimen/lp_space_2">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <TextView
                        android:id="@+id/text_exercise_name"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:ellipsize="end"
                        android:maxLines="1"
                        android:textAppearance="@style/TextAppearance.LP.Heading"
                        tools:text="Bench Press" />

                    <!-- Collapsed-only shorthand for the selected intent. -->
                    <TextView
                        android:id="@+id/text_intent_badge"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="@dimen/lp_space_2"
                        android:textAppearance="@style/TextAppearance.LP.Body"
                        android:visibility="gone"
                        tools:text="💥"
                        tools:visibility="visible" />

                    <!-- Expanded-only: swap a family slot for a different exercise. -->
                    <ImageButton
                        android:id="@+id/button_swap_exercise"
                        android:layout_width="24dp"
                        android:layout_height="24dp"
                        android:layout_marginStart="@dimen/lp_space_2"
                        android:background="?attr/selectableItemBackgroundBorderless"
                        android:contentDescription="@string/cd_change_exercise"
                        android:src="@drawable/ic_swap_horiz"
                        android:visibility="gone"
                        app:tint="?attr/lpAccent" />

                    <!-- Expanded-only: exercise illustration + note. -->
                    <ImageButton
                        android:id="@+id/button_note_tooltip"
                        android:layout_width="22dp"
                        android:layout_height="22dp"
                        android:layout_marginStart="@dimen/lp_space_2"
                        android:background="?attr/selectableItemBackgroundBorderless"
                        android:contentDescription="@string/cd_show_exercise_note"
                        android:src="@drawable/ic_info_outline_24"
                        android:visibility="gone"
                        app:tint="?attr/lpInkTertiary"
                        tools:visibility="visible" />
                </LinearLayout>

                <!-- Collapsed-only: this session's working sets on one line. -->
                <TextView
                    android:id="@+id/text_collapsed_summary"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/lp_space_half"
                    android:ellipsize="end"
                    android:maxLines="1"
                    android:textAppearance="@style/TextAppearance.LP.Metric.S"
                    android:visibility="gone"
                    tools:text="95×5 · 100×5 · 100×4"
                    tools:visibility="visible" />
            </LinearLayout>

            <ImageView
                android:id="@+id/image_completion_check"
                android:layout_width="18dp"
                android:layout_height="18dp"
                android:layout_marginStart="@dimen/lp_space_2"
                android:contentDescription="@string/cd_sets_complete"
                android:src="@drawable/ic_check"
                android:visibility="gone"
                app:tint="?attr/lpPositive" />

            <TextView
                android:id="@+id/text_sets_count"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/lp_space_2"
                android:textAppearance="@style/TextAppearance.LP.Metric.S"
                tools:text="2 / 3" />

            <ImageView
                android:id="@+id/image_expand_chevron"
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:layout_marginStart="@dimen/lp_space_1"
                android:contentDescription="@string/cd_expand_exercise"
                android:src="@drawable/ic_expand_more"
                app:tint="?attr/lpInkTertiary" />
        </LinearLayout>

        <!-- ============ BODY — only the one expanded exercise shows this ============ -->
        <LinearLayout
            android:id="@+id/layout_body"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingHorizontal="@dimen/lp_card_padding_dense"
            android:paddingBottom="@dimen/lp_card_padding_dense">

            <!-- Session goal. Emoji carry the meaning, so the chips need no icons. -->
            <com.google.android.material.chip.ChipGroup
                android:id="@+id/chip_group_intent"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:chipSpacingHorizontal="@dimen/lp_card_gap_dense"
                app:singleLine="true"
                app:singleSelection="true"
                app:selectionRequired="true">

                <com.google.android.material.chip.Chip
                    android:id="@+id/chip_strength"
                    style="@style/Widget.LP.Chip.Choice"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/intent_strength_chip" />

                <com.google.android.material.chip.Chip
                    android:id="@+id/chip_build"
                    style="@style/Widget.LP.Chip.Choice"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/intent_build_chip" />

                <com.google.android.material.chip.Chip
                    android:id="@+id/chip_flush"
                    style="@style/Widget.LP.Chip.Choice"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/intent_flush_chip" />
            </com.google.android.material.chip.ChipGroup>

            <!-- This session on the left, the same sets last time on the right. -->
            <LinearLayout
                android:id="@+id/layout_set_comparison"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/lp_space_3"
                android:background="?attr/selectableItemBackground"
                android:baselineAligned="false"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/text_logged_sets"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:lineSpacingMultiplier="1.25"
                    android:textAppearance="@style/TextAppearance.LP.Metric.S"
                    android:textColor="?attr/lpInk"
                    android:visibility="gone"
                    tools:text="Set 1: 95kg × 5\nSet 2: 100kg × 5"
                    tools:visibility="visible" />

                <TextView
                    android:id="@+id/text_last_workout_sets"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:gravity="end"
                    android:lineSpacingMultiplier="1.25"
                    android:textAppearance="@style/TextAppearance.LP.Metric.S"
                    android:textColor="?attr/lpInkTertiary"
                    android:visibility="gone"
                    tools:text="Last: 95kg × 5\nLast: 100kg × 5"
                    tools:visibility="visible" />
            </LinearLayout>

            <!-- One primary action, four icon actions. -->
            <LinearLayout
                android:id="@+id/layout_action_buttons"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/lp_space_3"
                android:baselineAligned="false"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/button_add_set"
                    style="@style/Widget.LP.Card.Action"
                    android:layout_width="0dp"
                    android:layout_height="@dimen/lp_icon_action_size"
                    android:layout_marginEnd="@dimen/lp_card_gap_dense"
                    android:layout_weight="1">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:gravity="center"
                        android:orientation="horizontal">

                        <ImageView
                            android:layout_width="15dp"
                            android:layout_height="15dp"
                            android:contentDescription="@null"
                            android:src="@drawable/ic_plus"
                            app:tint="?attr/lpInkInverse" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="@dimen/lp_space_1"
                            android:text="@string/btn_add_set"
                            android:textAppearance="@style/TextAppearance.LP.Label"
                            android:textColor="?attr/lpInkInverse" />
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/button_duplicate_set"
                    style="@style/Widget.LP.Card.IconAction"
                    android:layout_marginEnd="@dimen/lp_card_gap_dense">

                    <ImageView
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:contentDescription="@string/cd_duplicate_last_set"
                        android:padding="@dimen/lp_icon_action_padding"
                        android:src="@drawable/ic_content_copy"
                        app:tint="?attr/lpInkSecondary" />
                </com.google.android.material.card.MaterialCardView>

                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/button_edit_activity"
                    style="@style/Widget.LP.Card.IconAction"
                    android:layout_marginEnd="@dimen/lp_card_gap_dense">

                    <ImageView
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:contentDescription="@string/cd_edit_sets"
                        android:padding="@dimen/lp_icon_action_padding"
                        android:src="@drawable/ic_edit_pencil"
                        app:tint="?attr/lpInkSecondary" />
                </com.google.android.material.card.MaterialCardView>

                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/button_complete_exercise"
                    style="@style/Widget.LP.Card.IconAction"
                    android:layout_marginEnd="@dimen/lp_card_gap_dense"
                    app:strokeColor="?attr/lpPositive">

                    <ImageView
                        android:id="@+id/icon_complete_exercise"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:contentDescription="@string/cd_complete_exercise"
                        android:padding="@dimen/lp_icon_action_padding"
                        android:src="@drawable/ic_check"
                        app:tint="?attr/lpPositive" />
                </com.google.android.material.card.MaterialCardView>

                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/button_delete_exercise"
                    style="@style/Widget.LP.Card.IconAction"
                    app:strokeColor="?attr/lpNegative">

                    <ImageView
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:contentDescription="@string/cd_delete_exercise"
                        android:padding="@dimen/lp_icon_action_padding"
                        android:src="@drawable/ic_delete"
                        app:tint="?attr/lpNegative" />
                </com.google.android.material.card.MaterialCardView>
            </LinearLayout>
        </LinearLayout>

        <!-- Superset half-link at bottom (visible when the next exercise is in the same group) -->
        <ImageButton
            android:id="@+id/button_superset_link_bottom"
            android:layout_width="32dp"
            android:layout_height="16dp"
            android:layout_gravity="center_horizontal"
            android:layout_marginBottom="@dimen/lp_space_1"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/superset_link_remove"
            android:scaleType="centerCrop"
            android:src="@drawable/ic_superset_link_bottom"
            android:visibility="gone"
            app:tint="?attr/lpAccent" />
    </LinearLayout>
</com.google.android.material.card.MaterialCardView>
