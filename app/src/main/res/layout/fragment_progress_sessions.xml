<?xml version="1.0" encoding="utf-8"?>
<!--
  Progress > Sessions tab page. AIRY spacing — a browsing surface, not a working one.
  Compare-mode header/footer are not wired up by ProgressSessionsFragment yet (visibility
  stays GONE, nothing toggles it); kept in the tree rather than deleted since removing it
  would mean re-deriving the constraint chain for a feature that may still land, restyled
  to the token system like everything else on this page.
-->
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@android:color/transparent">

    <!-- Compare Mode Header -->
    <LinearLayout
        android:id="@+id/layout_compare_header"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingHorizontal="@dimen/lp_gutter"
        android:paddingTop="@dimen/lp_space_4"
        android:paddingBottom="@dimen/lp_space_2"
        android:visibility="gone"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="@string/progress_compare_mode"
            android:textAppearance="@style/TextAppearance.LP.Heading" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/button_cancel_compare"
            style="@style/Widget.LP.Button.Text"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/cancel" />
    </LinearLayout>

    <!-- Time Filter -->
    <LinearLayout
        android:id="@+id/layout_filter"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingHorizontal="@dimen/lp_gutter"
        android:paddingTop="@dimen/lp_space_4"
        android:paddingBottom="@dimen/lp_space_2"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/layout_compare_header">

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="@string/progress_sessions_title"
            android:textAppearance="@style/TextAppearance.LP.Heading" />

        <Spinner
            android:id="@+id/spinner_time_filter"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@drawable/spinner_background"
            android:padding="@dimen/lp_space_2"
            android:popupBackground="@drawable/spinner_popup_background" />
    </LinearLayout>

    <!-- Sessions List -->
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/recycler_sessions"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:clipToPadding="false"
        android:paddingHorizontal="@dimen/lp_gutter"
        android:paddingBottom="@dimen/lp_gutter"
        app:layout_constraintBottom_toTopOf="@id/layout_compare_mode"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/layout_filter"
        tools:itemCount="10"
        tools:listitem="@layout/item_session_card" />

    <TextView
        android:id="@+id/text_empty_state"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:padding="@dimen/lp_space_6"
        android:text="@string/progress_no_sessions"
        android:textAppearance="@style/TextAppearance.LP.Body"
        android:visibility="gone"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/layout_filter" />

    <!-- Compare Mode Footer -->
    <LinearLayout
        android:id="@+id/layout_compare_mode"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="?attr/lpSurface"
        android:gravity="center"
        android:orientation="horizontal"
        android:paddingHorizontal="@dimen/lp_gutter"
        android:paddingTop="@dimen/lp_space_4"
        android:paddingBottom="@dimen/lp_space_6"
        android:visibility="gone"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent">

        <com.google.android.material.card.MaterialCardView
            android:id="@+id/card_session_a"
            style="@style/Widget.LP.Card"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            app:cardBackgroundColor="?attr/lpAccent"
            app:cardCornerRadius="@dimen/lp_radius_sm"
            app:strokeWidth="0dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:orientation="vertical"
                android:padding="@dimen/lp_space_3">

                <TextView
                    android:id="@+id/text_session_a_date"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textAppearance="@style/TextAppearance.LP.Label"
                    android:textColor="?attr/lpInkInverse"
                    tools:text="Jan 15" />

                <TextView
                    android:id="@+id/text_session_a_volume"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textAppearance="@style/TextAppearance.LP.Metric.S"
                    android:textColor="?attr/lpInkInverseSecondary"
                    tools:text="1,250kg" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/lp_space_4"
            android:layout_marginEnd="@dimen/lp_space_4"
            android:text="@string/vs"
            android:textAppearance="@style/TextAppearance.LP.Heading"
            android:textColor="?attr/lpInkSecondary" />

        <com.google.android.material.card.MaterialCardView
            android:id="@+id/card_session_b"
            style="@style/Widget.LP.Card"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            app:cardBackgroundColor="?attr/lpAccent"
            app:cardCornerRadius="@dimen/lp_radius_sm"
            app:strokeWidth="0dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:orientation="vertical"
                android:padding="@dimen/lp_space_3">

                <TextView
                    android:id="@+id/text_session_b_date"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/progress_select_session"
                    android:textAppearance="@style/TextAppearance.LP.Label"
                    android:textColor="?attr/lpInkInverse" />

                <TextView
                    android:id="@+id/text_session_b_volume"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textAppearance="@style/TextAppearance.LP.Metric.S"
                    android:textColor="?attr/lpInkInverseSecondary"
                    android:visibility="gone"
                    tools:text="1,350kg" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>
    </LinearLayout>
</androidx.constraintlayout.widget.ConstraintLayout>
