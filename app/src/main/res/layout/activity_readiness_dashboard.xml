<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="?attr/lpCanvas"
    android:fitsSystemWindows="true"
    tools:context=".activities.ReadinessDashboardActivity">

    <com.liftpath.views.AmbientFlowView
        android:id="@+id/view_bg_ambient"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@android:color/transparent"
        android:clipToPadding="false"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:clipChildren="false"
            android:clipToPadding="false"
            android:orientation="vertical"
            android:padding="@dimen/lp_gutter">

            <!-- HEADER -->
            <LinearLayout
                android:id="@+id/header_container"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/button_back"
                    style="@style/Widget.LP.Card.Control"
                    android:layout_width="48dp"
                    android:layout_height="48dp">

                    <ImageButton
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:background="@android:color/transparent"
                        android:clickable="false"
                        android:contentDescription="@string/progress_back_content_description"
                        android:focusable="false"
                        android:padding="@dimen/lp_space_3"
                        android:src="@drawable/ic_arrow_back_24"
                        app:tint="?attr/lpInk" />
                </com.google.android.material.card.MaterialCardView>

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/lp_space_4"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/readiness_dashboard_title"
                        android:textAppearance="@style/TextAppearance.LP.Title" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/lp_space_1"
                        android:text="@string/readiness_dashboard_subtitle"
                        android:textAppearance="@style/TextAppearance.LP.Body" />
                </LinearLayout>

                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/button_settings"
                    style="@style/Widget.LP.Card.Control"
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    android:layout_marginStart="@dimen/lp_card_gap">

                    <ImageView
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:background="@android:color/transparent"
                        android:clickable="false"
                        android:contentDescription="@string/cd_calibration_settings"
                        android:focusable="false"
                        android:padding="@dimen/lp_space_3"
                        android:src="@drawable/ic_settings"
                        app:tint="?attr/lpInk" />
                </com.google.android.material.card.MaterialCardView>
            </LinearLayout>

            <!-- LAST WORKOUT SUMMARY CARD -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/card_last_workout"
                style="@style/Widget.LP.Card"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/lp_space_6"
                android:clickable="false"
                android:focusable="false">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="@dimen/lp_card_padding">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/readiness_last_workout_summary_title"
                        android:textAppearance="@style/TextAppearance.LP.Heading" />

                    <TextView
                        android:id="@+id/text_workout_date"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/lp_space_2"
                        android:text="@string/readiness_workout_date_placeholder"
                        android:textAppearance="@style/TextAppearance.LP.Body" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/lp_space_4"
                        android:orientation="horizontal">

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:orientation="vertical">

                            <TextView
                                style="@style/Widget.LP.Eyebrow"
                                android:text="@string/readiness_lower_fatigue_label" />

                            <TextView
                                android:id="@+id/text_lower_fatigue"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="@dimen/lp_space_1"
                                android:text="@string/placeholder_dash"
                                android:textAppearance="@style/TextAppearance.LP.Metric.M" />
                        </LinearLayout>

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:orientation="vertical">

                            <TextView
                                style="@style/Widget.LP.Eyebrow"
                                android:text="@string/readiness_upper_fatigue_label" />

                            <TextView
                                android:id="@+id/text_upper_fatigue"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="@dimen/lp_space_1"
                                android:text="@string/placeholder_dash"
                                android:textAppearance="@style/TextAppearance.LP.Metric.M" />
                        </LinearLayout>

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:orientation="vertical">

                            <TextView
                                style="@style/Widget.LP.Eyebrow"
                                android:text="@string/readiness_systemic_fatigue_label" />

                            <TextView
                                android:id="@+id/text_systemic_fatigue"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="@dimen/lp_space_1"
                                android:text="@string/placeholder_dash"
                                android:textAppearance="@style/TextAppearance.LP.Metric.M" />
                        </LinearLayout>
                    </LinearLayout>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- READINESS MATRIX GRID -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/lp_space_6"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="@string/readiness_activity_readiness_title"
                    android:textAppearance="@style/TextAppearance.LP.Heading" />

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginEnd="@dimen/lp_space_2"
                        android:text="@string/readiness_use_health_connect_label"
                        android:textAppearance="@style/TextAppearance.LP.Label"
                        android:textColor="?attr/lpInkSecondary" />

                    <com.google.android.material.materialswitch.MaterialSwitch
                        android:id="@+id/switch_use_health_connect"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        app:showText="false" />
                </LinearLayout>
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/lp_space_4"
                android:orientation="vertical">

                <!-- Row 1: Run/Cycle and Swim -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal">

                    <!-- Run / Cycle Card -->
                    <com.google.android.material.card.MaterialCardView
                        android:id="@+id/card_run_cycle"
                        style="@style/Widget.LP.Card"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginEnd="@dimen/lp_card_gap"
                        android:layout_weight="1"
                        android:clickable="false"
                        android:focusable="false">

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="vertical"
                            android:padding="@dimen/lp_card_padding">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="@string/readiness_run_cycle_title"
                                android:textAppearance="@style/TextAppearance.LP.Heading" />

                            <TextView
                                android:id="@+id/text_run_cycle_status"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="@dimen/lp_space_2"
                                android:text="@string/placeholder_dash"
                                android:textAppearance="@style/TextAppearance.LP.Heading" />

                            <TextView
                                android:id="@+id/text_run_cycle_message"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="@dimen/lp_space_1"
                                android:text="@string/placeholder_dash"
                                android:textAppearance="@style/TextAppearance.LP.Label" />

                            <TextView
                                android:id="@+id/text_run_cycle_countdown"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="@dimen/lp_space_2"
                                android:textAppearance="@style/TextAppearance.LP.Label"
                                android:visibility="gone" />
                        </LinearLayout>
                    </com.google.android.material.card.MaterialCardView>

                    <!-- Swim Card -->
                    <com.google.android.material.card.MaterialCardView
                        android:id="@+id/card_swim"
                        style="@style/Widget.LP.Card"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="@dimen/lp_card_gap"
                        android:layout_weight="1"
                        android:clickable="false"
                        android:focusable="false">

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="vertical"
                            android:padding="@dimen/lp_card_padding">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="@string/readiness_swim_title"
                                android:textAppearance="@style/TextAppearance.LP.Heading" />

                            <TextView
                                android:id="@+id/text_swim_status"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="@dimen/lp_space_2"
                                android:text="@string/placeholder_dash"
                                android:textAppearance="@style/TextAppearance.LP.Heading" />

                            <TextView
                                android:id="@+id/text_swim_message"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="@dimen/lp_space_1"
                                android:text="@string/placeholder_dash"
                                android:textAppearance="@style/TextAppearance.LP.Label" />

                            <TextView
                                android:id="@+id/text_swim_countdown"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="@dimen/lp_space_2"
                                android:textAppearance="@style/TextAppearance.LP.Label"
                                android:visibility="gone" />
                        </LinearLayout>
                    </com.google.android.material.card.MaterialCardView>
                </LinearLayout>

                <!-- Row 2: Lower Body Lift and Upper Body Lift -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/lp_space_3"
                    android:orientation="horizontal">

                    <!-- Lower Body Lift Card -->
                    <com.google.android.material.card.MaterialCardView
                        android:id="@+id/card_lower_lift"
                        style="@style/Widget.LP.Card"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginEnd="@dimen/lp_card_gap"
                        android:layout_weight="1"
                        android:clickable="false"
                        android:focusable="false">

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="vertical"
                            android:padding="@dimen/lp_card_padding">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="@string/readiness_lower_lift_title"
                                android:textAppearance="@style/TextAppearance.LP.Heading" />

                            <TextView
                                android:id="@+id/text_lower_lift_status"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="@dimen/lp_space_2"
                                android:text="@string/placeholder_dash"
                                android:textAppearance="@style/TextAppearance.LP.Heading" />

                            <TextView
                                android:id="@+id/text_lower_lift_message"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="@dimen/lp_space_1"
                                android:text="@string/placeholder_dash"
                                android:textAppearance="@style/TextAppearance.LP.Label" />

                            <TextView
                                android:id="@+id/text_lower_lift_countdown"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="@dimen/lp_space_2"
                                android:textAppearance="@style/TextAppearance.LP.Label"
                                android:visibility="gone" />
                        </LinearLayout>
                    </com.google.android.material.card.MaterialCardView>

                    <!-- Upper Body Lift Card -->
                    <com.google.android.material.card.MaterialCardView
                        android:id="@+id/card_upper_lift"
                        style="@style/Widget.LP.Card"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="@dimen/lp_card_gap"
                        android:layout_weight="1"
                        android:clickable="false"
                        android:focusable="false">

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="vertical"
                            android:padding="@dimen/lp_card_padding">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="@string/readiness_upper_lift_title"
                                android:textAppearance="@style/TextAppearance.LP.Heading" />

                            <TextView
                                android:id="@+id/text_upper_lift_status"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="@dimen/lp_space_2"
                                android:text="@string/placeholder_dash"
                                android:textAppearance="@style/TextAppearance.LP.Heading" />

                            <TextView
                                android:id="@+id/text_upper_lift_message"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="@dimen/lp_space_1"
                                android:text="@string/placeholder_dash"
                                android:textAppearance="@style/TextAppearance.LP.Label" />

                            <TextView
                                android:id="@+id/text_upper_lift_countdown"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="@dimen/lp_space_2"
                                android:textAppearance="@style/TextAppearance.LP.Label"
                                android:visibility="gone" />
                        </LinearLayout>
                    </com.google.android.material.card.MaterialCardView>
                </LinearLayout>
            </LinearLayout>

            <!-- 7-DAY CALENDAR VIEW -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/card_calendar"
                style="@style/Widget.LP.Card"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/lp_space_6"
                android:clickable="false"
                android:focusable="false">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="@dimen/lp_card_padding"
                    android:animateLayoutChanges="true">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/readiness_calendar_title"
                        android:textAppearance="@style/TextAppearance.LP.Heading" />

                    <LinearLayout
                        android:id="@+id/layout_calendar_days"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/lp_space_3"
                        android:background="?attr/selectableItemBackground"
                        android:clickable="true"
                        android:focusable="true"
                        android:orientation="horizontal"
                        android:gravity="center_vertical">
                    </LinearLayout>

                    <LinearLayout
                        android:id="@+id/layout_chart_expanded"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/lp_space_4"
                        android:orientation="vertical"
                        android:visibility="gone">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/readiness_current_fatigue_decay_label"
                            android:textAppearance="@style/TextAppearance.LP.Label"
                            android:textColor="?attr/lpInkSecondary" />

                        <!-- Fatigue Values List -->
                        <LinearLayout
                            android:id="@+id/layout_fatigue_list"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="@dimen/lp_space_2"
                            android:orientation="vertical" />

                        <com.github.mikephil.charting.charts.LineChart
                            android:id="@+id/chart_fatigue"
                            android:layout_width="match_parent"
                            android:layout_height="200dp"
                            android:minHeight="200dp"
                            android:layout_marginTop="@dimen/lp_space_2" />

                        <com.google.android.material.card.MaterialCardView
                            android:id="@+id/button_export_fatigue_data"
                            style="@style/Widget.LP.Card.Dense"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="@dimen/lp_space_4">

                            <LinearLayout
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:gravity="center"
                                android:orientation="horizontal"
                                android:padding="@dimen/lp_space_3">

                                <TextView
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text="@string/readiness_export_fatigue_data"
                                    android:textAppearance="@style/TextAppearance.LP.Heading" />
                            </LinearLayout>
                        </com.google.android.material.card.MaterialCardView>
                    </LinearLayout>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!--
                TriPath contribution. Gone unless the integration is connected — see
                TriPathConnection.isActive.
            -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/card_tripath"
                style="@style/Widget.LP.Card.Dense"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/lp_space_4"
                android:visibility="gone">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="@dimen/lp_space_3">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/tripath_card_title"
                        android:textAppearance="@style/TextAppearance.LP.Label"
                        android:textColor="?attr/lpInkSecondary" />

                    <TextView
                        android:id="@+id/text_tripath_form"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/lp_space_1"
                        android:text="@string/placeholder_dash"
                        android:textAppearance="@style/TextAppearance.LP.Heading" />

                    <TextView
                        android:id="@+id/text_tripath_recovery"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/lp_space_1"
                        android:text="@string/placeholder_dash"
                        android:textAppearance="@style/TextAppearance.LP.Body" />

                    <TextView
                        android:id="@+id/text_tripath_effect"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/lp_space_1"
                        android:text="@string/placeholder_dash"
                        android:textAppearance="@style/TextAppearance.LP.Label"
                        android:textColor="?attr/lpInkSecondary" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- Health Connect Sync Button -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/button_health_connect"
                style="@style/Widget.LP.Card.Dense"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/lp_space_4">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center"
                    android:orientation="horizontal"
                    android:padding="@dimen/lp_space_3">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/readiness_sync_health_connect"
                        android:textAppearance="@style/TextAppearance.LP.Heading" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- Empty State Message -->
            <TextView
                android:id="@+id/text_empty_state"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:layout_marginTop="@dimen/lp_space_10"
                android:text="@string/readiness_empty_state"
                android:textAppearance="@style/TextAppearance.LP.Body"
                android:visibility="gone" />

        </LinearLayout>
    </androidx.core.widget.NestedScrollView>
</androidx.constraintlayout.widget.ConstraintLayout>
