<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="?attr/lpSurface">

    <View
        android:layout_width="40dp"
        android:layout_height="4dp"
        android:layout_gravity="center_horizontal"
        android:layout_marginTop="@dimen/lp_space_3"
        android:layout_marginBottom="@dimen/lp_space_2"
        android:background="?attr/lpInkSecondary"
        android:alpha="0.4" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingStart="@dimen/lp_gutter"
        android:paddingEnd="@dimen/lp_gutter"
        android:paddingBottom="@dimen/lp_space_3"
        android:text="@string/title_change_exercise"
        android:textAppearance="@style/TextAppearance.LP.Title" />

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/recycler_change_exercise"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:maxHeight="480dp"
        android:nestedScrollingEnabled="true"
        android:paddingBottom="@dimen/lp_space_4" />

</LinearLayout>
