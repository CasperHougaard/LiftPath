<?xml version="1.0" encoding="utf-8"?>
<!--
  One exercise's "player stats card" on the PRs tab. The stroke colour and every stat
  value's text colour are set at bind time (ExercisePRStatsAdapter) using lpPositive /
  lpAccent / lpInkTertiary based on PR recency, so the defaults here just need to exist —
  Kotlin always overrides them before the card is visible.
-->
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/card_pr_tile"
    style="@style/Widget.LP.Card"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginTop="@dimen/lp_card_gap">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="@dimen/lp_card_padding">

        <!-- Header: Exercise name + Last PR date -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <TextView
                android:id="@+id/text_exercise_name"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:ellipsize="end"
                android:maxLines="1"
                android:textAppearance="@style/TextAppearance.LP.Heading"
                tools:text="Bench Press" />

            <TextView
                android:id="@+id/text_last_pr_date"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textAppearance="@style/TextAppearance.LP.Label"
                android:textColor="?attr/lpInkSecondary"
                tools:text="2 days ago" />
        </LinearLayout>

        <!-- Body: 1RM | Weight | Vol | Reps -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/lp_space_3"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical"
                android:gravity="center">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/progress_1rm"
                    android:textAppearance="@style/TextAppearance.LP.Caption" />
                <TextView
                    android:id="@+id/text_stat_1rm"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textAppearance="@style/TextAppearance.LP.Metric.M"
                    tools:text="120 kg" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical"
                android:gravity="center">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/progress_stat_max_weight"
                    android:textAppearance="@style/TextAppearance.LP.Caption" />
                <TextView
                    android:id="@+id/text_stat_weight"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textAppearance="@style/TextAppearance.LP.Metric.M"
                    tools:text="100 kg" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical"
                android:gravity="center">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/progress_volume"
                    android:textAppearance="@style/TextAppearance.LP.Caption" />
                <TextView
                    android:id="@+id/text_stat_volume"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textAppearance="@style/TextAppearance.LP.Metric.M"
                    tools:text="2,500 kg" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical"
                android:gravity="center">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/progress_best_hold"
                    android:textAppearance="@style/TextAppearance.LP.Caption" />
                <TextView
                    android:id="@+id/text_stat_hold"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textAppearance="@style/TextAppearance.LP.Metric.M"
                    tools:text="1:30" />
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>
</com.google.android.material.card.MaterialCardView>
