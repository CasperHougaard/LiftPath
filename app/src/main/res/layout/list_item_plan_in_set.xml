<?xml version="1.0" encoding="utf-8"?>
<!-- One plan's position within a rotation being edited (activity_edit_plan_set.xml). -->
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    style="@style/Widget.LP.Card.Dense"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="@dimen/lp_card_gap_dense"
    android:clickable="false"
    android:focusable="false">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:minHeight="@dimen/lp_row_min_height"
        android:orientation="horizontal"
        android:paddingHorizontal="@dimen/lp_card_padding_dense"
        android:paddingVertical="@dimen/lp_space_2">

        <TextView
            android:id="@+id/text_position"
            android:layout_width="26dp"
            android:layout_height="26dp"
            android:background="@drawable/lp_badge_ink"
            android:gravity="center"
            android:textAppearance="@style/TextAppearance.LP.Metric.S"
            android:textColor="?attr/lpInkInverse" />

        <TextView
            android:id="@+id/text_plan_name"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/lp_space_3"
            android:layout_weight="1"
            android:ellipsize="end"
            android:maxLines="1"
            android:textAppearance="@style/TextAppearance.LP.Label" />

        <ImageButton
            android:id="@+id/button_move_up"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/cd_move_up"
            android:padding="@dimen/lp_space_1"
            android:src="@drawable/ic_arrow_up"
            app:tint="?attr/lpInkTertiary" />

        <ImageButton
            android:id="@+id/button_move_down"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/cd_move_down"
            android:padding="@dimen/lp_space_1"
            android:src="@drawable/ic_arrow_down"
            app:tint="?attr/lpInkTertiary" />

        <ImageButton
            android:id="@+id/button_remove"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/cd_delete_exercise"
            android:padding="@dimen/lp_space_1"
            android:src="@drawable/ic_delete"
            app:tint="?attr/lpNegative" />
    </LinearLayout>
</com.google.android.material.card.MaterialCardView>
