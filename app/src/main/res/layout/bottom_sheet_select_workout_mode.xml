<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@color/fitness_background"
    android:clipChildren="false">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="24dp"
        android:fitsSystemWindows="false"
        android:clipChildren="false"
        android:clipToPadding="false">

        <!-- Header -->
        <TextView
            android:id="@+id/text_header_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Start Workout"
            android:textColor="@color/fitness_text_primary"
            android:textSize="24sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/text_header_subtitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:layout_marginBottom="24dp"
            android:text="Choose how you want to start"
            android:textColor="@color/fitness_text_secondary"
            android:textSize="14sp" />

        <!-- Main Tiles Container -->
        <LinearLayout
            android:id="@+id/layout_main_tiles"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:clipChildren="false"
            android:clipToPadding="false">

            <!-- Custom Tile -->
            <include
                android:id="@+id/tile_custom"
                layout="@layout/item_workout_mode_tile" />

            <!-- Plan Tile -->
            <include
                android:id="@+id/tile_plan"
                layout="@layout/item_workout_mode_tile" />

            <!-- Stretch Tile -->
            <include
                android:id="@+id/tile_stretch"
                layout="@layout/item_workout_mode_tile" />
        </LinearLayout>

        <!-- Plan List Container (Initially Hidden) -->
        <LinearLayout
            android:id="@+id/layout_plan_list"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:orientation="vertical"
            android:visibility="gone"
            android:clipChildren="false"
            android:clipToPadding="false">

            <!-- Continue plan set card (shown when user has an active rotation) -->
            <androidx.cardview.widget.CardView
                android:id="@+id/card_continue_rotation"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="16dp"
                android:visibility="gone"
                app:cardBackgroundColor="@color/fitness_primary"
                app:cardCornerRadius="12dp"
                app:cardElevation="4dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:clickable="true"
                    android:focusable="true"
                    android:foreground="?attr/selectableItemBackground"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <TextView
                        android:id="@+id/text_continue_label"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Continue Rotation"
                        android:textColor="@color/white"
                        android:textSize="12sp"
                        android:alpha="0.8" />

                    <TextView
                        android:id="@+id/text_continue_plan_set_name"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:textColor="@color/white"
                        android:textSize="17sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/text_continue_next_plan"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:textColor="@color/white"
                        android:textSize="13sp"
                        android:alpha="0.85" />
                </LinearLayout>
            </androidx.cardview.widget.CardView>

            <!-- Individual plans section -->
            <TextView
                android:id="@+id/text_plan_list_title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginBottom="12dp"
                android:text="Individual Plans"
                android:textColor="@color/fitness_text_primary"
                android:textSize="16sp"
                android:textStyle="bold" />

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/recycler_view_plans"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:nestedScrollingEnabled="false"
                android:clipChildren="false"
                android:clipToPadding="false"
                android:paddingTop="4dp" />

            <TextView
                android:id="@+id/text_empty_plans"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:layout_gravity="center"
                android:text="No plans available. Create one from the Plans screen."
                android:textColor="@color/fitness_text_secondary"
                android:textSize="14sp"
                android:visibility="gone" />

            <!-- Plan rotations section -->
            <TextView
                android:id="@+id/text_rotations_title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:layout_marginBottom="12dp"
                android:text="Plan Rotations"
                android:textColor="@color/fitness_text_primary"
                android:textSize="16sp"
                android:textStyle="bold"
                android:visibility="gone" />

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/recycler_view_plan_sets"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:nestedScrollingEnabled="false"
                android:visibility="gone"
                android:clipChildren="false"
                android:clipToPadding="false"
                android:paddingTop="4dp" />
        </LinearLayout>

        <!-- Stretch Picker Container (Initially Hidden) -->
        <LinearLayout
            android:id="@+id/layout_stretch_picker"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:orientation="vertical"
            android:visibility="gone"
            android:clipChildren="false"
            android:clipToPadding="false">

            <TextView
                android:id="@+id/text_stretch_picker_title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginBottom="12dp"
                android:text="Target Areas"
                android:textColor="@color/fitness_text_primary"
                android:textSize="16sp"
                android:textStyle="bold" />

            <com.google.android.material.chip.ChipGroup
                android:id="@+id/chip_group_stretch_areas"
                android:layout_width="match_parent"
                android:layout_height="wrap_content" />

            <!-- Explicit style: the dialog theme overlay defaults buttons to borderless text style -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/button_start_stretching"
                style="@style/Widget.MaterialComponents.Button"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:text="Start Stretching" />
        </LinearLayout>
    </LinearLayout>
</androidx.coordinatorlayout.widget.CoordinatorLayout>
