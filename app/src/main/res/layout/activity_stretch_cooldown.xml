<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="?attr/lpCanvas"
    android:fitsSystemWindows="true">

    <!-- Background animation -->
    <ImageView
        android:id="@+id/image_bg_animation"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:alpha="1.0"
        android:scaleType="centerCrop"
        app:srcCompat="@drawable/lp_bg_ambient_flow"
        app:tint="?attr/lpAccent" />

    <!-- Header -->
    <LinearLayout
        android:id="@+id/layout_header"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="@dimen/lp_space_6"
        android:paddingEnd="@dimen/lp_space_6"
        android:paddingTop="@dimen/lp_space_4"
        android:paddingBottom="@dimen/lp_space_2"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/stretch_cooldown_title"
            android:textAppearance="@style/TextAppearance.LP.Title" />

        <TextView
            android:id="@+id/text_progress_label"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textAppearance="@style/TextAppearance.LP.Body" />
    </LinearLayout>

    <!-- Stretch-count progress bar -->
    <ProgressBar
        android:id="@+id/progress_bar"
        style="?android:attr/progressBarStyleHorizontal"
        android:layout_width="0dp"
        android:layout_height="4dp"
        android:layout_marginStart="@dimen/lp_space_6"
        android:layout_marginEnd="@dimen/lp_space_6"
        android:progressTint="?attr/lpAccent"
        android:progressBackgroundTint="?attr/lpInkSecondary"
        android:progressBackgroundTintMode="src_over"
        android:alpha="0.3"
        app:layout_constraintTop_toBottomOf="@id/layout_header"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- Stretch info card -->
    <com.google.android.material.card.MaterialCardView
        android:id="@+id/card_stretch"
        style="@style/Widget.LP.Card"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_marginStart="@dimen/lp_space_6"
        android:layout_marginEnd="@dimen/lp_space_6"
        android:layout_marginTop="@dimen/lp_space_3"
        android:layout_marginBottom="@dimen/lp_space_3"
        android:clickable="false"
        android:focusable="false"
        app:cardCornerRadius="@dimen/lp_radius_lg"
        app:layout_constraintTop_toBottomOf="@id/progress_bar"
        app:layout_constraintBottom_toTopOf="@id/layout_buttons"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical"
            android:gravity="center"
            android:padding="@dimen/lp_space_8">

            <TextView
                android:id="@+id/text_stretch_name"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:textAppearance="@style/TextAppearance.LP.Title" />

            <TextView
                android:id="@+id/text_target_muscle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/lp_space_2"
                android:gravity="center"
                android:textAppearance="@style/TextAppearance.LP.Body"
                android:textColor="?attr/lpAccent" />

            <ImageView
                android:id="@+id/image_stretch_illustration"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1"
                android:layout_marginTop="@dimen/lp_space_4"
                android:minHeight="120dp"
                android:scaleType="fitCenter"
                android:importantForAccessibility="no" />

            <!-- Left/Right tiles: shown only for unilateral stretches. Each tile's
                 background fill slides in to track elapsed time for that side. -->
            <LinearLayout
                android:id="@+id/layout_side_tiles"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginTop="@dimen/lp_space_4"
                android:visibility="gone">

                <FrameLayout
                    android:id="@+id/tile_side_left"
                    android:layout_width="0dp"
                    android:layout_height="48dp"
                    android:layout_weight="1"
                    android:layout_marginEnd="@dimen/lp_card_gap_dense"
                    android:clipToOutline="true"
                    android:background="@drawable/bg_tile_side_pending">

                    <View
                        android:id="@+id/fill_side_left"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:background="?attr/lpAccent"
                        android:alpha="0.22"
                        android:transformPivotX="0dp"
                        android:scaleX="0" />

                    <TextView
                        android:id="@+id/text_tile_left"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:gravity="center"
                        android:text="@string/stretch_side_left"
                        android:textAllCaps="true"
                        android:letterSpacing="0.05"
                        android:textAppearance="@style/TextAppearance.LP.Label" />
                </FrameLayout>

                <FrameLayout
                    android:id="@+id/tile_side_right"
                    android:layout_width="0dp"
                    android:layout_height="48dp"
                    android:layout_weight="1"
                    android:layout_marginStart="@dimen/lp_card_gap_dense"
                    android:clipToOutline="true"
                    android:background="@drawable/bg_tile_side_pending">

                    <View
                        android:id="@+id/fill_side_right"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:background="?attr/lpAccent"
                        android:alpha="0.22"
                        android:transformPivotX="0dp"
                        android:scaleX="0" />

                    <TextView
                        android:id="@+id/text_tile_right"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:gravity="center"
                        android:text="@string/stretch_side_right"
                        android:textAllCaps="true"
                        android:letterSpacing="0.05"
                        android:textAppearance="@style/TextAppearance.LP.Label" />
                </FrameLayout>
            </LinearLayout>

            <!-- Shown during WAITING state (first stretch only) -->
            <TextView
                android:id="@+id/text_ready_hint"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/lp_space_6"
                android:gravity="center"
                android:textAppearance="@style/TextAppearance.LP.Body"
                android:text="@string/stretch_ready_hint"
                android:visibility="visible" />

            <!-- Shown during COUNTDOWN and STRETCHING states -->
            <LinearLayout
                android:id="@+id/layout_timer"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:gravity="center"
                android:layout_marginTop="@dimen/lp_space_6"
                android:visibility="gone">

                <TextView
                    android:id="@+id/text_get_ready_label"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textAppearance="@style/TextAppearance.LP.Caption"
                    android:text="@string/stretch_get_ready_label"
                    android:visibility="gone" />

                <ProgressBar
                    android:id="@+id/progress_timer_fg"
                    style="?android:attr/progressBarStyleHorizontal"
                    android:layout_width="match_parent"
                    android:layout_height="14dp"
                    android:layout_marginTop="@dimen/lp_space_3"
                    android:indeterminate="false"
                    android:progressDrawable="@drawable/progress_timer_bar"
                    android:background="@null" />

                <FrameLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/lp_space_4">

                    <TextView
                        android:id="@+id/text_timer"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_gravity="center"
                        android:gravity="center"
                        android:textAppearance="@style/TextAppearance.LP.Metric.XL" />

                    <com.google.android.material.card.MaterialCardView
                        android:id="@+id/button_pause"
                        style="@style/Widget.LP.Card.Control"
                        android:layout_width="40dp"
                        android:layout_height="40dp"
                        android:layout_gravity="end|center_vertical"
                        android:contentDescription="@string/stretch_pause_content_description">

                        <ImageView
                            android:id="@+id/image_pause_icon"
                            android:layout_width="18dp"
                            android:layout_height="18dp"
                            android:layout_gravity="center"
                            android:src="@drawable/ic_pause"
                            app:tint="?attr/lpInk"
                            android:importantForAccessibility="no" />
                    </com.google.android.material.card.MaterialCardView>
                </FrameLayout>
            </LinearLayout>

        </LinearLayout>
    </com.google.android.material.card.MaterialCardView>

    <!-- Bottom buttons -->
    <LinearLayout
        android:id="@+id/layout_buttons"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:layout_marginStart="@dimen/lp_space_6"
        android:layout_marginEnd="@dimen/lp_space_6"
        android:layout_marginBottom="@dimen/lp_space_6"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <!-- Skip + Next/Ready row -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <com.google.android.material.card.MaterialCardView
                android:id="@+id/button_skip"
                style="@style/Widget.LP.Card.Dense"
                android:layout_width="0dp"
                android:layout_height="52dp"
                android:layout_weight="1"
                android:layout_marginEnd="@dimen/lp_space_2"
                app:strokeColor="?attr/lpHairlineStrong">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:gravity="center"
                    android:text="@string/stretch_button_skip"
                    android:textAppearance="@style/TextAppearance.LP.Button"
                    android:textColor="?attr/lpInkSecondary" />
            </com.google.android.material.card.MaterialCardView>

            <com.google.android.material.card.MaterialCardView
                android:id="@+id/button_next"
                style="@style/Widget.LP.Card.Action"
                android:layout_width="0dp"
                android:layout_height="52dp"
                android:layout_weight="2">

                <TextView
                    android:id="@+id/text_button_next"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:gravity="center"
                    android:textAppearance="@style/TextAppearance.LP.Button"
                    android:textColor="?attr/lpInkInverse" />
            </com.google.android.material.card.MaterialCardView>
        </LinearLayout>

        <!-- Skip All text button -->
        <TextView
            android:id="@+id/button_skip_all"
            android:layout_width="match_parent"
            android:layout_height="44dp"
            android:gravity="center"
            android:layout_marginTop="@dimen/lp_space_1"
            android:text="@string/stretch_button_skip_all"
            android:textAppearance="@style/TextAppearance.LP.Label"
            android:textColor="?attr/lpInkSecondary"
            android:clickable="true"
            android:focusable="true"
            android:foreground="?attr/selectableItemBackground" />

    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>
