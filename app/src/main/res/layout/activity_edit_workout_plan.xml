<?xml version="1.0" encoding="utf-8"?>
<!--
  Create or edit a workout plan. AIRY header and name/notes fields (this is authored once,
  read many times, not touched mid-set), but the exercise list inside uses the DENSE scale
  and the progressive-disclosure card (list_item_plan_exercise) because arranging ten slots
  is closer to "work" than "browsing".
-->
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="?attr/lpCanvas"
    android:fitsSystemWindows="true"
    tools:context=".activities.EditWorkoutPlanActivity">

    <ImageView
        android:id="@+id/image_bg_animation"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:contentDescription="@null"
        android:scaleType="centerCrop"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:srcCompat="@drawable/lp_bg_ambient_flow"
        app:tint="?attr/lpAccent" />

    <androidx.core.widget.NestedScrollView
        android:id="@+id/scroll_view_content"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:background="@android:color/transparent"
        android:clipToPadding="false"
        android:fillViewport="true"
        app:layout_constraintBottom_toTopOf="@id/button_save_plan"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="@dimen/lp_gutter">

            <!-- HEADER -->
            <LinearLayout
                android:id="@+id/layout_header"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <com.google.android.material.card.MaterialCardView
                    style="@style/Widget.LP.Card.Control"
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    android:clickable="false"
                    android:focusable="false">

                    <ImageButton
                        android:id="@+id/button_back"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:background="?attr/selectableItemBackground"
                        android:contentDescription="@string/progress_back_content_description"
                        android:padding="@dimen/lp_space_3"
                        android:src="@drawable/ic_arrow_back_24"
                        app:tint="?attr/lpInk" />
                </com.google.android.material.card.MaterialCardView>

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/lp_space_4"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/text_header_title"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/title_create_workout_plan"
                        android:textAppearance="@style/TextAppearance.LP.Title" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/subtitle_design_routine"
                        android:textAppearance="@style/TextAppearance.LP.Body" />
                </LinearLayout>
            </LinearLayout>

            <!-- NAME -->
            <com.google.android.material.card.MaterialCardView
                style="@style/Widget.LP.Card"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/lp_space_5">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="@dimen/lp_card_padding">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/label_plan_name"
                        android:textAppearance="@style/TextAppearance.LP.Caption" />

                    <com.google.android.material.textfield.TextInputLayout
                        style="@style/Widget.LP.TextInputLayout"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/lp_space_2"
                        android:hint="@string/hint_plan_name_example">

                        <com.google.android.material.textfield.TextInputEditText
                            android:id="@+id/edit_text_plan_name"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:inputType="text"
                            android:maxLines="1" />
                    </com.google.android.material.textfield.TextInputLayout>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- EXERCISES -->
            <com.google.android.material.card.MaterialCardView
                style="@style/Widget.LP.Card"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/lp_card_gap">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="@dimen/lp_card_padding">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/label_exercises"
                        android:textAppearance="@style/TextAppearance.LP.Caption" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/button_add_exercises"
                        style="@style/Widget.LP.Button"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/lp_space_3"
                        android:text="@string/btn_add_exercises"
                        app:icon="@drawable/ic_plus"
                        app:iconGravity="textStart" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/button_add_family_slot"
                        style="@style/Widget.LP.Button.Outlined"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/lp_card_gap_dense"
                        android:text="@string/btn_add_family_slot"
                        app:icon="@drawable/ic_swap_horiz"
                        app:iconGravity="textStart" />

                    <!-- Warm-up / cool-down shortcuts -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/lp_card_gap_dense"
                        android:baselineAligned="false"
                        android:orientation="horizontal">

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/button_add_warmup"
                            style="@style/Widget.LP.Button.Outlined"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginEnd="@dimen/lp_card_gap_dense"
                            android:layout_weight="1"
                            android:minHeight="44dp"
                            android:text="@string/btn_add_warmup" />

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/button_add_cooldown"
                            style="@style/Widget.LP.Button.Outlined"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:minHeight="44dp"
                            android:text="@string/btn_add_cooldown" />
                    </LinearLayout>

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/button_add_circuit"
                        style="@style/Widget.LP.Button.Outlined"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/lp_card_gap_dense"
                        android:text="@string/btn_add_circuit_slot"
                        app:icon="@drawable/ic_refresh"
                        app:iconGravity="textStart" />

                    <androidx.recyclerview.widget.RecyclerView
                        android:id="@+id/recycler_view_plan_exercises"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/lp_space_4"
                        android:nestedScrollingEnabled="false" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- NOTES -->
            <com.google.android.material.card.MaterialCardView
                style="@style/Widget.LP.Card"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/lp_card_gap">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="@dimen/lp_card_padding">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/label_notes_optional"
                        android:textAppearance="@style/TextAppearance.LP.Caption" />

                    <com.google.android.material.textfield.TextInputLayout
                        style="@style/Widget.LP.TextInputLayout"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/lp_space_2"
                        android:hint="@string/hint_plan_notes">

                        <com.google.android.material.textfield.TextInputEditText
                            android:id="@+id/edit_text_notes"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:gravity="top"
                            android:inputType="textMultiLine"
                            android:maxLines="5"
                            android:minLines="3" />
                    </com.google.android.material.textfield.TextInputLayout>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

        </LinearLayout>
    </androidx.core.widget.NestedScrollView>

    <!-- SAVE — PINNED -->
    <com.google.android.material.button.MaterialButton
        android:id="@+id/button_save_plan"
        style="@style/Widget.LP.Button"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/lp_gutter"
        android:layout_marginEnd="@dimen/lp_gutter"
        android:layout_marginBottom="@dimen/lp_gutter"
        android:minHeight="60dp"
        android:text="@string/btn_save_plan"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent" />

</androidx.constraintlayout.widget.ConstraintLayout>
