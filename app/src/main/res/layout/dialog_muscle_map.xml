<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="?attr/lpSurface"
    android:minHeight="400dp">

    <!-- Header -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:padding="@dimen/lp_gutter"
        android:background="?attr/selectableItemBackgroundBorderless"
        android:clickable="false"
        android:focusable="false">

        <TextView
            android:id="@+id/text_muscle_overview_title"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="@string/title_muscle_overview"
            android:textAppearance="@style/TextAppearance.LP.Title" />

        <TextView
            android:id="@+id/text_muscle_summary"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/label_muscle_summary_default"
            android:textAppearance="@style/TextAppearance.LP.Metric.S"
            android:layout_marginEnd="@dimen/lp_space_2"
            tools:text="12/24 muscles activated" />

        <ImageButton
            android:id="@+id/button_close"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:src="@drawable/ic_close_24"
            app:tint="?attr/lpInkSecondary"
            android:contentDescription="@string/cd_close_dialog" />
    </LinearLayout>

    <!-- Empty State -->
    <LinearLayout
        android:id="@+id/layout_empty_state"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:gravity="center"
        android:padding="@dimen/lp_space_8"
        android:visibility="gone">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/body_muscle_overview_empty"
            android:textAppearance="@style/TextAppearance.LP.Body"
            android:gravity="center" />
    </LinearLayout>

    <!-- WebView Container -->
    <FrameLayout
        android:id="@+id/layout_webview_container"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:minHeight="400dp"
        android:background="?attr/lpCanvas">

        <ImageView
            android:id="@+id/image_muscle_map"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:scaleType="fitCenter"
            android:contentDescription="@string/cd_muscle_map" />

        <ProgressBar
            android:id="@+id/progress_loading"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:visibility="visible"
            android:indeterminateTint="?attr/lpAccent" />
    </FrameLayout>

</LinearLayout>

