<?xml version="1.0" encoding="utf-8"?>
<!--
    Progress > Fuel. Only reachable when TriPath is connected — see ProgressPagerAdapter.pages.
    Analytics live in Progress per the Navigation Contract, which is why this is a page here
    rather than a card on the Workout tab.
-->
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@android:color/transparent"
    android:clipToPadding="false"
    android:padding="@dimen/lp_gutter">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <TextView
            android:id="@+id/text_fuel_empty"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/lp_space_10"
            android:gravity="center"
            android:text="@string/fuel_no_data"
            android:textAppearance="@style/TextAppearance.LP.Body"
            android:visibility="gone" />

        <!-- Averages over the window -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/card_fuel_summary"
            style="@style/Widget.LP.Card"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/lp_space_4">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="@dimen/lp_card_padding">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/fuel_title"
                    android:textAppearance="@style/TextAppearance.LP.Heading" />

                <TextView
                    android:id="@+id/text_fuel_window"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/placeholder_dash"
                    android:textAppearance="@style/TextAppearance.LP.Caption" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/lp_space_4"
                    android:orientation="horizontal">

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/fuel_intake"
                            android:textAppearance="@style/TextAppearance.LP.Caption" />

                        <TextView
                            android:id="@+id/text_fuel_intake"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/placeholder_dash"
                            android:textAppearance="@style/TextAppearance.LP.Metric.M" />
                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/fuel_expenditure"
                            android:textAppearance="@style/TextAppearance.LP.Caption" />

                        <TextView
                            android:id="@+id/text_fuel_expenditure"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/placeholder_dash"
                            android:textAppearance="@style/TextAppearance.LP.Metric.M" />
                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/fuel_balance"
                            android:textAppearance="@style/TextAppearance.LP.Caption" />

                        <TextView
                            android:id="@+id/text_fuel_balance"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/placeholder_dash"
                            android:textAppearance="@style/TextAppearance.LP.Metric.M" />
                    </LinearLayout>
                </LinearLayout>

                <TextView
                    android:id="@+id/text_fuel_under_fueled"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/lp_space_3"
                    android:text="@string/placeholder_dash"
                    android:textAppearance="@style/TextAppearance.LP.Body" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- Intake against expenditure, day by day -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/card_fuel_chart"
            style="@style/Widget.LP.Card"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/lp_space_4">

            <com.github.mikephil.charting.charts.LineChart
                android:id="@+id/chart_fuel"
                android:layout_width="match_parent"
                android:layout_height="220dp"
                android:padding="@dimen/lp_space_3" />
        </com.google.android.material.card.MaterialCardView>

        <!-- The validation half: LiftPath's own lifting estimate against TriPath's figure -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/card_lift_burn"
            style="@style/Widget.LP.Card"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/lp_space_4">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="@dimen/lp_card_padding">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/fuel_lift_burn_title"
                    android:textAppearance="@style/TextAppearance.LP.Heading" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/lp_space_1"
                    android:text="@string/fuel_lift_burn_explainer"
                    android:textAppearance="@style/TextAppearance.LP.Caption" />

                <LinearLayout
                    android:id="@+id/layout_lift_burn_rows"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/lp_space_3"
                    android:orientation="vertical" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>
    </LinearLayout>
</androidx.core.widget.NestedScrollView>
