<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/card_view_exercise_item"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:gravity="center_vertical"
    android:minHeight="48dp"
    android:orientation="horizontal"
    android:paddingStart="16dp"
    android:paddingEnd="16dp"
    android:paddingTop="12dp"
    android:paddingBottom="12dp"
    android:background="?android:attr/selectableItemBackground"
    android:clickable="true"
    android:focusable="true">

    <ImageView
        android:id="@+id/image_exercise_illustration"
        android:layout_width="40dp"
        android:layout_height="40dp"
        android:layout_marginEnd="10dp"
        android:scaleType="fitCenter"
        android:importantForAccessibility="no" />

    <ImageView
        android:id="@+id/image_plan_badge"
        android:layout_width="24dp"
        android:layout_height="24dp"
        android:src="@drawable/ic_checkmark"
        android:visibility="gone"
        android:contentDescription="In plan"
        app:tint="?attr/lpAccent" />

    <ImageView
        android:id="@+id/image_favorite_star"
        android:layout_width="20dp"
        android:layout_height="20dp"
        android:layout_marginStart="12dp"
        android:src="@drawable/ic_star"
        android:visibility="gone"
        android:contentDescription="Favorite"
        app:tint="?attr/lpAccent" />

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="12dp"
        android:layout_weight="1"
        android:orientation="vertical"
        android:gravity="center_vertical">

        <TextView
            android:id="@+id/text_exercise_name"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Exercise Name"
            android:textAppearance="@style/TextAppearance.LP.Heading" />

        <TextView
            android:id="@+id/text_exercise_meta"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:textAppearance="@style/TextAppearance.LP.Label"
            android:textColor="?attr/lpInkSecondary"
            android:visibility="gone" />
    </LinearLayout>

    <!-- Shown only in Superset multi-select mode; the row itself is the tap target, this is
         display-only. -->
    <CheckBox
        android:id="@+id/checkbox_select"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="8dp"
        android:clickable="false"
        android:focusable="false"
        android:visibility="gone" />
</LinearLayout>
