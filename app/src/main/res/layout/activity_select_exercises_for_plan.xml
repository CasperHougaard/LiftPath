<?xml version="1.0" encoding="utf-8"?>
<!--
  Multi-select exercise picker, reached from Edit Workout Plan's "Add exercises". Mirrors
  fragment_library's search + hairline-card list, since it is the same catalogue shown a
  different way (checkboxes instead of an edit action).
-->
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="?attr/lpCanvas"
    android:fitsSystemWindows="true"
    tools:context=".activities.SelectExercisesForPlanActivity">

    <com.liftpath.views.AmbientFlowView
        android:id="@+id/view_bg_ambient"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:padding="@dimen/lp_gutter">

        <com.google.android.material.card.MaterialCardView
            android:id="@+id/button_back"
            style="@style/Widget.LP.Card.Control"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:clickable="false"
            android:focusable="false"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent">

            <ImageButton
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:background="?attr/selectableItemBackground"
                android:contentDescription="@string/progress_back_content_description"
                android:padding="@dimen/lp_space_3"
                android:src="@drawable/ic_arrow_back_24"
                app:tint="?attr/lpInk" />
        </com.google.android.material.card.MaterialCardView>

        <LinearLayout
            android:id="@+id/header_container"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/lp_space_4"
            android:orientation="vertical"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toEndOf="@id/button_back"
            app:layout_constraintTop_toTopOf="@id/button_back">

            <TextView
                android:id="@+id/text_title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/title_select_exercises"
                android:textAppearance="@style/TextAppearance.LP.Title" />

            <TextView
                android:id="@+id/text_selected_count"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/lp_space_1"
                android:textAppearance="@style/TextAppearance.LP.Body"
                tools:text="0 selected" />
        </LinearLayout>

        <!-- SEARCH -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/card_search"
            style="@style/Widget.LP.Card"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/lp_space_5"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/header_container">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingHorizontal="@dimen/lp_card_padding"
                android:paddingVertical="@dimen/lp_space_3">

                <ImageView
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    android:layout_marginEnd="@dimen/lp_space_3"
                    android:contentDescription="@null"
                    android:src="@drawable/ic_search_24"
                    app:tint="?attr/lpInkTertiary" />

                <EditText
                    android:id="@+id/edit_text_search"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:background="@android:color/transparent"
                    android:hint="@string/hint_search_exercises"
                    android:imeOptions="actionSearch"
                    android:inputType="text"
                    android:maxLines="1"
                    android:textAppearance="@style/TextAppearance.LP.Body"
                    android:textColor="?attr/lpInk"
                    android:textColorHint="?attr/lpInkTertiary" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <com.google.android.material.chip.Chip
            android:id="@+id/chip_group_by_family"
            style="@style/Widget.LP.Chip.Choice"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/lp_space_3"
            android:text="@string/chip_group_by_family"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/card_search" />

        <!-- EXERCISES -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/card_exercises_list"
            style="@style/Widget.LP.Card"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_marginTop="@dimen/lp_space_3"
            android:layout_marginBottom="@dimen/lp_card_gap"
            app:layout_constraintBottom_toTopOf="@id/button_done"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/chip_group_by_family">

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/recycler_view_exercises"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:clipChildren="false"
                android:clipToPadding="false"
                android:paddingHorizontal="@dimen/lp_space_2" />
        </com.google.android.material.card.MaterialCardView>

        <!-- DONE — PINNED -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/button_done"
            style="@style/Widget.LP.Button"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:minHeight="60dp"
            android:text="@string/btn_done"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent" />

    </androidx.constraintlayout.widget.ConstraintLayout>
</androidx.constraintlayout.widget.ConstraintLayout>
