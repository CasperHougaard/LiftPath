<?xml version="1.0" encoding="utf-8"?>
<!--
  Progress > PRs tab page. AIRY spacing. Filter chips keep a per-category hairline stroke
  colour as a pre-selection hint, but selection itself still goes ink (Widget.LP.Chip.Choice's
  default), matching the "selected chips are ink, not accent" rule used everywhere else chips
  appear.
-->
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@android:color/transparent">

    <!-- Filter Chips -->
    <com.google.android.material.chip.ChipGroup
        android:id="@+id/chip_group_pr_filter"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingHorizontal="@dimen/lp_gutter"
        android:paddingTop="@dimen/lp_space_4"
        android:paddingBottom="@dimen/lp_space_2"
        app:chipSpacing="@dimen/lp_space_2"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:singleSelection="true"
        app:selectionRequired="true">

        <com.google.android.material.chip.Chip
            android:id="@+id/chip_all"
            style="@style/Widget.LP.Chip.Choice"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:checked="true"
            android:text="@string/filter_all"
            app:chipStrokeColor="?attr/lpAccent" />

        <com.google.android.material.chip.Chip
            android:id="@+id/chip_strength_pr"
            style="@style/Widget.LP.Chip.Choice"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/weight_pr_label"
            app:chipStrokeColor="?attr/lpIntentStrength" />

        <com.google.android.material.chip.Chip
            android:id="@+id/chip_volume_pr"
            style="@style/Widget.LP.Chip.Choice"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/progress_volume"
            app:chipStrokeColor="?attr/lpIntentBuild" />

        <com.google.android.material.chip.Chip
            android:id="@+id/chip_1rm_pr"
            style="@style/Widget.LP.Chip.Choice"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/progress_1rm"
            app:chipStrokeColor="?attr/lpAccent" />

        <com.google.android.material.chip.Chip
            android:id="@+id/chip_hold_pr"
            style="@style/Widget.LP.Chip.Choice"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/progress_best_hold"
            app:chipStrokeColor="?attr/lpIntentBuild" />
    </com.google.android.material.chip.ChipGroup>

    <!-- PR Summary Card -->
    <com.google.android.material.card.MaterialCardView
        android:id="@+id/card_pr_summary"
        style="@style/Widget.LP.Card"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/lp_gutter"
        android:layout_marginTop="@dimen/lp_space_2"
        android:layout_marginEnd="@dimen/lp_gutter"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/chip_group_pr_filter">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="@dimen/lp_card_padding">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/progress_pr_summary"
                android:textAppearance="@style/TextAppearance.LP.Heading" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/lp_space_4"
                android:baselineAligned="false"
                android:orientation="horizontal">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:gravity="center"
                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/text_total_prs"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:textAppearance="@style/TextAppearance.LP.Metric.L"
                        android:textColor="?attr/lpAccent"
                        tools:text="24" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/progress_total_prs"
                        android:textAppearance="@style/TextAppearance.LP.Caption" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:gravity="center"
                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/text_this_month"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:textAppearance="@style/TextAppearance.LP.Metric.L"
                        android:textColor="?attr/lpAccent"
                        tools:text="5" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/progress_this_month"
                        android:textAppearance="@style/TextAppearance.LP.Caption" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:gravity="center"
                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/text_streak"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:textAppearance="@style/TextAppearance.LP.Metric.L"
                        android:textColor="?attr/lpIntentStrength"
                        tools:text="3" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/progress_week_streak"
                        android:textAppearance="@style/TextAppearance.LP.Caption" />
                </LinearLayout>
            </LinearLayout>
        </LinearLayout>
    </com.google.android.material.card.MaterialCardView>

    <!-- PR Timeline Title -->
    <TextView
        android:id="@+id/text_timeline_title"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/lp_gutter"
        android:layout_marginTop="@dimen/lp_section_gap"
        android:text="@string/progress_pr_timeline"
        android:textAppearance="@style/TextAppearance.LP.Heading"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/card_pr_summary" />

    <!-- PR Timeline List -->
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/recycler_pr_timeline"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:clipToPadding="false"
        android:paddingHorizontal="@dimen/lp_gutter"
        android:paddingTop="@dimen/lp_space_3"
        android:paddingBottom="@dimen/lp_gutter"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/text_timeline_title"
        tools:itemCount="10"
        tools:listitem="@layout/item_exercise_pr_card" />

    <TextView
        android:id="@+id/text_empty_state"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:padding="@dimen/lp_space_6"
        android:text="@string/progress_no_prs"
        android:textAppearance="@style/TextAppearance.LP.Body"
        android:visibility="gone"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/text_timeline_title" />
</androidx.constraintlayout.widget.ConstraintLayout>
