<?xml version="1.0" encoding="utf-8"?>
<!-- One plan in the "start workout" sheet's plan list. -->
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/card_view_plan_item"
    style="@style/Widget.LP.Card.Interactive"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="@dimen/lp_card_gap_dense">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:padding="@dimen/lp_card_padding_dense">

        <TextView
            android:id="@+id/text_plan_name"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:ellipsize="end"
            android:maxLines="1"
            android:textAppearance="@style/TextAppearance.LP.Label"
            tools:text="Push Day" />

        <TextView
            android:id="@+id/text_exercise_count"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/lp_space_2"
            android:textAppearance="@style/TextAppearance.LP.Metric.S"
            tools:text="6 exercises" />
    </LinearLayout>
</com.google.android.material.card.MaterialCardView>
