<?xml version="1.0" encoding="utf-8"?>
<!--
  Correct a set after the fact (or add one to a past session).

  Same field vocabulary as activity_log_set — same Numeric.Large mono inputs, same one-card
  form — because these two screens edit exactly the same record and looking different would
  imply they don't. What differs is the framing: no steppers (you are typing a correction,
  not nudging a live number), no suggestion banner, and a destructive action.

  Delete is an outlined destructive button, not a red slab: a filled red target sitting under
  the fields is an invitation to the mis-tap it is warning about.
-->
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="?attr/lpCanvas"
    android:fitsSystemWindows="true"
    tools:context=".activities.EditSetActivity">

    <ImageView
        android:id="@+id/image_bg_animation"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:contentDescription="@null"
        android:scaleType="centerCrop"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:srcCompat="@drawable/lp_bg_ambient_flow"
        app:tint="?attr/lpAccent" />

    <androidx.core.widget.NestedScrollView
        android:id="@+id/scroll_view_content"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:background="@android:color/transparent"
        android:clipToPadding="false"
        android:fillViewport="true"
        app:layout_constraintBottom_toTopOf="@id/button_container"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="@dimen/lp_gutter_dense">

            <!-- HEADER -->
            <LinearLayout
                android:id="@+id/layout_header"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <com.google.android.material.card.MaterialCardView
                    style="@style/Widget.LP.Card.Control"
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    android:clickable="false"
                    android:focusable="false">

                    <ImageButton
                        android:id="@+id/button_back"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:background="?attr/selectableItemBackground"
                        android:contentDescription="@string/progress_back_content_description"
                        android:padding="@dimen/lp_space_3"
                        android:src="@drawable/ic_arrow_back_24"
                        app:tint="?attr/lpInk" />
                </com.google.android.material.card.MaterialCardView>

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/lp_space_3"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/text_title"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/title_edit_set"
                        android:textAppearance="@style/TextAppearance.LP.Title" />

                    <TextView
                        android:id="@+id/text_subtitle"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/subtitle_update_set_details"
                        android:textAppearance="@style/TextAppearance.LP.Label"
                        android:textColor="?attr/lpInkTertiary" />
                </LinearLayout>
            </LinearLayout>

            <!-- SET DETAILS -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/card_set_details"
                style="@style/Widget.LP.Card"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/lp_space_4">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="@dimen/lp_card_padding">

                    <!-- Weight (weighted exercises) -->
                    <LinearLayout
                        android:id="@+id/weighted_weight_container"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/label_weight_kg"
                            android:textAppearance="@style/TextAppearance.LP.Caption" />

                        <com.google.android.material.textfield.TextInputLayout
                            style="@style/Widget.LP.TextInputLayout.Numeric.Large"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="@dimen/lp_space_2">

                            <com.google.android.material.textfield.TextInputEditText
                                android:id="@+id/edit_text_kg"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:hint="@string/hint_kg"
                                android:inputType="numberDecimal" />
                        </com.google.android.material.textfield.TextInputLayout>
                    </LinearLayout>

                    <!-- Bodyweight (bodyweight exercises) -->
                    <LinearLayout
                        android:id="@+id/bodyweight_container"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:visibility="gone">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/bodyweight_field_hint"
                            android:textAppearance="@style/TextAppearance.LP.Caption" />

                        <com.google.android.material.textfield.TextInputLayout
                            style="@style/Widget.LP.TextInputLayout.Numeric.Large"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="@dimen/lp_space_2">

                            <com.google.android.material.textfield.TextInputEditText
                                android:id="@+id/edit_text_bodyweight"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:hint="@string/bodyweight_field_hint"
                                android:inputType="numberDecimal" />
                        </com.google.android.material.textfield.TextInputLayout>

                        <com.google.android.material.chip.ChipGroup
                            android:id="@+id/chip_group_extra_type"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="@dimen/lp_space_3"
                            app:chipSpacing="@dimen/lp_card_gap_dense"
                            app:selectionRequired="true"
                            app:singleSelection="true">

                            <com.google.android.material.chip.Chip
                                android:id="@+id/chip_added"
                                style="@style/Widget.LP.Chip.Choice"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="@string/bodyweight_added" />

                            <com.google.android.material.chip.Chip
                                android:id="@+id/chip_assisted"
                                style="@style/Widget.LP.Chip.Choice"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="@string/bodyweight_assisted" />
                        </com.google.android.material.chip.ChipGroup>

                        <com.google.android.material.textfield.TextInputLayout
                            style="@style/Widget.LP.TextInputLayout.Numeric.Large"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="@dimen/lp_space_2">

                            <com.google.android.material.textfield.TextInputEditText
                                android:id="@+id/edit_text_extra"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:hint="@string/bodyweight_extra_hint"
                                android:inputType="numberDecimal" />
                        </com.google.android.material.textfield.TextInputLayout>

                        <TextView
                            android:id="@+id/text_effective_load"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="@dimen/lp_space_2"
                            android:textAppearance="@style/TextAppearance.LP.Metric.S"
                            tools:text="Effective load 82.5 kg" />
                    </LinearLayout>

                    <View
                        style="@style/Widget.LP.Divider"
                        android:layout_marginTop="@dimen/lp_space_4"
                        android:layout_marginBottom="@dimen/lp_space_4" />

                    <!-- Reps -->
                    <LinearLayout
                        android:id="@+id/reps_container"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/label_repetitions"
                            android:textAppearance="@style/TextAppearance.LP.Caption" />

                        <com.google.android.material.textfield.TextInputLayout
                            style="@style/Widget.LP.TextInputLayout.Numeric.Large"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="@dimen/lp_space_2">

                            <com.google.android.material.textfield.TextInputEditText
                                android:id="@+id/edit_text_reps"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:hint="@string/label_reps"
                                android:inputType="number" />
                        </com.google.android.material.textfield.TextInputLayout>
                    </LinearLayout>

                    <!-- Duration (timed exercises) -->
                    <LinearLayout
                        android:id="@+id/time_container"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:visibility="gone">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/hold_time_label"
                            android:textAppearance="@style/TextAppearance.LP.Caption" />

                        <com.google.android.material.textfield.TextInputLayout
                            style="@style/Widget.LP.TextInputLayout.Numeric.Large"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="@dimen/lp_space_2">

                            <com.google.android.material.textfield.TextInputEditText
                                android:id="@+id/edit_text_duration_seconds"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:hint="@string/hold_seconds_hint"
                                android:inputType="number" />
                        </com.google.android.material.textfield.TextInputLayout>
                    </LinearLayout>

                    <View
                        style="@style/Widget.LP.Divider"
                        android:layout_marginTop="@dimen/lp_space_4"
                        android:layout_marginBottom="@dimen/lp_space_4" />

                    <!-- RPE -->
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/label_rpe_full"
                        android:textAppearance="@style/TextAppearance.LP.Caption" />

                    <com.google.android.material.textfield.TextInputLayout
                        style="@style/Widget.LP.TextInputLayout.Numeric.Large"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/lp_space_2"
                        app:suffixText="@string/suffix_out_of_ten">

                        <com.google.android.material.textfield.TextInputEditText
                            android:id="@+id/edit_text_rpe"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:hint="@string/hint_rpe_range"
                            android:inputType="numberDecimal"
                            android:maxLength="4" />
                    </com.google.android.material.textfield.TextInputLayout>

                    <View
                        style="@style/Widget.LP.Divider"
                        android:layout_marginTop="@dimen/lp_space_4"
                        android:layout_marginBottom="@dimen/lp_space_4" />

                    <!-- Notes -->
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/hint_note_optional"
                        android:textAppearance="@style/TextAppearance.LP.Caption" />

                    <com.google.android.material.textfield.TextInputLayout
                        style="@style/Widget.LP.TextInputLayout"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/lp_space_2">

                        <com.google.android.material.textfield.TextInputEditText
                            android:id="@+id/edit_text_notes"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:gravity="top"
                            android:hint="@string/hint_set_notes"
                            android:inputType="textMultiLine|textCapSentences"
                            android:minLines="3" />
                    </com.google.android.material.textfield.TextInputLayout>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- DELETE (existing sets only) -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/card_delete"
                style="@style/Widget.LP.Button.Destructive"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/lp_space_3"
                android:text="@string/btn_delete_set"
                android:visibility="gone"
                app:icon="@drawable/ic_delete"
                app:iconGravity="textStart"
                tools:visibility="visible" />

        </LinearLayout>
    </androidx.core.widget.NestedScrollView>

    <!-- FIXED BOTTOM ACTIONS -->
    <LinearLayout
        android:id="@+id/button_container"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:baselineAligned="false"
        android:orientation="horizontal"
        android:paddingStart="@dimen/lp_gutter_dense"
        android:paddingTop="@dimen/lp_space_3"
        android:paddingEnd="@dimen/lp_gutter_dense"
        android:paddingBottom="@dimen/lp_gutter_dense"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/button_cancel"
            style="@style/Widget.LP.Button.Outlined"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginEnd="@dimen/lp_card_gap"
            android:layout_weight="1"
            android:minHeight="56dp"
            android:text="@string/button_cancel" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/button_save"
            style="@style/Widget.LP.Button"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:minHeight="56dp"
            android:text="@string/button_save" />
    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>
