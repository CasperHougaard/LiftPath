<?xml version="1.0" encoding="utf-8"?>
<!--
  One station while authoring a circuit (activity_edit_circuit.xml).

  Unlike list_item_plan_exercise this has no progressive disclosure: a station carries two
  numbers at most, and a circuit is five or six of them — hiding that behind an expand chevron
  would cost more taps than it saves scrolling.

  Which field pair shows is decided by the exercise, not the user: a timed exercise gets the
  hold-time field, everything else gets reps. See EditCircuitItemAdapter.
-->
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    style="@style/Widget.LP.Card.Dense"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="@dimen/lp_card_gap_dense"
    android:clickable="false"
    android:focusable="false">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingHorizontal="@dimen/lp_card_padding_dense"
        android:paddingVertical="@dimen/lp_space_2">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/text_station_number"
                android:layout_width="26dp"
                android:layout_height="26dp"
                android:background="@drawable/lp_badge_ink"
                android:gravity="center"
                android:textAppearance="@style/TextAppearance.LP.Metric.S"
                android:textColor="?attr/lpInkInverse"
                tools:text="1" />

            <TextView
                android:id="@+id/text_station_name"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/lp_space_3"
                android:layout_weight="1"
                android:ellipsize="end"
                android:maxLines="1"
                android:textAppearance="@style/TextAppearance.LP.Label"
                tools:text="Hip Thrust (Barbell)" />

            <ImageButton
                android:id="@+id/button_move_up"
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="@string/cd_move_up"
                android:padding="@dimen/lp_space_1"
                android:src="@drawable/ic_arrow_up"
                app:tint="?attr/lpInkTertiary" />

            <ImageButton
                android:id="@+id/button_move_down"
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="@string/cd_move_down"
                android:padding="@dimen/lp_space_1"
                android:src="@drawable/ic_arrow_down"
                app:tint="?attr/lpInkTertiary" />

            <ImageButton
                android:id="@+id/button_remove_station"
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="@string/cd_remove_station"
                android:padding="@dimen/lp_space_1"
                android:src="@drawable/ic_delete"
                app:tint="?attr/lpNegative" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/lp_space_2"
            android:baselineAligned="false"
            android:orientation="horizontal">

            <LinearLayout
                android:id="@+id/layout_reps"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginEnd="@dimen/lp_card_gap_dense"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/label_reps"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="@dimen/lp_space_1"
                    android:text="@string/circuit_station_hint_reps"
                    android:textAppearance="@style/TextAppearance.LP.Caption" />

                <EditText
                    android:id="@+id/edit_station_reps"
                    style="@style/Widget.LP.EditText.Boxed"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:hint="@string/hint_reps_example"
                    android:inputType="text" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/layout_time"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginEnd="@dimen/lp_card_gap_dense"
                android:layout_weight="1"
                android:orientation="vertical"
                android:visibility="gone">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="@dimen/lp_space_1"
                    android:text="@string/circuit_station_hint_time"
                    android:textAppearance="@style/TextAppearance.LP.Caption" />

                <EditText
                    android:id="@+id/edit_station_time"
                    style="@style/Widget.LP.EditText.Boxed"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:hint="@string/hint_seconds_example"
                    android:inputType="number" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/label_kg"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="@dimen/lp_space_1"
                    android:text="@string/circuit_station_hint_kg"
                    android:textAppearance="@style/TextAppearance.LP.Caption" />

                <EditText
                    android:id="@+id/edit_station_kg"
                    style="@style/Widget.LP.EditText.Boxed"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:hint="@string/hint_auto"
                    android:inputType="numberDecimal" />
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>
</com.google.android.material.card.MaterialCardView>
