<?xml version="1.0" encoding="utf-8"?>
<!--
  A warm-up or cool-down slot while authoring a plan. No progressive disclosure — there is
  nothing to collapse, just a duration and an optional note — so it stays fully visible,
  matching list_item_plan_exercise's dense card treatment so the two read as one list.
-->
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    style="@style/Widget.LP.Card.Dense"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="@dimen/lp_card_gap_dense"
    android:clickable="false"
    android:focusable="false">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <!-- Header row: icon, label, move buttons, remove -->
        <LinearLayout
            android:id="@+id/layout_header_row"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:minHeight="@dimen/lp_row_min_height"
            android:orientation="horizontal"
            android:paddingHorizontal="@dimen/lp_card_padding_dense"
            android:paddingVertical="@dimen/lp_space_2">

            <TextView
                android:id="@+id/text_slot_icon"
                android:layout_width="26dp"
                android:layout_height="26dp"
                android:gravity="center"
                android:text="🔥"
                android:textSize="16sp" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/lp_space_3"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/text_slot_label"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/label_warmup_element"
                    android:textAppearance="@style/TextAppearance.LP.Label" />

                <TextView
                    android:id="@+id/text_slot_subtitle"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/warmup_element_subtitle"
                    android:textAppearance="@style/TextAppearance.LP.Caption" />
            </LinearLayout>

            <ImageButton
                android:id="@+id/button_move_up"
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="@string/cd_move_up"
                android:padding="@dimen/lp_space_1"
                android:src="@drawable/ic_arrow_up"
                app:tint="?attr/lpInkTertiary" />

            <ImageButton
                android:id="@+id/button_move_down"
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="@string/cd_move_down"
                android:padding="@dimen/lp_space_1"
                android:src="@drawable/ic_arrow_down"
                app:tint="?attr/lpInkTertiary" />

            <ImageButton
                android:id="@+id/button_remove_slot"
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="@string/cd_delete_exercise"
                android:padding="@dimen/lp_space_1"
                android:src="@drawable/ic_delete"
                app:tint="?attr/lpNegative" />
        </LinearLayout>

        <View style="@style/Widget.LP.Divider" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingHorizontal="@dimen/lp_card_padding_dense"
            android:paddingTop="@dimen/lp_space_3"
            android:paddingBottom="@dimen/lp_card_padding_dense">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="@dimen/lp_space_3"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="@string/label_duration_minutes"
                    android:textAppearance="@style/TextAppearance.LP.Caption" />

                <EditText
                    android:id="@+id/edit_slot_duration"
                    style="@style/Widget.LP.EditText.Boxed"
                    android:layout_width="64dp"
                    android:layout_height="wrap_content"
                    android:hint="@string/hint_five"
                    android:inputType="number"
                    android:maxLength="3" />
            </LinearLayout>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginBottom="@dimen/lp_space_1"
                android:text="@string/label_notes"
                android:textAppearance="@style/TextAppearance.LP.Caption" />

            <EditText
                android:id="@+id/edit_slot_notes"
                style="@style/Widget.LP.EditText.Boxed.Notes"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="@string/hint_warmup_notes"
                android:inputType="textMultiLine"
                android:minLines="2" />
        </LinearLayout>
    </LinearLayout>
</com.google.android.material.card.MaterialCardView>
