<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="8dp"
    app:cardBackgroundColor="@color/fitness_card_background"
    app:cardCornerRadius="8dp"
    app:cardElevation="2dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <!-- Header row: icon, label, move buttons, remove -->
        <LinearLayout
            android:id="@+id/layout_header_row"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:padding="12dp">

            <TextView
                android:id="@+id/text_slot_icon"
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:gravity="center"
                android:textSize="18sp"
                android:text="🔥" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="12dp"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/text_slot_label"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/label_warmup_element"
                    android:textColor="@color/fitness_text_primary"
                    android:textSize="15sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/text_slot_subtitle"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:text="@string/warmup_element_subtitle"
                    android:textColor="@color/fitness_text_secondary"
                    android:textSize="12sp" />
            </LinearLayout>

            <!-- Move up -->
            <ImageButton
                android:id="@+id/button_move_up"
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="Move up"
                android:src="@drawable/ic_arrow_up"
                android:padding="6dp"
                app:tint="@color/fitness_text_secondary" />

            <!-- Move down -->
            <ImageButton
                android:id="@+id/button_move_down"
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="Move down"
                android:src="@drawable/ic_arrow_down"
                android:padding="6dp"
                app:tint="@color/fitness_text_secondary" />

            <!-- Remove -->
            <ImageButton
                android:id="@+id/button_remove_slot"
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="Remove"
                android:src="@android:drawable/ic_menu_delete"
                android:tint="@color/fitness_accent" />
        </LinearLayout>

        <!-- Divider -->
        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="@color/fitness_text_secondary"
            android:alpha="0.2" />

        <!-- Duration + Notes section -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="12dp"
            android:paddingTop="8dp">

            <!-- Duration row -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginBottom="10dp">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="Duration (min)"
                    android:textColor="@color/fitness_text_secondary"
                    android:textSize="12sp" />

                <EditText
                    android:id="@+id/edit_slot_duration"
                    android:layout_width="64dp"
                    android:layout_height="wrap_content"
                    android:backgroundTint="@color/fitness_primary"
                    android:gravity="center"
                    android:hint="5"
                    android:inputType="number"
                    android:maxLength="3"
                    android:textColor="@color/fitness_text_primary"
                    android:textColorHint="@color/fitness_text_secondary"
                    android:textSize="14sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Notes"
                android:textColor="@color/fitness_text_secondary"
                android:textSize="12sp"
                android:layout_marginBottom="4dp" />

            <EditText
                android:id="@+id/edit_slot_notes"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:backgroundTint="@color/fitness_primary"
                android:hint="@string/hint_warmup_notes"
                android:inputType="textMultiLine"
                android:minLines="2"
                android:textColor="@color/fitness_text_primary"
                android:textColorHint="@color/fitness_text_secondary"
                android:textSize="13sp" />
        </LinearLayout>
    </LinearLayout>
</androidx.cardview.widget.CardView>
