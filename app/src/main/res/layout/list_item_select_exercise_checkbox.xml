<?xml version="1.0" encoding="utf-8"?>
<!-- A row in the exercise picker (activity_select_exercises_for_plan.xml). Lives inside a
     single hairline card, so this stays a plain row rather than a card of its own. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="?attr/selectableItemBackground"
    android:gravity="center_vertical"
    android:minHeight="@dimen/lp_row_min_height"
    android:orientation="horizontal"
    android:paddingHorizontal="@dimen/lp_space_2"
    android:paddingVertical="@dimen/lp_space_2">

    <ImageView
        android:id="@+id/image_exercise_illustration"
        android:layout_width="36dp"
        android:layout_height="36dp"
        android:layout_marginEnd="@dimen/lp_space_2"
        android:importantForAccessibility="no"
        android:scaleType="fitCenter" />

    <CheckBox
        android:id="@+id/checkbox_exercise"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:buttonTint="?attr/lpAccent" />

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/lp_space_3"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            android:id="@+id/text_exercise_name"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textAppearance="@style/TextAppearance.LP.Label" />

        <TextView
            android:id="@+id/text_exercise_meta"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textAppearance="@style/TextAppearance.LP.Caption"
            android:visibility="gone" />
    </LinearLayout>
</LinearLayout>
