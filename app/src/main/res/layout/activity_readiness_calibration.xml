<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="?attr/lpCanvas"
    android:fitsSystemWindows="true"
    tools:context=".activities.ReadinessCalibrationActivity">

    <com.liftpath.views.AmbientFlowView
        android:id="@+id/view_bg_ambient"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@android:color/transparent"
        android:clipToPadding="false"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:clipChildren="false"
            android:clipToPadding="false"
            android:orientation="vertical"
            android:padding="@dimen/lp_gutter">

            <!-- HEADER -->
            <LinearLayout
                android:id="@+id/header_container"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/button_back"
                    style="@style/Widget.LP.Card.Control"
                    android:layout_width="48dp"
                    android:layout_height="48dp">

                    <ImageButton
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:background="@android:color/transparent"
                        android:clickable="false"
                        android:contentDescription="@string/progress_back_content_description"
                        android:focusable="false"
                        android:padding="@dimen/lp_space_3"
                        android:src="@drawable/ic_arrow_back_24"
                        app:tint="?attr/lpInk" />
                </com.google.android.material.card.MaterialCardView>

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/lp_space_4"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/readiness_calibration_title"
                        android:textAppearance="@style/TextAppearance.LP.Title" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/lp_space_1"
                        android:text="@string/readiness_calibration_subtitle"
                        android:textAppearance="@style/TextAppearance.LP.Body" />
                </LinearLayout>
            </LinearLayout>

            <!-- SECTION A: MY PHYSIOLOGY -->
            <com.google.android.material.card.MaterialCardView
                style="@style/Widget.LP.Card"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/lp_space_6"
                android:clickable="false"
                android:focusable="false">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="@dimen/lp_card_padding">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/readiness_physiology_title"
                        android:textAppearance="@style/TextAppearance.LP.Heading" />

                    <!-- Recovery Speed -->
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/lp_space_5"
                        android:text="@string/readiness_recovery_speed_label"
                        android:textAppearance="@style/TextAppearance.LP.Label" />

                    <TextView
                        android:id="@+id/text_recovery_speed_value"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/lp_space_1"
                        android:text="@string/readiness_recovery_speed_normal_placeholder"
                        android:textAppearance="@style/TextAppearance.LP.Label"
                        android:textColor="?attr/lpInkSecondary" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/lp_space_2"
                        android:orientation="horizontal"
                        android:gravity="center_vertical">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/readiness_recovery_speed_slow_label"
                            android:textAppearance="@style/TextAppearance.LP.Caption" />

                        <SeekBar
                            android:id="@+id/seekbar_recovery_speed"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="@dimen/lp_space_4"
                            android:layout_marginEnd="@dimen/lp_space_4"
                            android:layout_weight="1"
                            android:max="2"
                            android:progress="1" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/readiness_recovery_speed_fast_label"
                            android:textAppearance="@style/TextAppearance.LP.Caption" />
                    </LinearLayout>

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/lp_space_2"
                        android:text="@string/readiness_recovery_speed_hint"
                        android:textAppearance="@style/TextAppearance.LP.Caption" />

                    <!-- Default RPE -->
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/lp_space_6"
                        android:text="@string/readiness_default_rpe_title"
                        android:textAppearance="@style/TextAppearance.LP.Label" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/lp_space_1"
                        android:text="@string/readiness_default_rpe_description"
                        android:textAppearance="@style/TextAppearance.LP.Caption" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/lp_space_2"
                        android:orientation="horizontal"
                        android:gravity="center_vertical">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/readiness_rpe_scale_min"
                            android:textAppearance="@style/TextAppearance.LP.Caption" />

                        <SeekBar
                            android:id="@+id/seekbar_default_rpe"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="@dimen/lp_space_4"
                            android:layout_marginEnd="@dimen/lp_space_4"
                            android:layout_weight="1"
                            android:max="9"
                            android:progress="6" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/readiness_rpe_scale_max"
                            android:textAppearance="@style/TextAppearance.LP.Caption" />
                    </LinearLayout>

                    <TextView
                        android:id="@+id/text_default_rpe_value"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/lp_space_2"
                        android:text="@string/readiness_default_rpe_placeholder"
                        android:textAppearance="@style/TextAppearance.LP.Metric.M" />

                    <!-- Training Experience -->
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/lp_space_6"
                        android:text="@string/readiness_training_experience_title"
                        android:textAppearance="@style/TextAppearance.LP.Label" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/lp_space_1"
                        android:text="@string/readiness_training_experience_hint"
                        android:textAppearance="@style/TextAppearance.LP.Caption" />

                    <Spinner
                        android:id="@+id/spinner_training_experience"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/lp_space_2"
                        android:padding="@dimen/lp_space_4"
                        android:background="@drawable/spinner_background"
                        android:textColor="?attr/lpInk" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- SECTION B: SAFETY GUARDRAILS -->
            <com.google.android.material.card.MaterialCardView
                style="@style/Widget.LP.Card"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/lp_space_3"
                android:clickable="false"
                android:focusable="false">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="@dimen/lp_card_padding">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/readiness_safety_guardrails_title"
                        android:textAppearance="@style/TextAppearance.LP.Heading" />

                    <!-- Strict Run Blocking -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/lp_space_5"
                        android:orientation="horizontal"
                        android:gravity="center_vertical">

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:orientation="vertical">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="@string/readiness_strict_run_blocking_title"
                                android:textAppearance="@style/TextAppearance.LP.Label" />

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="@dimen/lp_space_1"
                                android:text="@string/readiness_strict_run_blocking_description"
                                android:textAppearance="@style/TextAppearance.LP.Caption" />
                        </LinearLayout>

                        <com.google.android.material.materialswitch.MaterialSwitch
                            android:id="@+id/switch_strict_run_blocking"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="@dimen/lp_space_4"
                            android:checked="true"
                            app:showText="false" />
                    </LinearLayout>

                    <!-- Weekend Warrior Mode -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/lp_space_6"
                        android:orientation="horizontal"
                        android:gravity="center_vertical">

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:orientation="vertical">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="@string/readiness_ignore_weekends_title"
                                android:textAppearance="@style/TextAppearance.LP.Label" />

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="@dimen/lp_space_1"
                                android:text="@string/readiness_ignore_weekends_description"
                                android:textAppearance="@style/TextAppearance.LP.Caption" />
                        </LinearLayout>

                        <com.google.android.material.materialswitch.MaterialSwitch
                            android:id="@+id/switch_ignore_weekends"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="@dimen/lp_space_4"
                            android:checked="false"
                            app:showText="false" />
                    </LinearLayout>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!--
              RESET BUTTON. Previously a CardView wrapping a raw Button with an
              accent-filled background and @color/white text — both are contract
              violations (accent is a sparse highlight, not a CTA fill; @color/white
              cannot follow the palette). Widget.LP.Button already supplies the
              ink-fill + inverse-text treatment directly, so the wrapping card is
              dropped rather than re-themed.
            -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/button_reset"
                style="@style/Widget.LP.Button"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/lp_space_6"
                android:text="@string/btn_reset_to_recommended" />

        </LinearLayout>
    </androidx.core.widget.NestedScrollView>
</androidx.constraintlayout.widget.ConstraintLayout>
