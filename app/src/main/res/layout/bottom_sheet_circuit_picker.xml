<?xml version="1.0" encoding="utf-8"?>
<!--
  "Which circuit?" — shown when a circuit is added to the active workout or to a plan.

  Height is capped so a long circuit library scrolls inside the sheet rather than pushing the
  New-circuit button off screen.
-->
<androidx.coordinatorlayout.widget.CoordinatorLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="?attr/lpCanvas">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:fitsSystemWindows="false"
        android:orientation="vertical"
        android:padding="@dimen/lp_gutter">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/circuit_picker_title"
            android:textAppearance="@style/TextAppearance.LP.Title" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/lp_space_1"
            android:layout_marginBottom="@dimen/lp_space_4"
            android:text="@string/circuit_picker_subtitle"
            android:textAppearance="@style/TextAppearance.LP.Body" />

        <TextView
            android:id="@+id/text_picker_empty"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="@dimen/lp_space_4"
            android:text="@string/circuits_empty_state"
            android:textAppearance="@style/TextAppearance.LP.Body"
            android:textColor="?attr/lpInkSecondary"
            android:visibility="gone" />

        <!-- Height is capped in CircuitPickerBottomSheet once the list is known: RecyclerView
             does not honour android:maxHeight, and an uncapped wrap_content list inside a
             bottom-anchored dialog pushes the New-circuit button off screen. -->
        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/recycler_view_circuit_picker"
            android:layout_width="match_parent"
            android:layout_height="wrap_content" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/button_new_circuit"
            style="@style/Widget.LP.Button.Outlined"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/lp_space_3"
            android:text="@string/btn_add_circuit"
            app:icon="@drawable/ic_plus"
            app:iconGravity="textStart" />
    </LinearLayout>
</androidx.coordinatorlayout.widget.CoordinatorLayout>
