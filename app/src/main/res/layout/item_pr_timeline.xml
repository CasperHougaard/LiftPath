<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    style="@style/Widget.LP.Card.Dense"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="@dimen/lp_card_gap_dense">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:padding="@dimen/lp_card_padding_dense">

        <!-- PR Icon -->
        <ImageView
            android:id="@+id/image_pr_icon"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:background="@drawable/bg_circle_decoration"
            android:backgroundTint="?attr/lpAccent"
            android:padding="@dimen/lp_space_2"
            android:src="@drawable/ic_star"
            app:tint="?attr/lpInkInverse" />

        <!-- PR Details -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/lp_space_3"
            android:layout_weight="1"
            android:orientation="vertical">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/text_exercise_name"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:ellipsize="end"
                    android:maxLines="1"
                    android:textAppearance="@style/TextAppearance.LP.Heading"
                    tools:text="Bench Press" />

                <TextView
                    android:id="@+id/text_intent_badge"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/lp_space_2"
                    android:background="@drawable/badge_rounded_background"
                    android:paddingHorizontal="@dimen/lp_space_2"
                    android:paddingVertical="@dimen/lp_space_1"
                    android:textAppearance="@style/TextAppearance.LP.Caption"
                    android:textColor="?attr/lpInkInverse"
                    tools:backgroundTint="?attr/lpIntentStrength"
                    tools:text="STRENGTH" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/lp_space_1"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/text_pr_type"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textAppearance="@style/TextAppearance.LP.Label"
                    android:textColor="?attr/lpInkSecondary"
                    tools:text="Weight PR" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/lp_space_2"
                    android:layout_marginEnd="@dimen/lp_space_2"
                    android:text="•"
                    android:textAppearance="@style/TextAppearance.LP.Label"
                    android:textColor="?attr/lpInkSecondary" />

                <TextView
                    android:id="@+id/text_pr_value"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textAppearance="@style/TextAppearance.LP.Metric.M"
                    android:textColor="?attr/lpAccent"
                    tools:text="100kg" />

                <TextView
                    android:id="@+id/text_improvement"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/lp_space_2"
                    android:textAppearance="@style/TextAppearance.LP.Metric.S"
                    android:textColor="?attr/lpAccent"
                    tools:text="+2.5kg" />
            </LinearLayout>

            <TextView
                android:id="@+id/text_date"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/lp_space_1"
                android:textAppearance="@style/TextAppearance.LP.Label"
                android:textColor="?attr/lpInkSecondary"
                tools:text="Jan 15, 2024" />
        </LinearLayout>
    </LinearLayout>
</com.google.android.material.card.MaterialCardView>
