<?xml version="1.0" encoding="utf-8"?>
<!--
  Navigation host.

  MainActivity keeps its class name and stays the LAUNCHER because it is also the
  targetActivity of the ViewPermissionUsageActivity alias that Health Connect uses — see
  AndroidManifest. So the host is this activity, and what used to be its content now lives
  in WorkoutFragment.

  The ambient background sits here rather than in each fragment: one full-bleed instance
  behind all four tabs, instead of four identical copies. It is deliberately NOT inset, so
  it runs under the status bar and behind the nav bar.

  Insets are handled once, here: top inset pads the fragment container, bottom inset pads
  the navigation bar. Fragments therefore never deal with window insets themselves.
-->
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <com.liftpath.views.AmbientFlowView
        android:id="@+id/view_bg_ambient"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <FrameLayout
        android:id="@+id/nav_host_container"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintBottom_toTopOf="@id/bottom_nav"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <!-- Hairline top border rather than elevation, matching the card treatment. -->
    <View
        android:id="@+id/divider_bottom_nav"
        android:layout_width="match_parent"
        android:layout_height="@dimen/lp_hairline_width"
        android:background="?attr/lpHairline"
        app:layout_constraintBottom_toTopOf="@id/bottom_nav"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent" />

    <com.google.android.material.bottomnavigation.BottomNavigationView
        android:id="@+id/bottom_nav"
        style="@style/Widget.LP.BottomNav"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:menu="@menu/menu_bottom_nav" />

    <!--
      ==================================================================
      COLD-START REVEAL
      ==================================================================

      These two are declared LAST on purpose. In a ConstraintLayout declaration order is
      z-order, and both have to sit above the fragment container: the system splash view is
      opaque and gets faded out early in the sequence, so from that moment on the reveal is
      playing over live, already-themed app content. When the logo was declared above the
      container it was painted over by whatever the Workout tab drew, which is why the
      previous version of this animation could not actually be seen.

      Neither is interactive, and neither is inset — they are centred on the window, which
      is where the OS drew the splash icon they hand over from.
    -->

    <!--
      Bloom. Fires as the traced mark completes: a radial accent wash pushing out from the
      logo, which is what visually *causes* the cards to rise. Reuses lp_hero_glow rather
      than adding a second radial gradient — same falloff, tinted at the point of use.
    -->
    <View
        android:id="@+id/view_reveal_bloom"
        android:layout_width="@dimen/lp_reveal_bloom_size"
        android:layout_height="@dimen/lp_reveal_bloom_size"
        android:alpha="0"
        android:background="@drawable/lp_hero_glow"
        android:backgroundTint="?attr/lpAccent"
        android:importantForAccessibility="no"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <!--
      The brand mark, drawing itself. lp_logo_trace is a stroked path whose completed form is
      pixel-identical to ic_app_logo, so the trace lands exactly on the mark rather than
      cross-fading into it. Tinted with the resolved palette's accent — this stroke is the
      moment the app first shows the user's chosen theme.
    -->
    <ImageView
        android:id="@+id/image_splash_logo"
        android:layout_width="@dimen/lp_reveal_logo_size"
        android:layout_height="@dimen/lp_reveal_logo_size"
        android:alpha="0"
        android:contentDescription="@null"
        android:importantForAccessibility="no"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:srcCompat="@drawable/lp_logo_trace"
        app:tint="?attr/lpAccent" />

</androidx.constraintlayout.widget.ConstraintLayout>
