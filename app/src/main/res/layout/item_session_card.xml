<?xml version="1.0" encoding="utf-8"?>
<!--
  One training session on the Sessions tab. AIRY spacing, hairline card, no shadow.
  The day badge stays lpInk rather than lpAccent — it repeats down the whole list, so an
  accent-filled/accent-text date would spend the signature colour on something purely
  structural. The PR count keeps lpAccent since it is a meaningful highlight, not a badge.
-->
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    style="@style/Widget.LP.Card.Interactive"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginTop="@dimen/lp_card_gap">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:padding="@dimen/lp_card_padding">

        <!-- Date Column -->
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:minWidth="56dp"
            android:orientation="vertical">

            <TextView
                android:id="@+id/text_day"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textAppearance="@style/TextAppearance.LP.Title"
                tools:text="15" />

            <TextView
                android:id="@+id/text_month"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textAppearance="@style/TextAppearance.LP.Caption"
                android:textColor="?attr/lpInkSecondary"
                tools:text="Jan" />
        </LinearLayout>

        <!-- Divider -->
        <View
            android:layout_width="@dimen/lp_hairline_width"
            android:layout_height="match_parent"
            android:layout_marginStart="@dimen/lp_space_3"
            android:layout_marginEnd="@dimen/lp_space_3"
            android:background="?attr/lpHairline" />

        <!-- Details Column -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <!-- Intent Badge -->
            <TextView
                android:id="@+id/text_intent_badge"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/badge_rounded_background"
                android:paddingHorizontal="@dimen/lp_space_2"
                android:paddingVertical="@dimen/lp_space_1"
                android:textAppearance="@style/TextAppearance.LP.Caption"
                android:textColor="?attr/lpInkInverse"
                tools:backgroundTint="?attr/lpIntentStrength"
                tools:text="STRENGTH" />

            <!-- Stats Row -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/lp_space_2"
                android:orientation="horizontal">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/text_volume"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:textAppearance="@style/TextAppearance.LP.Metric.M"
                        tools:text="3,250kg" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/volume"
                        android:textAppearance="@style/TextAppearance.LP.Caption" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/text_exercises"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:textAppearance="@style/TextAppearance.LP.Metric.M"
                        tools:text="5" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/exercises_label"
                        android:textAppearance="@style/TextAppearance.LP.Caption" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/text_prs"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:textAppearance="@style/TextAppearance.LP.Metric.M"
                        android:textColor="?attr/lpAccent"
                        tools:text="2" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/prs_label"
                        android:textAppearance="@style/TextAppearance.LP.Caption" />
                </LinearLayout>
            </LinearLayout>

            <!-- Sets / Avg RPE / Duration summary line -->
            <TextView
                android:id="@+id/text_session_summary"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/lp_space_2"
                android:textAppearance="@style/TextAppearance.LP.Caption"
                android:textColor="?attr/lpInkSecondary"
                tools:text="12 sets • Avg RPE 7.5 • 1h 02m" />
        </LinearLayout>

        <!-- Report icon button -->
        <ImageButton
            android:id="@+id/button_view_report"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:layout_gravity="center"
            android:layout_marginStart="@dimen/lp_space_2"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/content_desc_view_report"
            android:padding="@dimen/lp_space_1"
            android:src="@drawable/ic_graph"
            app:tint="?attr/lpInkSecondary" />

        <!-- Selection Checkbox (for compare mode) -->
        <CheckBox
            android:id="@+id/checkbox_select"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:visibility="gone" />
    </LinearLayout>
</com.google.android.material.card.MaterialCardView>
