<?xml version="1.0" encoding="utf-8"?>
<!--
  Progress > Overview: the analytics landing page. AIRY spacing throughout — this is read,
  not worked from. Every stat rollup uses TextAppearance.LP.Metric.L (mono, ink) rather than
  a coloured bold TextView — the numbers here all show the same kind of value and must read as
  one system.

  The RPE card and the trend carousel below arrived from the home screen when that became the
  Workout tab. They are the only time-series view in the app, so they could not simply be
  dropped: nothing else here plots volume / RPE / time / fatigue against a date axis. They sit
  after "Training focus" because that card also summarises a window rather than a session.
-->
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@android:color/transparent"
    android:clipToPadding="false"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:clipChildren="false"
        android:clipToPadding="false"
        android:orientation="vertical"
        android:padding="@dimen/lp_gutter">

        <!-- RECENT PRs -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/progress_recent_prs"
            android:textAppearance="@style/TextAppearance.LP.Heading" />

        <HorizontalScrollView
            android:id="@+id/scroll_recent_prs"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/lp_space_3"
            android:clipChildren="false"
            android:clipToPadding="false"
            android:scrollbars="none">

            <LinearLayout
                android:id="@+id/layout_pr_cards"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:clipChildren="false"
                android:clipToPadding="false"
                android:orientation="horizontal" />
        </HorizontalScrollView>

        <TextView
            android:id="@+id/text_no_prs"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/lp_space_3"
            android:gravity="center"
            android:padding="@dimen/lp_space_6"
            android:text="@string/progress_no_recent_prs"
            android:textAppearance="@style/TextAppearance.LP.Body"
            android:visibility="gone" />

        <!-- THIS WEEK -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/card_weekly_summary"
            style="@style/Widget.LP.Card"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/lp_section_gap">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="@dimen/lp_card_padding">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/progress_this_week"
                    android:textAppearance="@style/TextAppearance.LP.Heading" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/lp_space_4"
                    android:baselineAligned="false"
                    android:orientation="horizontal">

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:gravity="center"
                        android:orientation="vertical">

                        <TextView
                            android:id="@+id/text_weekly_sessions"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:textAppearance="@style/TextAppearance.LP.Metric.L"
                            tools:text="4" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="2dp"
                            android:text="@string/progress_sessions"
                            android:textAppearance="@style/TextAppearance.LP.Caption" />
                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:gravity="center"
                        android:orientation="vertical">

                        <TextView
                            android:id="@+id/text_weekly_volume"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:textAppearance="@style/TextAppearance.LP.Metric.L"
                            tools:text="12,500" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="2dp"
                            android:text="@string/progress_volume_kg"
                            android:textAppearance="@style/TextAppearance.LP.Caption" />
                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:gravity="center"
                        android:orientation="vertical">

                        <TextView
                            android:id="@+id/text_weekly_prs"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:textAppearance="@style/TextAppearance.LP.Metric.L"
                            tools:text="2" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="2dp"
                            android:text="@string/progress_prs"
                            android:textAppearance="@style/TextAppearance.LP.Caption" />
                    </LinearLayout>
                </LinearLayout>
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- TRAINING FOCUS -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/card_intent_distribution"
            style="@style/Widget.LP.Card"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/lp_card_gap">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="@dimen/lp_card_padding">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/progress_training_focus"
                    android:textAppearance="@style/TextAppearance.LP.Heading" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/progress_last_30_days"
                    android:textAppearance="@style/TextAppearance.LP.Caption" />

                <com.github.mikephil.charting.charts.PieChart
                    android:id="@+id/chart_intent_distribution"
                    android:layout_width="match_parent"
                    android:layout_height="200dp"
                    android:layout_marginTop="@dimen/lp_space_4" />

                <!-- Intent legend -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/lp_space_3"
                    android:gravity="center"
                    android:orientation="horizontal">

                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginEnd="@dimen/lp_space_4"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <View
                            android:layout_width="12dp"
                            android:layout_height="12dp"
                            android:layout_marginEnd="6dp"
                            android:background="@drawable/bg_circle_decoration"
                            android:backgroundTint="?attr/lpIntentStrength" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/intent_strength"
                            android:textAppearance="@style/TextAppearance.LP.Label"
                            android:textColor="?attr/lpInkTertiary" />
                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginEnd="@dimen/lp_space_4"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <View
                            android:layout_width="12dp"
                            android:layout_height="12dp"
                            android:layout_marginEnd="6dp"
                            android:background="@drawable/bg_circle_decoration"
                            android:backgroundTint="?attr/lpIntentBuild" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/intent_build"
                            android:textAppearance="@style/TextAppearance.LP.Label"
                            android:textColor="?attr/lpInkTertiary" />
                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <View
                            android:layout_width="12dp"
                            android:layout_height="12dp"
                            android:layout_marginEnd="6dp"
                            android:background="@drawable/bg_circle_decoration"
                            android:backgroundTint="?attr/lpIntentFlush" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/intent_flush"
                            android:textAppearance="@style/TextAppearance.LP.Label"
                            android:textColor="?attr/lpInkTertiary" />
                    </LinearLayout>
                </LinearLayout>
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- BUILD & STRENGTH RPE — moved from the home screen. Two averages side by side, so
             mono: these tick as sessions land. -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/card_overview_rpe"
            style="@style/Widget.LP.Card"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/lp_card_gap">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="@dimen/lp_card_padding">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/home_recent_wins"
                    android:textAppearance="@style/TextAppearance.LP.Heading" />

                <TextView
                    android:id="@+id/text_overview_rpe_headline"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/lp_space_2"
                    android:text="@string/home_rpe_none_headline"
                    android:textAppearance="@style/TextAppearance.LP.Metric.L" />

                <TextView
                    android:id="@+id/text_overview_rpe_sub"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/lp_space_1"
                    android:maxLines="2"
                    android:text="@string/home_rpe_none_sub"
                    android:textAppearance="@style/TextAppearance.LP.Body" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- TRENDS — four charts in a carousel, tab-switched. Moved from the home screen. -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/card_charts_carousel"
            style="@style/Widget.LP.Card"
            android:layout_width="match_parent"
            android:layout_height="320dp"
            android:layout_marginTop="@dimen/lp_card_gap"
            app:cardCornerRadius="@dimen/lp_radius_lg">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:orientation="vertical"
                android:padding="@dimen/lp_card_padding">

                <androidx.viewpager2.widget.ViewPager2
                    android:id="@+id/viewpager_charts"
                    android:layout_width="match_parent"
                    android:layout_height="0dp"
                    android:layout_weight="1" />

                <com.google.android.material.tabs.TabLayout
                    android:id="@+id/tab_layout_charts"
                    style="@style/Widget.LP.TabLayout"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/lp_space_2" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- MUSCLE TRENDS -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/card_muscle_map"
            style="@style/Widget.LP.Card"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/lp_card_gap">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="@dimen/lp_card_padding">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/progress_muscle_trends"
                    android:textAppearance="@style/TextAppearance.LP.Heading" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/progress_last_4_weeks"
                    android:textAppearance="@style/TextAppearance.LP.Caption" />

                <ImageView
                    android:id="@+id/image_muscle_map"
                    android:layout_width="match_parent"
                    android:layout_height="300dp"
                    android:layout_marginTop="@dimen/lp_space_4"
                    android:background="@android:color/transparent"
                    android:contentDescription="@string/cd_muscle_map"
                    android:scaleType="fitCenter" />

                <!-- Legend matches MuscleMapColorResolver.progressColorRank: >5%, 1-5%,
                     stable, -5 to -1%, <-5%, first time, no data -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/lp_space_3"
                    android:gravity="center"
                    android:orientation="vertical">

                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:gravity="center"
                        android:orientation="horizontal">

                        <LinearLayout
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginEnd="10dp"
                            android:gravity="center_vertical"
                            android:orientation="horizontal">

                            <View
                                android:layout_width="12dp"
                                android:layout_height="12dp"
                                android:layout_marginEnd="5dp"
                                android:background="@drawable/bg_circle_decoration"
                                android:backgroundTint="?attr/lpPositive" />

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="@string/muscle_legend_strong_improvement"
                                android:textAppearance="@style/TextAppearance.LP.Caption" />
                        </LinearLayout>

                        <LinearLayout
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginEnd="10dp"
                            android:gravity="center_vertical"
                            android:orientation="horizontal">

                            <View
                                android:layout_width="12dp"
                                android:layout_height="12dp"
                                android:layout_marginEnd="5dp"
                                android:alpha="0.45"
                                android:background="@drawable/bg_circle_decoration"
                                android:backgroundTint="?attr/lpPositive" />

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="@string/muscle_legend_improving"
                                android:textAppearance="@style/TextAppearance.LP.Caption" />
                        </LinearLayout>

                        <LinearLayout
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginEnd="10dp"
                            android:gravity="center_vertical"
                            android:orientation="horizontal">

                            <View
                                android:layout_width="12dp"
                                android:layout_height="12dp"
                                android:layout_marginEnd="5dp"
                                android:background="@drawable/bg_circle_decoration"
                                android:backgroundTint="?attr/lpInkTertiary" />

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="@string/muscle_legend_stable"
                                android:textAppearance="@style/TextAppearance.LP.Caption" />
                        </LinearLayout>

                        <LinearLayout
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginEnd="10dp"
                            android:gravity="center_vertical"
                            android:orientation="horizontal">

                            <View
                                android:layout_width="12dp"
                                android:layout_height="12dp"
                                android:layout_marginEnd="5dp"
                                android:alpha="0.45"
                                android:background="@drawable/bg_circle_decoration"
                                android:backgroundTint="?attr/lpNegative" />

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="@string/muscle_legend_declining"
                                android:textAppearance="@style/TextAppearance.LP.Caption" />
                        </LinearLayout>

                        <LinearLayout
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:gravity="center_vertical"
                            android:orientation="horizontal">

                            <View
                                android:layout_width="12dp"
                                android:layout_height="12dp"
                                android:layout_marginEnd="5dp"
                                android:background="@drawable/bg_circle_decoration"
                                android:backgroundTint="?attr/lpNegative" />

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="@string/muscle_legend_strong_decline"
                                android:textAppearance="@style/TextAppearance.LP.Caption" />
                        </LinearLayout>
                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/lp_space_2"
                        android:gravity="center"
                        android:orientation="horizontal">

                        <LinearLayout
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginEnd="12dp"
                            android:gravity="center_vertical"
                            android:orientation="horizontal">

                            <View
                                android:layout_width="12dp"
                                android:layout_height="12dp"
                                android:layout_marginEnd="6dp"
                                android:background="@drawable/bg_circle_decoration"
                                android:backgroundTint="?attr/lpAccent" />

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="@string/muscle_legend_first_time"
                                android:textAppearance="@style/TextAppearance.LP.Caption" />
                        </LinearLayout>

                        <LinearLayout
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:gravity="center_vertical"
                            android:orientation="horizontal">

                            <View
                                android:layout_width="12dp"
                                android:layout_height="12dp"
                                android:layout_marginEnd="6dp"
                                android:background="@drawable/bg_circle_decoration"
                                android:backgroundTint="?attr/lpHairlineStrong" />

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="@string/muscle_legend_no_data"
                                android:textAppearance="@style/TextAppearance.LP.Caption" />
                        </LinearLayout>
                    </LinearLayout>
                </LinearLayout>
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- COACH'S ANALYSIS -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/card_coach_analysis"
            style="@style/Widget.LP.Card"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/lp_card_gap">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="@dimen/lp_card_padding">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/progress_coach_analysis"
                    android:textAppearance="@style/TextAppearance.LP.Heading" />

                <TextView
                    android:id="@+id/text_coach_summary"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/lp_space_3"
                    android:lineSpacingExtra="4dp"
                    android:textAppearance="@style/TextAppearance.LP.Body"
                    android:textColor="?attr/lpInk"
                    tools:text="Your training is progressing well! Volume is up 15% compared to last week, and you hit 2 new PRs." />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

    </LinearLayout>
</androidx.core.widget.NestedScrollView>
