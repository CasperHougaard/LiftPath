<?xml version="1.0" encoding="utf-8"?>
<!--
  Read-only-ish detail view for a past training session — "ish" because the exercise
  cards below still let you edit a set, add one, or retag the activity, so amending a
  logged session uses the same vocabulary as logging it. DENSE spacing throughout: this
  is a session log, not a browsing surface.
-->
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="?attr/lpCanvas"
    tools:context=".activities.TrainingDetailActivity">

    <!-- Background Flow Animation -->
    <com.liftpath.views.AmbientFlowView
        android:id="@+id/view_bg_ambient"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <androidx.core.widget.NestedScrollView
        android:id="@+id/scroll_view"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@android:color/transparent"
        android:clipToPadding="false"
        android:fillViewport="true">

        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/scroll_content"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:clipChildren="false"
            android:clipToPadding="false"
            android:padding="@dimen/lp_gutter_dense">

            <!-- HEADER WITH BACK BUTTON -->
            <LinearLayout
                android:id="@+id/layout_header"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent">

                <com.google.android.material.card.MaterialCardView
                    style="@style/Widget.LP.Card.Control"
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    android:clickable="false"
                    android:focusable="false">

                    <ImageButton
                        android:id="@+id/button_back"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:background="?attr/selectableItemBackground"
                        android:contentDescription="@string/progress_back_content_description"
                        android:padding="@dimen/lp_space_3"
                        android:src="@drawable/ic_arrow_back_24"
                        app:tint="?attr/lpInk" />
                </com.google.android.material.card.MaterialCardView>

                <TextView
                    android:id="@+id/text_title"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/lp_space_3"
                    android:layout_weight="1"
                    android:text="@string/title_training_detail"
                    android:textAppearance="@style/TextAppearance.LP.Title" />
            </LinearLayout>

            <!-- SESSION INTENT + DURATION -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/card_session_intent"
                style="@style/Widget.LP.Card.Dense"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/lp_card_gap_dense"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@id/layout_header">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="@dimen/lp_card_padding_dense">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/label_session_intent"
                        android:textAppearance="@style/TextAppearance.LP.Caption" />

                    <TextView
                        android:id="@+id/text_dominant_intent"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/lp_space_1"
                        android:textAppearance="@style/TextAppearance.LP.Heading"
                        tools:text="Build" />

                    <!-- WORKOUT DURATION -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/lp_space_3"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="@string/label_workout_duration"
                            android:textAppearance="@style/TextAppearance.LP.Label"
                            android:textColor="?attr/lpInkSecondary" />

                        <TextView
                            android:id="@+id/text_workout_duration"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginEnd="@dimen/lp_space_2"
                            android:textAppearance="@style/TextAppearance.LP.Metric.M"
                            tools:text="01:04:12" />

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/button_edit_duration"
                            style="@style/Widget.LP.Button.Text"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:insetTop="0dp"
                            android:insetBottom="0dp"
                            android:minWidth="0dp"
                            android:minHeight="0dp"
                            android:paddingHorizontal="@dimen/lp_space_2"
                            android:paddingVertical="@dimen/lp_space_1"
                            android:text="@string/button_edit" />
                    </LinearLayout>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- EXERCISES LIST CARD -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/card_exercises_list"
                style="@style/Widget.LP.Card.Dense"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_marginTop="@dimen/lp_card_gap_dense"
                android:layout_marginBottom="@dimen/lp_card_gap_dense"
                app:layout_constraintBottom_toTopOf="@id/layout_footer_actions"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@id/card_session_intent">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:orientation="vertical">

                    <!-- Add Exercise Button -->
                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/button_add_exercise"
                        style="@style/Widget.LP.Button"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_margin="@dimen/lp_card_padding_dense"
                        android:text="@string/button_add_exercise"
                        app:icon="@drawable/ic_plus"
                        app:iconGravity="textStart" />

                    <androidx.recyclerview.widget.RecyclerView
                        android:id="@+id/recycler_view_training_detail"
                        android:layout_width="match_parent"
                        android:layout_height="0dp"
                        android:layout_weight="1"
                        android:clipChildren="false"
                        android:clipToPadding="false"
                        android:padding="@dimen/lp_card_padding_dense" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- FOOTER ACTIONS: VIEW REPORT, then SAVE AS PLAN + DELETE -->
            <LinearLayout
                android:id="@+id/layout_footer_actions"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@id/card_exercises_list">

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/button_view_report"
                    style="@style/Widget.LP.Button.Outlined"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="@dimen/lp_card_gap_dense"
                    android:text="@string/action_view_report"
                    app:icon="@drawable/ic_graph"
                    app:iconGravity="textStart" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:baselineAligned="false"
                    android:orientation="horizontal">

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/button_save_as_plan"
                        style="@style/Widget.LP.Button.Outlined"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginEnd="@dimen/lp_card_gap_dense"
                        android:layout_weight="1"
                        android:text="@string/action_save_as_plan" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/button_delete"
                        style="@style/Widget.LP.Button.Destructive"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="@string/button_delete"
                        app:icon="@drawable/ic_delete"
                        app:iconGravity="textStart" />
                </LinearLayout>
            </LinearLayout>

        </androidx.constraintlayout.widget.ConstraintLayout>
    </androidx.core.widget.NestedScrollView>
</androidx.constraintlayout.widget.ConstraintLayout>
