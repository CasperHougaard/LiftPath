<?xml version="1.0" encoding="utf-8"?>
<!--
  LiftPath shape + spacing scale.

  Radii: the old layouts shipped SEVEN (8/10/12/14/16/20/24dp), frequently two
  different ones on nested surfaces of the same card. Three is enough, and the
  rule for picking is size-based, not taste-based — a 48dp control with a 20dp
  radius looks like a pill by accident.

  Spacing is a 4dp grid. The gutter is 20dp rather than 24dp because the hairline
  card treatment reads tighter than shadowed cards did.
-->
<resources>

    <!-- ============ RADII ============ -->
    <!-- Controls under ~56dp: chips, inputs, small tiles, icon buttons. -->
    <dimen name="lp_radius_sm">12dp</dimen>
    <!-- The default. Every card. -->
    <dimen name="lp_radius_md">20dp</dimen>
    <!-- Full-bleed surfaces: bottom sheets, dialogs, the hero. -->
    <dimen name="lp_radius_lg">28dp</dimen>

    <!-- ============ HAIRLINE ============ -->
    <dimen name="lp_hairline_width">1dp</dimen>
    <!--
      Start inset for a divider between icon-led rows (Widget.LP.Row in Settings), so the
      rule begins at the row's text rather than under its icon: 24dp icon + lp_space_3 gap
      + the gutter it sits in.
    -->
    <dimen name="lp_divider_inset">60dp</dimen>

    <!-- ============ SPACING (4dp grid) ============ -->
    <!--
      The one deliberate half-step. A label and the value or description directly under it
      read as ONE unit, and 4dp is already enough air to break that pairing — so the ~24
      title/subtitle pairs in tiles and list rows sit at 2dp. It was a bare "2dp" repeated
      in 19 layouts before it was named; anything that is not such a pair uses the grid.
    -->
    <dimen name="lp_space_half">2dp</dimen>
    <dimen name="lp_space_1">4dp</dimen>
    <dimen name="lp_space_2">8dp</dimen>
    <dimen name="lp_space_3">12dp</dimen>
    <dimen name="lp_space_4">16dp</dimen>
    <dimen name="lp_space_5">20dp</dimen>
    <dimen name="lp_space_6">24dp</dimen>
    <dimen name="lp_space_8">32dp</dimen>
    <dimen name="lp_space_10">40dp</dimen>

    <!-- ============ DENSITY: AIRY ============ -->
    <!-- Overview surfaces you browse: Today, Progress, History, Library. -->
    <dimen name="lp_gutter">20dp</dimen>
    <dimen name="lp_card_padding">16dp</dimen>
    <!-- Gap between sibling cards in a row/grid. -->
    <dimen name="lp_card_gap">10dp</dimen>
    <!-- Space above a new section heading. -->
    <dimen name="lp_section_gap">32dp</dimen>

    <!-- ============ DENSITY: DENSE ============ -->
    <!--
      Working surfaces, used mid-set with a barbell waiting: active workout, log set,
      edit set, exercise pickers. The hybrid density decision — airy where you browse,
      dense where you work — is the reason there are two scales rather than one.

      Nothing consumes these yet. They exist so the working-surface migration waves have
      a defined target instead of each screen inventing its own spacing.
    -->
    <dimen name="lp_gutter_dense">12dp</dimen>
    <dimen name="lp_card_padding_dense">12dp</dimen>
    <dimen name="lp_card_gap_dense">6dp</dimen>
    <dimen name="lp_section_gap_dense">20dp</dimen>
    <!-- Minimum tappable list-row height; comfortably above the 48dp a11y floor. -->
    <dimen name="lp_row_min_height">56dp</dimen>
    <!-- Square secondary action (Widget.LP.Card.IconAction) and the icon drawn inside it. -->
    <dimen name="lp_icon_action_size">40dp</dimen>
    <dimen name="lp_icon_action_padding">10dp</dimen>
    <!--
      An emoji used as a row icon (the circuit and warmup/cooldown slots in a plan), sized to
      match the 26dp numbered badge the exercise rows put in the same position. It is an
      android:textSize because the glyph comes from a font, but it is sizing an icon, not
      type — which is why it lives here and not in the type scale.
    -->
    <dimen name="lp_icon_glyph_size">16sp</dimen>
    <!--
      −/+ steppers on the set-entry screens. 52dp rather than the 48dp a11y floor because
      these are hit repeatedly, one-handed, with chalk on your fingers — the extra 4dp is
      the difference between adjusting a weight and fighting the phone.
    -->
    <dimen name="lp_stepper_size">52dp</dimen>
    <dimen name="lp_stepper_icon_padding">15dp</dimen>
    <!--
      One row of the circuit picker: name, summary and station line plus card padding. Used to
      cap the sheet's list height, since RecyclerView ignores android:maxHeight.
    -->
    <dimen name="lp_circuit_picker_row_height">104dp</dimen>

    <!-- ============ COLD-START REVEAL ============ -->
    <!--
      The traced mark in activity_main. Larger than a normal icon because it has to hand
      over from the OS splash icon, which API 31+ draws into a 240dp area at roughly
      two-thirds fill. An exact match is impossible — the OS sizing is not queryable and
      varies by launcher — so this is deliberately close rather than equal, and the trace
      covers the difference: the eye follows a stroke being drawn and does not measure it
      against the static badge that just faded.
    -->
    <dimen name="lp_reveal_logo_size">104dp</dimen>
    <!--
      The bloom behind it. Big enough to read as light spilling past the mark, small enough
      that it never becomes a full-screen flash — it is scaled up from here at runtime.
    -->
    <dimen name="lp_reveal_bloom_size">220dp</dimen>

</resources>
