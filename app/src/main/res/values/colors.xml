<?xml version="1.0" encoding="utf-8"?>
<!--
  Non-token colours only.

  The old `fitness_*` / `intent_*` / `pr_*` / `superset_*` / `chip_*` palette that used to
  live here has been removed. It was the stock Tailwind set (#2563EB, #F59E0B, #F3F4F6),
  and every one of its ~1,700 usages now points at an `lp*` design-token attribute
  instead — see lp_attrs.xml for the roles and lp_palette_*.xml for the values.

  Deleted rather than kept as aliases on purpose: a static colour resource cannot follow
  the user's selected palette, so leaving the old names in place would just be an easy way
  to accidentally pin a view to one theme. If something needs a colour, it wants a role in
  lp_attrs.xml.

  What legitimately remains:
    · black / white / transparent — true absolutes, e.g. scrim and icon masks
    · purple_* / teal_* — leftovers from the project template, kept only because the
      Material template theme references them; not used by any LiftPath screen
-->
<resources>

    <color name="black">#FF000000</color>
    <color name="white">#FFFFFFFF</color>
    <color name="transparent">#00000000</color>

    <!-- Project-template leftovers. Not part of the design system. -->
    <color name="purple_200">#FFBB86FC</color>
    <color name="purple_500">#FF6200EE</color>
    <color name="purple_700">#FF3700B3</color>
    <color name="teal_200">#FF03DAC5</color>
    <color name="teal_700">#FF018786</color>

</resources>
