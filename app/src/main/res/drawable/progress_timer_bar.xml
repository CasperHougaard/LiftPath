<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:id="@android:id/background" android:alpha="0.25">
        <shape android:shape="rectangle">
            <solid android:color="?attr/lpInkSecondary" />
            <corners android:radius="@dimen/lp_radius_sm" />
        </shape>
    </item>
    <item android:id="@android:id/progress">
        <clip android:clipOrientation="horizontal" android:gravity="start">
            <shape android:shape="rectangle">
                <solid android:color="?attr/lpAccent" />
                <corners android:radius="@dimen/lp_radius_sm" />
            </shape>
        </clip>
    </item>
</layer-list>
