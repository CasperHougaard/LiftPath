<?xml version="1.0" encoding="utf-8"?>
<!--
  Radial glow. Two users: behind the hero's play icon, and as the bloom that fires when the
  cold-start reveal's traced mark lands (see activity_main / MainActivity).

  Drawn in WHITE with an alpha falloff and tinted at the point of use with
  android:backgroundTint="?attr/lpAccent". SRC_IN tinting (the default) multiplies the
  tint through the existing alpha, so the falloff survives while the hue is replaced —
  which means one drawable serves every palette instead of near-identical gradients that
  would all need editing together.

  Note the centre already sits at 40% alpha, so a caller scaling this up as a bloom applies
  its own alpha on top rather than treating this as a subtle wash.

  Replaces the old flat #20FFFFFF disc, which on an ink fill read as a grey smudge.
  A radial falloff gives the hero a light source, and that is what makes the card feel
  lit rather than merely filled.
-->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="oval">
    <gradient
        android:type="radial"
        android:gradientRadius="50%"
        android:startColor="#66FFFFFF"
        android:centerColor="#2EFFFFFF"
        android:endColor="#00FFFFFF" />
</shape>
