<?xml version="1.0" encoding="utf-8"?>
<!--
  A compact boxed field for the plan-authoring two-column grids (sets/RPE/reps/rest).
  A full TextInputLayout per field would double the height of an already-tight grid; this
  is the same hairline vocabulary at a size that fits four fields per row pair.
-->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <solid android:color="?attr/lpSurfaceAlt" />
    <corners android:radius="@dimen/lp_radius_sm" />
    <stroke
        android:width="@dimen/lp_hairline_width"
        android:color="?attr/lpHairlineStrong" />
</shape>
