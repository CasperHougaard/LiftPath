<?xml version="1.0" encoding="utf-8"?>
<!--
  Ambient background waves. Renamed from lp_bg_paper_flow — "paper" now names one
  specific palette, so a shared asset must not borrow that word.

  All three waves are drawn WHITE at low alpha and tinted at the point of use with
  app:tint="?attr/lpAccent" on the hosting ImageView.

  Why not theme attributes on android:fillColor directly: vector drawables do resolve
  ?attr/ at our minSdk, but an <animated-vector> loaded through app:srcCompat is the one
  place where theme propagation is genuinely unreliable. Tinting the ImageView sidesteps
  that completely. Nothing is lost — the original three waves used three different hues,
  but at 2.5–4% alpha that difference was invisible, so one tintable colour is the same
  picture with none of the risk.

  Geometry and timings are unchanged from the original avd_background_flow.
-->
<animated-vector xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:aapt="http://schemas.android.com/aapt">
    <aapt:attr name="android:drawable">
        <vector
            android:width="400dp"
            android:height="800dp"
            android:viewportWidth="100"
            android:viewportHeight="200">

            <group android:name="wave1">
                <path
                    android:pathData="M-100,100 Q-75,80 -50,100 Q-25,120 0,100 Q25,80 50,100 Q75,120 100,100 Q125,80 150,100 Q175,120 200,100 V200 H-100 Z"
                    android:fillAlpha="0.04"
                    android:fillColor="#FFFFFF" />
            </group>

            <group android:name="wave2">
                <path
                    android:pathData="M-100,130 Q-75,150 -50,130 Q-25,110 0,130 Q25,150 50,130 Q75,110 100,130 Q125,150 150,130 Q175,110 200,130 V200 H-100 Z"
                    android:fillAlpha="0.03"
                    android:fillColor="#FFFFFF" />
            </group>

            <group android:name="wave3">
                <path
                    android:pathData="M-100,160 Q-75,140 -50,160 Q-25,180 0,160 Q25,140 50,160 Q75,180 100,160 Q125,140 150,160 Q175,180 200,160 V200 H-100 Z"
                    android:fillAlpha="0.025"
                    android:fillColor="#FFFFFF" />
            </group>

        </vector>
    </aapt:attr>

    <target android:name="wave1">
        <aapt:attr name="android:animation">
            <objectAnimator
                android:duration="12000"
                android:interpolator="@android:anim/linear_interpolator"
                android:propertyName="translateX"
                android:repeatCount="infinite"
                android:repeatMode="restart"
                android:valueFrom="0"
                android:valueTo="100" />
        </aapt:attr>
    </target>

    <target android:name="wave2">
        <aapt:attr name="android:animation">
            <objectAnimator
                android:duration="15000"
                android:interpolator="@android:anim/linear_interpolator"
                android:propertyName="translateX"
                android:repeatCount="infinite"
                android:repeatMode="restart"
                android:valueFrom="0"
                android:valueTo="100" />
        </aapt:attr>
    </target>

    <target android:name="wave3">
        <aapt:attr name="android:animation">
            <objectAnimator
                android:duration="18000"
                android:interpolator="@android:anim/linear_interpolator"
                android:propertyName="translateX"
                android:repeatCount="infinite"
                android:repeatMode="restart"
                android:valueFrom="0"
                android:valueTo="100" />
        </aapt:attr>
    </target>

</animated-vector>
