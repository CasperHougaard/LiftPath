<?xml version="1.0" encoding="utf-8"?>
<inset xmlns:android="http://schemas.android.com/apk/res/android"
    android:insetLeft="4dp"
    android:insetTop="4dp"
    android:insetRight="4dp"
    android:insetBottom="10dp">

    <shape android:shape="rectangle">
        <solid android:color="?attr/lpSurface" />
        <corners android:radius="@dimen/lp_radius_md" />
        <stroke
            android:width="1dp"
            android:color="?attr/lpHairline" />
        <padding
            android:left="6dp"
            android:top="6dp"
            android:right="6dp"
            android:bottom="6dp" />
    </shape>
</inset>

