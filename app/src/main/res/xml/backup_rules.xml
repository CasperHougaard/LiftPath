<?xml version="1.0" encoding="utf-8"?>
<!--
   Backup rules for API <= 30 (never consulted at this app's minSdk 35 — mirrored anyway so
   this file and data_extraction_rules.xml don't silently drift into contradiction if minSdk
   ever drops).

   Only files/cloud_backup/ (CloudSnapshotStore's curated snapshot) is backed up; raw
   SharedPreferences are excluded since everything that matters is already in the snapshot.

   See https://developer.android.com/guide/topics/data/autobackup
-->
<full-backup-content>
    <include domain="file" path="cloud_backup/"/>
    <exclude domain="sharedpref" path="."/>
</full-backup-content>
