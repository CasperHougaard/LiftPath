<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <uses-permission android:name="android.permission.INTERNET"/>
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE"/>
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS"/>
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE"/>
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_SPECIAL_USE"/>
    <uses-permission android:name="android.permission.VIBRATE"/>
    <uses-permission android:name="android.permission.health.READ_EXERCISE"/>
    <uses-permission android:name="android.permission.health.READ_HEART_RATE"/>
    <uses-permission android:name="android.permission.health.READ_WEIGHT"/>
    <uses-permission android:name="android.permission.health.READ_BODY_FAT"/>
    <uses-permission android:name="android.permission.health.READ_LEAN_BODY_MASS"/>
    <uses-permission android:name="android.permission.health.READ_BONE_MASS"/>
    <uses-permission android:name="android.permission.health.READ_BODY_WATER_MASS"/>
    <uses-permission android:name="android.permission.health.READ_BASAL_METABOLIC_RATE"/>
    <permission android:name="com.liftpath.DYNAMIC_RECEIVER_NOT_EXPORTED_PERMISSION" android:protectionLevel="signature"/>
    <uses-permission android:name="com.liftpath.DYNAMIC_RECEIVER_NOT_EXPORTED_PERMISSION"/>
    <application android:allowBackup="true" android:appComponentFactory="androidx.core.app.CoreComponentFactory" android:dataExtractionRules="@xml/data_extraction_rules" android:extractNativeLibs="false" android:fullBackupContent="@xml/backup_rules" android:icon="@mipmap/ic_launcher" android:label="@string/app_name" android:name="com.liftpath.LiftPathApplication" android:roundIcon="@mipmap/ic_launcher_round" android:supportsRtl="true" android:theme="@style/Theme.Fitness">
        <activity android:exported="false" android:name="com.liftpath.activities.EditSetActivity" android:screenOrientation="portrait"/>
        <activity android:exported="false" android:name="com.liftpath.activities.WorkoutReportActivity" android:screenOrientation="portrait"/>
        <activity android:exported="false" android:name="com.liftpath.activities.StretchCooldownActivity" android:screenOrientation="portrait"/>
        <activity android:exported="false" android:name="com.liftpath.activities.SettingsActivity" android:screenOrientation="portrait"/>
        <activity android:exported="false" android:label="@string/title_progression_settings" android:name="com.liftpath.activities.ProgressionSettingsActivity" android:parentActivityName="com.liftpath.activities.SettingsActivity" android:screenOrientation="portrait"/>
        <!-- A Dialog theme (so the window stays a floating dialog over the lock screen) but a
             MaterialComponents one, because the layout uses MaterialButton. The palette
             overlay LiftPathApplication applies on top only carries colour, so it merges
             without disturbing the dialog windowing. -->
        <activity android:exported="false" android:name="com.liftpath.activities.RestTimerDialogActivity" android:showOnLockScreen="true" android:theme="@style/Theme.MaterialComponents.DayNight.Dialog" android:turnScreenOn="true" android:screenOrientation="portrait"/>
        <activity android:exported="false" android:name="com.liftpath.activities.TrainingDetailActivity" android:screenOrientation="portrait"/>
        <!-- Parent is the nav host now; ProgressActivity became the Progress tab. -->
        <activity android:exported="false" android:label="@string/title_progress_settings" android:name="com.liftpath.activities.ProgressSettingsActivity" android:parentActivityName="com.liftpath.activities.MainActivity" android:screenOrientation="portrait"/>
        <activity android:exported="false" android:name="com.liftpath.activities.EditActivityActivity" android:screenOrientation="portrait"/>
        <activity android:exported="false" android:name="com.liftpath.activities.EditExerciseActivity" android:screenOrientation="portrait"/>
        <activity android:exported="false" android:name="com.liftpath.activities.LogSetActivity" android:windowSoftInputMode="adjustResize" android:screenOrientation="portrait"/>
        <activity android:exported="false" android:name="com.liftpath.activities.SelectExerciseActivity" android:screenOrientation="portrait"/>
        <activity android:exported="false" android:name="com.liftpath.activities.ActiveTrainingActivity" android:screenOrientation="portrait"/>
        <activity android:exported="false" android:name="com.liftpath.activities.ManageFavoritesActivity" android:screenOrientation="portrait"/>
        <activity android:exported="false" android:name="com.liftpath.activities.EditWorkoutPlanActivity" android:screenOrientation="portrait"/>
        <activity android:exported="false" android:name="com.liftpath.activities.EditCircuitActivity" android:windowSoftInputMode="adjustResize" android:screenOrientation="portrait"/>
        <activity android:exported="false" android:name="com.liftpath.activities.CircuitRunnerActivity" android:screenOrientation="portrait"/>
        <activity android:exported="false" android:name="com.liftpath.activities.PlanSetActivity" android:screenOrientation="portrait"/>
        <activity android:exported="false" android:name="com.liftpath.activities.EditPlanSetActivity" android:screenOrientation="portrait"/>
        <activity android:exported="false" android:name="com.liftpath.activities.SelectExercisesForPlanActivity" android:screenOrientation="portrait"/>
        <activity android:exported="false" android:name="com.liftpath.activities.ReadinessDashboardActivity" android:screenOrientation="portrait"/>
        <activity android:exported="false" android:label="@string/readiness_calibration_title" android:name="com.liftpath.activities.ReadinessCalibrationActivity" android:parentActivityName="com.liftpath.activities.ReadinessDashboardActivity" android:screenOrientation="portrait"/>
        <activity android:exported="false" android:label="@string/health_connect_title" android:name="com.liftpath.activities.HealthConnectActivity" android:parentActivityName="com.liftpath.activities.ReadinessDashboardActivity" android:screenOrientation="portrait"/>
        <activity-alias
            android:name="ViewPermissionUsageActivity"
            android:exported="true"
            android:targetActivity="com.liftpath.activities.MainActivity"
            android:permission="android.permission.health.MANAGE_HEALTH_DATA_PERMISSION">
            <intent-filter>
                <action android:name="android.intent.action.VIEW_PERMISSION_USAGE"/>
                <category android:name="android.intent.category.HEALTH_PERMISSIONS"/>
            </intent-filter>
        </activity-alias>
        <!-- No per-activity theme: LiftPathApplication applies the user's selected palette
             to every activity in onActivityPreCreated. Must stay the LAUNCHER and the
             targetActivity of the ViewPermissionUsageActivity alias above. -->
        <activity android:exported="true" android:name="com.liftpath.activities.MainActivity" android:screenOrientation="portrait">
            <intent-filter>
                <action android:name="android.intent.action.MAIN"/>
                <category android:name="android.intent.category.LAUNCHER"/>
            </intent-filter>
        </activity>
        <service android:enabled="true" android:exported="false" android:foregroundServiceType="specialUse" android:name="com.liftpath.services.RestTimerService">
            <property android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE" android:value="Rest timer for workout tracking"/>
        </service>
        <provider android:authorities="com.liftpath.androidx-startup" android:exported="false" android:name="androidx.startup.InitializationProvider">
            <meta-data android:name="androidx.emoji2.text.EmojiCompatInitializer" android:value="androidx.startup"/>
            <meta-data android:name="androidx.lifecycle.ProcessLifecycleInitializer" android:value="androidx.startup"/>
            <meta-data android:name="androidx.profileinstaller.ProfileInstallerInitializer" android:value="androidx.startup"/>
        </provider>
        <receiver android:directBootAware="false" android:enabled="true" android:exported="true" android:name="androidx.profileinstaller.ProfileInstallReceiver" android:permission="android.permission.DUMP">
            <intent-filter>
                <action android:name="androidx.profileinstaller.action.INSTALL_PROFILE"/>
            </intent-filter>
            <intent-filter>
                <action android:name="androidx.profileinstaller.action.SKIP_FILE"/>
            </intent-filter>
            <intent-filter>
                <action android:name="androidx.profileinstaller.action.SAVE_PROFILE"/>
            </intent-filter>
            <intent-filter>
                <action android:name="androidx.profileinstaller.action.BENCHMARK_OPERATION"/>
            </intent-filter>
        </receiver>
        <!-- Connect IQ transport bring-up screen: enumerates devices, runs the catalogue
             lookup and echoes WatchLink traffic. Launched by adb, not from the UI. -->
        <activity android:exported="false" android:name="com.liftpath.garmin.GarminDiagnosticsActivity" android:screenOrientation="portrait"/>
    </application>

    <queries>
        <package android:name="com.google.android.apps.healthdata"/>
        <!-- Package visibility for the TriPath share provider; without this its content
             authority is invisible to us and the integration silently never connects. -->
        <package android:name="com.tripath"/>
        <!-- Package visibility for Garmin Connect Mobile, which relays Connect IQ messages to
             the watch. The ciq-companion-app-sdk manifest declares this too and the merger
             would contribute it, but it is stated here as well: without it the SDK reports no
             devices, which is indistinguishable from an unpaired watch. -->
        <package android:name="com.garmin.android.apps.connectmobile"/>
    </queries>
</manifest>
